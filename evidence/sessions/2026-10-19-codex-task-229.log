-  font-family: ui-monospace, SFMono-Regular, Menlo, Consolas, monospace;
+  transition: border-color var(--dur-snap) var(--ease-swift);
 }
 
+.tool-row:hover { border-color: var(--ring-2); }
+.tool-row--running { --tool-tone: var(--warn); }
+.tool-row--ok { --tool-tone: var(--ok); }
+.tool-row--danger { --tool-tone: var(--danger); }
+.tool-rail { display: flex; align-items: center; min-height: 24px; }
+.tool-dot { width: 7px; height: 7px; border-radius: 50%; background: var(--tool-tone); }
+.tool-row--running .tool-dot { animation: tool-pulse 1.4s ease-in-out infinite; }
+.tool-main { min-width: 0; }
+.tool-head { display: flex; flex-wrap: wrap; align-items: center; gap: 4px 8px; min-height: 24px; }
+.tool-badge { min-width: 0; max-width: 100%; }
+
+@keyframes tool-pulse {
+  0%, 100% { transform: scale(0.86); opacity: 0.8; }
+  50% { transform: scale(1.1); opacity: 1; box-shadow: 0 0 6px var(--warn); }
+}
+
+@media (max-width: 600px) {
+  .tool-badge { grid-column: 2 / -1; }
+}
+
+@media (prefers-reduced-motion: reduce) {
+  .tool-row--running .tool-dot, .thinking-block .thinking-dot { animation: none; }
+  .thinking-block::details-content { transition: none; }
+}
+
 .tool-name {
   font-weight: 600;
+  overflow-wrap: anywhere;
 }
 
 .tool-status {
-  color: var(--dim);
+  color: var(--tool-tone);
+  background: color-mix(in srgb, var(--tool-tone) 12%, transparent);
+  border-radius: var(--r-pill);
+  padding: 1px 6px;
+  font-size: 11px;
 }
 
 .tool-dur {
   color: var(--dim);
+  margin-inline-start: auto;
+  white-space: nowrap;
 }
 
 .tool-args {
   color: var(--dim);
-  white-space: nowrap;
+  font: 12px/1.5 ui-monospace, SFMono-Regular, Menlo, Consolas, monospace;
+  margin-top: 4px;
+  display: -webkit-box;
+  -webkit-box-orient: vertical;
+  -webkit-line-clamp: 2;
+  overflow-wrap: anywhere;
   overflow: hidden;
   text-overflow: ellipsis;
-  max-width: 320px;
 }
 
