 /* tool activity rows */
 .tool-row {
-  display: flex;
-  align-items: center;
+  display: grid;
+  grid-template-columns: 7px minmax(0, 1fr) auto;
+  align-items: start;
   gap: 8px;
+  padding: 8px 12px;
+  border: var(--ring-hairline) solid var(--ring);
+  border-radius: var(--r-sm);
+  background: var(--panel-2);
   font-size: 13px;
