}

.thinking-block summary {
  display: flex;
  align-items: center;
  gap: 8px;
  padding: 8px 12px;
  color: var(--dim);
  font-size: 12px;
  cursor: pointer;
  user-select: none;
}

.thinking-block summary:hover {
  color: var(--accent);
}

.thinking-block summary .thinking-dot {
  flex: 0 0 8px;
}

.thinking-mark {
  width: 8px;
  height: 8px;
  flex: 0 0 8px;
  border-radius: 50%;
  background: var(--dim);
  opacity: 0.65;
}

.thinking-content {
  max-height: 38vh;
  overflow: auto;
  margin: 0;
  padding: 10px 12px;
  border-top: 1px solid var(--border);
  color: var(--text-soft);
  font: 12px/1.55 ui-monospace, SFMono-Regular, Menlo, Consolas, monospace;
  white-space: pre-wrap;
  overflow-wrap: anywhere;
}

.thinking-dot {
  width: 8px;
  height: 8px;
  border-radius: 50%;
  background: var(--accent);
  animation: pulse 1s ease-in-out infinite;
}

@keyframes pulse {
  0%,
  100% {
    opacity: 0.3;
  }
  50% {
    opacity: 1;
  }
}

