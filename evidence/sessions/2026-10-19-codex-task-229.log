import { localizedValue } from '../i18n';
import { useI18n } from './LanguageProvider';
import type { ToolDelta } from '../sse';
import SandboxAuditBadge from './SandboxAuditBadge';

/** Color semantics per docs/UI-THEME.md: green=ok, yellow=warn, red=danger. */
function statusTone(status: ToolDelta['status']): 'running' | 'ok' | 'danger' {
  switch (status) {
    case 'started':
      return 'running';
    case 'done':
      return 'ok';
    case 'denied':
    case 'error':
      return 'danger';
  }
}

/** One tool dispatch row: name + status dot + optional duration & args. */
export default function ToolActivityRow({ delta }: { delta: ToolDelta }) {
  const { t } = useI18n();
  const name = delta.toolName ?? t('noTool');
  const status = localizedValue(delta.status, t);
  const tone = statusTone(delta.status);
  return (
    <div className={`tool-row tool-row--${tone}`} data-status={delta.status} data-tone={tone}
      role="group" aria-label={`${name} · ${status}`}>
      <span className="tool-rail" aria-hidden="true"><span className="tool-dot" /></span>
      <div className="tool-main">
        <div className="tool-head">
          <span className="tool-name">{name}</span>
          <span className="tool-status">{status}</span>
          {typeof delta.durationMs === 'number' && (
            <span className="tool-dur">{delta.durationMs >= 1000
              ? t('timeSeconds', { value: (delta.durationMs / 1000).toFixed(1) })
              : t('timeMilliseconds', { value: String(delta.durationMs) })}</span>
          )}
        </div>
        {delta.argsSummary && <div className="tool-args" title={delta.argsSummary}>{delta.argsSummary}</div>}
      </div>
      {delta.sandbox && <div className="tool-badge"><SandboxAuditBadge audit={delta.sandbox} /></div>}
    </div>
  );
}
/* Vessel Local Web UI — per docs/UI-THEME.md:
   light is :root default; dark follows prefers-color-scheme. All colors via vars. */

/* Color tokens live in the `.tokens` layer (index.html sets that class on <html>),
   so the app and the pre-hydration skeleton share one source of truth. */
.tokens {
  /* 玻璃令牌（浅色默认），值取自 docs/DESIGN.md §2.1 与原型 :root */
  --bg: #e4e8f3;
  --panel: #ffffff;
  --panel-2: #f2f4fb;
  --panel-3: #e4e8f5;
  --ring: rgba(38, 44, 80, 0.08);
  --ring-2: rgba(38, 44, 80, 0.16);
  --text: #0c1020;
  --text-2: #525a73;
  --text-3: #858ca3;
  --accent: #5b6cff;
  --accent-fg: #ffffff;
  --accent-soft: rgba(91, 108, 255, 0.1);
  --ok: #0f7a55;
.sandbox-audit { display: inline-block; font-size: 12px; }
.sandbox-audit > summary { cursor: pointer; border: 1px solid currentColor; border-radius: 6px; padding: 3px 7px; }
.sandbox-green > summary { color: var(--green, #1a7f37); }
.sandbox-yellow > summary { color: var(--yellow, #9a6700); }
.sandbox-gray > summary { color: var(--dim, #a0a5af); }
.sandbox-audit-drawer { position: fixed; z-index: 30; right: 0; top: 0; bottom: 0; width: min(440px, 100vw); overflow-y: auto; padding: 20px; box-sizing: border-box; background: var(--bg, #12151c); color: var(--text, #e6e8ef); border-left: 1px solid var(--border, #383d48); box-shadow: -8px 0 24px #0006; }
.sandbox-audit-details dt { font-weight: 600; margin-top: 16px; }
.sandbox-audit-details dd { margin: 6px 0; overflow-wrap: anywhere; }
.sandbox-audit-history { padding: 8px 16px; border-top: 1px solid var(--border, #383d48); }
.sandbox-audit-history > summary { cursor: pointer; }
