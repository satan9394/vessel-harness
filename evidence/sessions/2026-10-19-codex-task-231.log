 .behavior-ladder li[data-reached="true"] { opacity: 1; border-style: solid; border-color: var(--accent); }
 .behavior-ladder li[aria-current="step"] { font-weight: 700; }
 @media (max-width: 800px) { .behavior-layers { grid-template-columns: 1fr; } .agent-studio-inspector { padding: 12px; } }
+/* Task 231: Provider hub and shared model picker. */
+.provider-modal { width: min(960px, 94vw); }
+.preset-gallery { display: grid; gap: 12px; margin-block: 16px; }
+.preset-gallery-tabs { display: flex; flex-wrap: wrap; gap: 6px; }
+.preset-gallery-tab { border: var(--ring-hairline) solid var(--ring); border-radius: var(--r-pill, 9999px); padding: 6px 12px; background: var(--panel-2); color: var(--text); cursor: pointer; }
+.preset-gallery-tab[aria-pressed="true"] { border-color: var(--accent); background: var(--accent-soft); }
+.preset-gallery-grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(min(100%, 190px), 1fr)); gap: 10px; max-height: 290px; overflow-y: auto; padding: 3px; }
+.preset-card, .onboarding-card { display: flex; flex-direction: column; align-items: flex-start; gap: 8px; min-width: 0; padding: 14px; border: var(--ring-hairline) solid var(--ring); border-radius: var(--r-card, 12px); background: var(--panel-2); color: var(--text); text-align: start; cursor: pointer; transition: border-color 140ms ease, background 140ms ease; }
+.preset-card:hover, .onboarding-card:hover, .preset-card[aria-pressed="true"] { border-color: var(--accent); background: var(--accent-soft); }
+.preset-card small, .onboarding-card small { color: var(--text-2); line-height: 1.5; }
+.preset-card code, .preset-card strong { max-width: 100%; overflow-wrap: anywhere; }
+.preset-avatar { display: grid; place-items: center; width: 30px; height: 30px; border: var(--ring-hairline) solid var(--ring); border-radius: 9px; font-weight: 650; }
+.model-chips { display: flex; flex-wrap: wrap; align-items: center; gap: 8px; min-width: 0; }
+.model-chip { display: inline-flex; align-items: center; max-width: 100%; border: var(--ring-hairline) solid var(--ring); border-radius: var(--r-pill, 9999px); background: var(--panel-2); overflow: hidden; }
+.model-chip.is-selected { border-color: var(--accent); background: var(--accent-soft); }
+.model-chip.is-default { box-shadow: inset 0 0 0 1px var(--accent); }
+.model-chip button { background: transparent; color: inherit; border: 0; padding: 7px 9px; cursor: pointer; }
+.model-chip .model-chip-toggle { overflow-wrap: anywhere; min-width: 0; text-align: start; }
+.model-chip-input { flex: 1 1 220px; min-width: 0; }
+.model-switcher { position: relative; min-width: 0; max-width: 100%; }
+.model-switcher-trigger { display: flex; align-items: center; gap: 8px; max-width: 100%; padding: 8px 12px; border: var(--ring-hairline) solid var(--ring); border-radius: var(--r-pill, 9999px); background: var(--panel-2); color: var(--text); cursor: pointer; }
+.model-switcher-trigger > span:nth-child(2) { overflow: hidden; white-space: nowrap; text-overflow: ellipsis; }
+.model-switcher-dot { flex: 0 0 6px; width: 6px; height: 6px; border-radius: 50%; background: var(--text-2); }
+.model-switcher-dot[data-state="online"] { background: var(--ok); }
+.model-switcher-panel { position: absolute; inset-block-end: calc(100% + 8px); inset-inline-start: 0; z-index: 80; width: min(380px, calc(100vw - 48px)); padding: 12px; border: var(--ring-hairline) solid var(--ring); border-radius: var(--r-card, 12px); background: var(--panel); box-shadow: 0 12px 36px rgb(0 0 0 / 18%); }
+.model-selector .model-switcher-panel { inset-block-end: auto; inset-block-start: calc(100% + 8px); }
+.model-switcher .model-switcher-search { width: 100%; }
+.model-switcher-list { max-height: 260px; overflow-y: auto; }
+.model-switcher-group h4 { margin: 12px 8px 6px; color: var(--text-2); font-size: 11px; }
+.model-switcher-item { display: flex; align-items: center; justify-content: space-between; gap: 10px; width: 100%; border: 0; border-radius: 8px; background: transparent; color: var(--text); padding: 9px 8px; text-align: start; cursor: pointer; }
+.model-switcher-item > span:first-child { min-width: 0; overflow-wrap: anywhere; }
+.model-switcher-item:hover, .model-switcher-item.is-active { background: var(--accent-soft); }
+.model-switcher-footer { width: 100%; margin-block-start: 10px; }
+.task-composer-onboarding { margin-block: 16px; }
+.task-composer-onboarding h3 { margin-block: 0 6px; font-size: 15px; }
+.onboarding-grid { display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); gap: 10px; margin-block-start: 12px; }
+.preset-card:focus-visible, .preset-gallery-tab:focus-visible, .model-chip button:focus-visible, .model-switcher-trigger:focus-visible, .model-switcher-item:focus-visible, .onboarding-card:focus-visible { outline: 2px solid var(--accent); outline-offset: 2px; }
+.model-chip button:disabled, .preset-card:disabled, .model-switcher-trigger:disabled, .onboarding-card:disabled { opacity: .5; cursor: default; }
+@media (max-width: 800px) { .onboarding-grid { grid-template-columns: repeat(2, minmax(0, 1fr)); } }
+@media (prefers-reduced-motion: reduce) { .preset-card, .onboarding-card { transition: none; } }

