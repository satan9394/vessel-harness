diff --git a/apps/web/src/styles.css b/apps/web/src/styles.css
index 8ab591f839f1aa134082fd366c0c3bef07fe92f5..699ad4d03bb32435230c72b450e27ab913d78464
--- a/apps/web/src/styles.css
