diff --git a/apps/web/src/components/providers/ModelQuickSwitcher.tsx b/apps/web/src/components/providers/ModelQuickSwitcher.tsx
new file mode 100644
index 0000000000000000000000000000000000000000..4e335206e8edc7e4e1c40915d8fb98a185796d45
--- /dev/null
+++ b/apps/web/src/components/providers/ModelQuickSwitcher.tsx
@@ -0,0 +1,75 @@
+import { useEffect, useId, useRef, useState } from 'react';
+import type { ModelOption } from '../../api';
+import { useI18n } from '../LanguageProvider';
+
+export interface ActiveModel { provider: string; model: string }
+export interface ModelQuickSwitcherProps {
+  models: ModelOption[];
+  current: ActiveModel | null;
+  onSelect: (model: ActiveModel) => void;
+  onOpenSettings?: () => void;
+  disabled?: boolean;
+  compact?: boolean;
+}
+
+export function ModelQuickSwitcher({ models, current, onSelect, onOpenSettings, disabled, compact }: ModelQuickSwitcherProps) {
+  const { t } = useI18n();
+  const id = useId();
+  const root = useRef<HTMLDivElement>(null);
+  const trigger = useRef<HTMLButtonElement>(null);
+  const search = useRef<HTMLInputElement>(null);
+  const [open, setOpen] = useState(false);
+  const [query, setQuery] = useState('');
+  const [active, setActive] = useState(0);
+  const filtered = models.filter(model => model.providerName !== 'mock' && `${model.providerName} ${model.id} ${model.name}`.toLowerCase().includes(query.trim().toLowerCase()));
+  const groups = [...new Set(filtered.map(model => model.providerName))];
+  const ordered = groups.flatMap(provider => filtered.filter(model => model.providerName === provider));
+  const online = !!current && models.some(model => model.providerName !== 'mock' && model.providerName === current.provider && model.id === current.model);
+  function close() { setOpen(false); trigger.current?.focus(); }
+  function choose(model: ModelOption) { if (disabled) return; onSelect({ provider: model.providerName, model: model.id }); close(); }
+  useEffect(() => {
+    if (!open || disabled) return;
+    search.current?.focus();
+    function outside(event: PointerEvent) { if (!root.current?.contains(event.target as Node)) setOpen(false); }
+    document.addEventListener('pointerdown', outside);
+    return () => document.removeEventListener('pointerdown', outside);
+  }, [open, disabled]);
+  useEffect(() => {
+    root.current?.querySelectorAll<HTMLElement>('.model-switcher-item')[active]?.scrollIntoView({ block: 'nearest' });
+  }, [active]);
+  return <div className={`model-switcher${compact ? ' is-compact' : ' model-pill'}`} ref={root} onBlur={event => {
+    if (!event.currentTarget.contains(event.relatedTarget as Node | null)) setOpen(false);
+  }} onKeyDown={event => {
+    if (!open || disabled || event.nativeEvent.isComposing || event.keyCode === 229) return;
+    if (event.key === 'Escape') { event.preventDefault(); event.stopPropagation(); close(); }
+    if (event.key === 'ArrowDown' || event.key === 'ArrowUp') {
+      event.preventDefault();
+      setActive(value => ordered.length ? (value + (event.key === 'ArrowDown' ? 1 : -1) + ordered.length) % ordered.length : 0);
+      search.current?.focus();
+    }
+    if (event.key === 'Enter' && event.target === search.current) { event.preventDefault(); if (ordered[active]) choose(ordered[active]); }
+  }}>
+    <button type="button" ref={trigger} className="model-switcher-trigger" disabled={disabled} aria-expanded={open && !disabled} aria-controls={`${id}-panel`} aria-haspopup="dialog" onClick={() => { setOpen(value => !value); setQuery(''); setActive(0); }}>
+      <span className="model-switcher-dot" data-state={online ? 'online' : 'offline'} aria-hidden="true" />
+      <span>{current && current.provider !== 'mock' ? `${current.provider} / ${current.model}` : `${t('modelOffline')} / ${t('selectModel')}`}</span>
+      <span aria-hidden="true">⌄</span>
+    </button>
+    {open && !disabled && <div id={`${id}-panel`} className="model-switcher-panel" role="dialog" aria-label={t('selectModel')}>
+      <input ref={search} className="input model-switcher-search" role="combobox" aria-label={t('modelSearchPlaceholder')} aria-expanded="true" aria-controls={`${id}-list`} aria-activedescendant={ordered[active] ? `${id}-item-${active}` : undefined} value={query} placeholder={t('modelSearchPlaceholder')} onChange={event => { setQuery(event.target.value); setActive(0); }} />
+      <div id={`${id}-list`} role="listbox" aria-label={t('selectModel')} className="model-switcher-list">
+        {groups.map(provider => <div className="model-switcher-group" key={provider} role="group" aria-label={provider}>
+          <h4>{provider}</h4>
+          {ordered.filter(model => model.providerName === provider).map(model => {
+            const index = ordered.indexOf(model);
+            const selected = current?.provider === provider && current.model === model.id;
+            return <button key={model.id} id={`${id}-item-${index}`} type="button" role="option" aria-selected={selected} className={`model-switcher-item${index === active ? ' is-active' : ''}`} onClick={() => choose(model)} onPointerMove={() => setActive(index)}>
+              <span>{model.id}</span>{selected && <span className="provider-badge">✓ {t('currentLabel')}</span>}
+            </button>;
+          })}
+        </div>)}
+        {!ordered.length && <p role="status" className="dim">{t('presetNoResults')}</p>}
+      </div>
+      {onOpenSettings && <button type="button" className="btn model-switcher-footer" onClick={() => { close(); onOpenSettings(); }}>{t('configureModels')}</button>}
+    </div>}
+  </div>;
+}
diff --git a/apps/web/src/components/providers/PresetsGallery.test.tsx b/apps/web/src/components/providers/PresetsGallery.test.tsx
new file mode 100644
index 0000000000000000000000000000000000000000..611870c1d686f6b0d09cea2478ccc17cc7afe065
--- /dev/null
+++ b/apps/web/src/components/providers/PresetsGallery.test.tsx
@@ -0,0 +1,36 @@
+import { isValidElement, type ReactElement, type ReactNode } from 'react';
+import { beforeEach, describe, expect, it, vi } from 'vitest';
+import { translate } from '../../i18n';
+import { PresetsGallery } from './PresetsGallery';
+import { PROVIDER_PRESETS_CATALOG } from './presetsData';
+
+const hooks = vi.hoisted(() => ({ values: [] as unknown[], cursor: 0 }));
+vi.mock('../LanguageProvider', () => ({ useI18n: () => ({ t: translate('en') }) }));
+vi.mock('react', async original => ({ ...await original<typeof import('react')>(), useState: (initial: unknown) => {
+  const index = hooks.cursor++; if (!(index in hooks.values)) hooks.values[index] = initial;
+  return [hooks.values[index], (value: unknown) => { hooks.values[index] = value; }];
+} }));
+function nodes(root: ReactNode): ReactElement<Record<string, unknown>>[] {
+  if (Array.isArray(root)) return root.flatMap(nodes);
+  if (!isValidElement<Record<string, unknown>>(root)) return [];
+  return [root, ...nodes(root.props.children as ReactNode)];
+}
+function invoke(node: ReactElement<Record<string, unknown>>, handler: string, event = {}) { (node.props[handler] as (event: unknown) => void)(event); }
+const onSelect = vi.fn();
+function render() { hooks.cursor = 0; return nodes(PresetsGallery({ onSelect, selectedId: 'deepseek' })); }
+function cards() { return render().filter(node => node.props.className === 'preset-card'); }
+beforeEach(() => { hooks.values = []; vi.clearAllMocks(); });
+describe('PresetsGallery', () => {
+  it('shows the full catalog and filters by category and case-insensitive search together', () => {
+    expect(cards()).toHaveLength(PROVIDER_PRESETS_CATALOG.length);
+    invoke(render().find(node => node.props.children === 'CN')!, 'onClick');
+    expect(cards()).toHaveLength(PROVIDER_PRESETS_CATALOG.filter(preset => preset.category === 'cn').length);
+    invoke(render().find(node => node.type === 'input')!, 'onChange', { target: { value: '  DEEPSEEK  ' } });
+    expect(cards()).toHaveLength(1); expect(cards()[0]!.props['aria-pressed']).toBe(true);
+    invoke(cards()[0]!, 'onClick'); expect(onSelect).toHaveBeenCalledWith(PROVIDER_PRESETS_CATALOG.find(preset => preset.id === 'deepseek'));
+  });
+  it('shows an empty state for a nonmatching query', () => {
+    invoke(render().find(node => node.type === 'input')!, 'onChange', { target: { value: 'no-such-provider' } });
+    expect(cards()).toHaveLength(0); expect(render().some(node => node.props.role === 'status')).toBe(true);
+  });
+});
diff --git a/apps/web/src/components/providers/PresetsGallery.tsx b/apps/web/src/components/providers/PresetsGallery.tsx
new file mode 100644
index 0000000000000000000000000000000000000000..751c65969cdfb7ce5dab26aeae3121dc8bca7665
--- /dev/null
+++ b/apps/web/src/components/providers/PresetsGallery.tsx
@@ -0,0 +1,26 @@
+import { useState } from 'react';
+import { useI18n } from '../LanguageProvider';
+import { PRESET_CATEGORIES, PROVIDER_PRESETS_CATALOG, type PresetInfo, type ProviderCategory } from './presetsData';
+
+export function PresetsGallery({ onSelect, selectedId, disabled }: { onSelect: (preset: PresetInfo) => void; selectedId?: string; disabled?: boolean }) {
+  const { t } = useI18n();
+  const [query, setQuery] = useState('');
+  const [category, setCategory] = useState<ProviderCategory | 'all'>('all');
+  const presets = PROVIDER_PRESETS_CATALOG.filter(preset => (category === 'all' || preset.category === category)
+    && `${preset.id} ${preset.name} ${preset.defaultModel} ${preset.hint ?? ''}`.toLowerCase().includes(query.trim().toLowerCase()));
+  return <section className="preset-gallery" aria-label={t('providerPreset')}>
+    <input className="input" type="search" aria-label={t('presetSearchPlaceholder')} placeholder={t('presetSearchPlaceholder')} value={query} onChange={event => setQuery(event.target.value)} disabled={disabled} />
+    <div className="preset-gallery-tabs" role="group" aria-label={t('providerPreset')}>
+      {PRESET_CATEGORIES.map(item => <button key={item.id} type="button" className="preset-gallery-tab" aria-pressed={category === item.id} onClick={() => setCategory(item.id)} disabled={disabled}>{t(item.labelKey)}</button>)}
+    </div>
+    <div className="preset-gallery-grid">{presets.map(preset => <button key={preset.id} type="button" className="preset-card" aria-pressed={selectedId === preset.id} onClick={() => onSelect(preset)} disabled={disabled}>
+      <span className="preset-avatar" aria-hidden="true">{preset.id[0]!.toUpperCase()}</span>
+      <strong>{preset.name}</strong>
+      {preset.hint && <small>{preset.hint}</small>}
+      {preset.defaultModel && <code>{preset.defaultModel}</code>}
+      <span className="provider-badge">{t(PRESET_CATEGORIES.find(item => item.id === preset.category)!.labelKey)}</span>
+      {preset.auth && <small>{preset.auth}</small>}
+    </button>)}</div>
+    {!presets.length && <p role="status" className="dim">{t('presetNoResults')}</p>}
+  </section>;
+}
