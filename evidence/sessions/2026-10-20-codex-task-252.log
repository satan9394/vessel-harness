    bus,
    session,
    registry,
    policyEngine,
    builder,
    compaction,
    loop,
    telemetry,
    artifacts,
    behaviorWarnings,
    get behaviorInspection() { refreshBehaviorProfile(); return structuredClone(behaviorInspection); },
    validateBehaviorModel(provider, model, providerId = provider.id) {
