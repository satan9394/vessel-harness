    },
    discoveredPlugins,
    subagentManager,
    externalAgentRuntime,
    mcpClients,
    mcpFailures,
    taskRouter,
    route,
    routedCategory,
    usageStore: opts.usageStore,
    sandbox,
    enforcement,
    async close() {
      detachBehaviorInspection();
      telemetry.detach();
      enforcementDetach();
      enforcementFoldDetach();
      reflectionDetach();
      evaluatorReflectionDetach();
      reflect();
