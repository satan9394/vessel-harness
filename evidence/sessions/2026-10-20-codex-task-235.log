];
/**
 * **已声明未实现**（非丢数据）：这四个模块在模块选择器里可勾选，但面板本体尚未实现，
 * 渲染时显示 `t('unimplemented')` 占位（见下方 `UNIMPLEMENTED.includes(id)` 分支）。
 * 触发条件 = 对应后端投影/接口就绪（Context / Logs / MCP / Policy 各有其数据源），
 * 届时逐个从本清单移除并把面板接上。
 */
const UNIMPLEMENTED: UiModuleId[] = ['Context', 'Logs', 'MCP', 'Policy'];

export default function App() {
  return (
    <LanguageProvider>
      <AppShell />
    </LanguageProvider>
  );
}

function AppShell() {
  const { t } = useI18n();
  const [attention] = useState(() => new AttentionManager());
  useEffect(() => { attention.attach(); return () => attention.dispose(); }, [attention]);
  const [api] = useState<ApiClient>(() => createApiClient());
  const [health, setHealth] = useState<Health | null>(null);
  const [projects, setProjects] = useState<Project[]>([]);
  const [sessions, setSessions] = useState<SessionMeta[]>([]);
  const [serverError, setServerError] = useState(false);
  const [showProviders, setShowProviders] = useState(false);
  const [providerRevision, setProviderRevision] = useState(0);
  const [showNew, setShowNew] = useState(false);
  const [area, setArea] = useState<'workbench' | 'activity' | 'studio' | 'settings'>('workbench');
  const [drawer, setDrawer] = useState(false);
  const [sidebarCollapsed, setSidebarCollapsed] = useState(false);
  const [taskStarting, setTaskStarting] = useState(false);
  const navigationFocus = useRef<HTMLElement | null>(null);
  const [projectRoot, setProjectRoot] = useState('');
  useEffect(() => {
    if (!drawer) return;
    navigationFocus.current = document.activeElement instanceof HTMLElement ? document.activeElement : null;
    const navigation = document.querySelector<HTMLElement>('.navigation-shell');
    navigation?.querySelector<HTMLButtonElement>('button')?.focus();
    const close = (event: KeyboardEvent) => {
      if (event.key === 'Escape') { event.preventDefault(); setDrawer(false); }
      else if (navigation) trapFocus(event, navigation);
    };
    window.addEventListener('keydown', close);
    return () => {
      window.removeEventListener('keydown', close);
      if (navigationFocus.current?.isConnected) navigationFocus.current.focus();
    };
  }, [drawer]);
  const [initialTask, setInitialTask] = useState<{ sessionId: string; text: string }>();
  const [newPermission, setNewPermission] = useState<CreateSessionInput['permission']>('workspace-write');
  const [viewRequest, setViewRequest] = useState<{ action: 'clear' | 'collapse' | 'expand' | 'export' | InspectorTab; serial: number }>();
  const [selectedSessionId, setSelectedSessionId] = useState<string | null>(null);
  const [modules, setModules] = useState<UiModuleState>(() => loadModules());

  const handleModulesChange = useCallback((next: UiModuleState) => {
    setModules(next);
    saveModules(next);
  }, []);

  const updateSessionTopic = useCallback(async (id: string, input: { title?: string; isArchived?: boolean }) => {
    try {
      const { session } = await api.updateSessionTopic(id, input);
      setSessions((current) => current.map((item) => item.id === session.id ? session : item));
    } catch {
      setServerError(true);
    }
  }, [api]);

  const deleteSession = useCallback(async (idOrIds: string | string[]) => {
    const ids = Array.isArray(idOrIds) ? idOrIds : [idOrIds];
    try {
      await Promise.all(ids.map(id => api.deleteSession(id).catch(() => {})));
      setSessions((current) => current.filter((item) => !ids.includes(item.id)));
      setSelectedSessionId((cur) => (cur && ids.includes(cur) ? null : cur));
    } catch {
      setServerError(true);
    }
  }, [api]);

  const connect = useCallback(async () => {
    setServerError(false);
    try {
      const h = await api.health();
      setHealth(h);
      const [{ projects: ps }, { sessions: ss }] = await Promise.all([api.projects(), api.sessions()]);
      setProjects(ps);
      setProjectRoot(current => current || ps[0]?.root || '');
      setSessions(ss);
      // Keep selection valid if a session was removed on the server.
      setSelectedSessionId((cur) => (cur && ss.some((s) => s.id === cur) ? cur : null));
    } catch {
      setServerError(true);
      setHealth(null);
    }
  }, [api]);

  useEffect(() => {
    void connect();
  }, [connect]);

  function onCreated(result: NewSessionResult) {
    // auto-open the freshly created session
    setArea('workbench');
    setSelectedSessionId(result.sessionId);
    void connect();
  }

  const nothingSelected = !selectedSessionId || !sessions.some((s) => s.id === selectedSessionId);

  const requestView = (action: 'clear' | 'collapse' | 'expand' | 'export' | InspectorTab) => setViewRequest(previous => ({ action, serial: (previous?.serial ?? 0) + 1 }));
  const commands: CommandItem[] = [
    { id: 'providers', title: t('modelSettings'), category: 'action', keywords: ['provider', 'model'], execute: () => setShowProviders(true) },
    { id: 'new', title: t('newSessionTitle'), category: 'action', execute: () => { if (taskStarting) return; setArea('workbench'); setSelectedSessionId(null); } },
    ...(['read-only', 'workspace-write'] as const).map(permission => ({ id: `sandbox:${permission}`, title: t('paletteSandbox', { permission: t(permission === 'read-only' ? 'permissionReadOnly' : 'permissionWorkspaceWrite') }), category: 'action' as const, keywords: ['security'], execute: () => { if (taskStarting) return; setNewPermission(permission); setShowNew(true); } })),
    ...projects.map(project => ({ id: `project:${project.root}`, title: projectName(project.root), category: 'project' as const, keywords: [project.root], execute: () => { if (taskStarting) return; setProjectRoot(project.root); setArea('workbench'); setSelectedSessionId(null); } })),
    ...sessions.filter(session => !session.topic?.isArchived).map(session => ({ id: `session:${session.id}`, title: `${readableSessionTitle(session, t('sessionNew'))} · ${projectName(session.workspaceRoot)}`, category: 'session' as const, keywords: [session.id, session.workspaceRoot], execute: () => { if (taskStarting) return; setArea('workbench'); setSelectedSessionId(session.id); } })),
    ...(!nothingSelected ? [
      ...INSPECTOR_TABS.map(tab => ({ id: `inspector:${tab}`, title: t('paletteInspector', { tab: t(INSPECTOR_LABELS[tab]) }), category: 'navigation' as const, execute: () => requestView(tab) })),
      { id: 'export', title: t('paletteExportJson'), category: 'action' as const, execute: () => requestView('export') },
      { id: 'clear', title: t('paletteClearScreen'), category: 'view' as const, execute: () => requestView('clear') },
      { id: 'collapse', title: t('paletteCollapse'), category: 'view' as const, execute: () => requestView('collapse') },
      { id: 'expand', title: t('paletteExpand'), category: 'view' as const, execute: () => requestView('expand') },
    ] : []),
  ];

  return (
    <div className={`app${drawer ? ' navigation-open' : ''}${sidebarCollapsed ? ' sidebar-collapsed' : ''}`} data-provider-revision={providerRevision}>
      <Rail area={area} onSelect={value => { setArea(value); setDrawer(false); }} />
      {drawer && <button className="navigation-backdrop" aria-label={t('close')} onClick={() => setDrawer(false)} />}
      <div className="navigation-shell" role={drawer ? 'dialog' : undefined} aria-modal={drawer ? true : undefined} aria-label={drawer ? t('navigationMenu') : undefined}>
        <button className="btn navigation-close" onClick={() => setDrawer(false)}>{t('close')}</button>
        <div className="session-navigation" inert={taskStarting}>
          <Sidebar
            projects={projects}
            sessions={sessions}
            onNewSession={() => { if (taskStarting) return; setArea('workbench'); setSelectedSessionId(null); setDrawer(false); }}
            selectedProjectRoot={projectRoot}
            onSelectProject={root => { if (taskStarting) return; setProjectRoot(root); setArea('workbench'); setSelectedSessionId(null); setDrawer(false); }}
            selectedSessionId={selectedSessionId}
            onSelectSession={id => { if (taskStarting) return; setSelectedSessionId(id); setArea('workbench'); setDrawer(false); }}
            onRenameTopic={(id, title) => void updateSessionTopic(id, { title })}
            onArchiveTopic={(id, isArchived) => void updateSessionTopic(id, { isArchived })}
            onDeleteSession={(id) => void deleteSession(id)}
            onCollapse={() => setSidebarCollapsed(true)}
          />
        </div>
      </div>
      <main className="main" inert={drawer}>
        <div className="topbar">
          <button className="btn navigation-toggle" aria-label={t('navigationMenu')} aria-expanded={drawer} onClick={() => setDrawer(value => !value)}>☰</button>
          {sidebarCollapsed && <button className="btn desktop-sidebar-toggle" aria-label="展开侧边栏" title="展开侧边栏" onClick={() => setSidebarCollapsed(false)}>›</button>}
          <StatusBar health={health} error={serverError} />
          <div className="topbar-actions">
            <CommandPalette commands={commands} />
            <details className="preferences-menu"><summary className="btn">{t('preferences')}</summary><div className="preferences-content"><AttentionControls attention={attention} /><CustomizePanel modules={modules} onChange={handleModulesChange} /><LanguageSwitcher /></div></details>
          </div>
        </div>
        {area === 'activity' ? <section className="main-body"><h2>{t('activity')}</h2><p className="dim">{t('activityHint')}</p><ActivityQueue api={api} onOpenSession={id => { setSelectedSessionId(id); setArea('workbench'); }} /><div className="activity-sessions">{sessions.filter(session => !session.topic?.isArchived).map(session => <button className="btn" key={session.id} disabled={taskStarting} onClick={() => { if (taskStarting) return; setSelectedSessionId(session.id); setArea('workbench'); }}><strong>{readableSessionTitle(session, t('sessionNew'))}</strong><span>{projectName(session.workspaceRoot)} · {new Date(session.updatedAt ?? session.createdAt).toLocaleString()}</span></button>)}</div>{!sessions.length && <p>{t('noSessions')}</p>}<TeamTaskTree api={api} sessionId={nothingSelected ? null : selectedSessionId} /><SubagentWorkspace api={api} /></section>
 : null}
        {area === 'studio' ? <section className="main-body"><h2>{t('agentStudio')}</h2><p className="dim">{t('studioHint')}</p><AgentStudioComposer api={api} sessionId={nothingSelected ? null : selectedSessionId} /><AgentStudioInspector api={api} selectedSessionId={nothingSelected ? null : selectedSessionId} /><CognitiveRulesDashboard api={api} /></section>
 : null}
        {area === 'settings' ? <section className="main-body"><h2>{t('settings')}</h2><ProviderHub api={api} onChanged={() => setProviderRevision(previous => previous + 1)} /><p className="dim">{t('layoutBoundary')}</p><CustomizePanel modules={modules} onChange={handleModulesChange} /><LanguageSwitcher /><AttentionControls attention={attention} /></section>
 : null}
        <div className="workbench-region" hidden={area !== 'workbench'}>
        {nothingSelected ? (
          <section className="main-body workbench-home">
            <p className="dim">{t('hierarchyHint')}</p>
            {serverError && <p role="alert" className="error-text">{t('serverDown')} <code>vessel serve</code> <button className="btn" onClick={() => void connect()}>{t('modelRetry')}</button></p>}
            <TaskComposer onBusyChange={setTaskStarting} api={api} projects={projects} selectedRoot={projectRoot} onSelectProject={setProjectRoot} providerRevision={providerRevision} disabled={serverError || !health?.ok} onConfigureModels={() => setShowProviders(true)} onAdvanced={() => setShowNew(true)} onStarted={(session, task) => { setSessions(current => [session, ...current.filter(item => item.id !== session.id)]); setProjectRoot(session.workspaceRoot); setInitialTask({ sessionId: session.id, text: task }); setSelectedSessionId(session.id); void connect(); }} />
          </section>
        ) : (
          <div className="conversation-wrap">
            <ConversationView initialTask={initialTask} onInitialTaskConsumed={() => setInitialTask(undefined)} sessionTitle={readableSessionTitle(sessions.find(session => session.id === selectedSessionId)!, t('sessionNew'))} providerRevision={providerRevision} onConfigureModels={() => setShowProviders(true)} attention={attention} viewRequest={viewRequest} sessionId={selectedSessionId as string} api={api} onSessionUpdated={() => void connect()} />
            <ModuleSections modules={modules} api={api} sessionId={selectedSessionId as string} />
          </div>
        )}
        </div>
      </main>
      {showNew && <NewSessionForm hidden={showProviders} providerRevision={providerRevision} onConfigureModels={() => setShowProviders(true)} initialWorkspaceRoot={projectRoot} initialPermission={newPermission} api={api} onCreated={onCreated} onClose={() => setShowNew(false)} />}
      {showProviders && <ProviderSettingsModal api={api} onClose={() => setShowProviders(false)} onChanged={() => setProviderRevision(previous => previous + 1)} />}
    </div>
  );
}

/** Render the enabled UI module sections in display order (placeholders for now). */
function ModuleSections({
  modules,
  api,
  sessionId,
}: {
  modules: UiModuleState;
  api: ApiClient;
  sessionId: string | null;
}) {
  const enabled = SECTION_ORDER.filter((key) => modules[key]);
  if (enabled.length === 0) return null;
  return (
    <div className="module-sections">
      {enabled.map((key) => (
        <ModuleSection key={key} id={key} api={api} sessionId={sessionId} />
      ))}
    </div>
  );
}

function ModuleSection({
  id,
  api,
  sessionId,
}: {
  id: UiModuleId;
  api: ApiClient;
  sessionId: string | null;
}) {
  const { t } = useI18n();
  switch (id) {
    case 'Swarm':
      return <SwarmTopologyView api={api} />;
    case 'CognitiveRules':
      return <CognitiveRulesDashboard api={api} />;
    case 'Team':
      // task 060: real Team module (model select + team panel + external review)
      // needs a session; without one show the friendly prompt.
      if (!sessionId) {
        return (
          <div className="module-card">
            <div className="module-card-title">{t('uiTeam')}</div>
            <div className="module-card-body dim">{t('teamModuleNoSession')}</div>
          </div>
        );
      }
      return (
        <div className="module-card module-card-team">
          <div className="module-card-title">{t('uiTeam')}</div>
          <div className="module-card-body">
            <TeamModule sessionId={sessionId} api={api} />
          </div>
        </div>
      );
    case 'Tasks':
      // task 065: real Goal module (task queue + iteration replay + run control)
      // needs a session; without one show the friendly prompt.
      if (!sessionId) {
        return (
          <div className="module-card">
            <div className="module-card-title">{t('uiGoals')}</div>
            <div className="module-card-body dim">{t('goalModuleNoSession')}</div>
          </div>
        );
      }
      return (
        <div className="module-card module-card-goal">
          <div className="module-card-title">{t('uiGoals')}</div>
          <div className="module-card-body">
            <GoalModule sessionId={sessionId} api={api} />
          </div>
        </div>
      );
    case 'ChangedFiles':
    case 'Cost':
    case 'ToolActivity':
      // Real session data is shown in the conversation Inspector.
      return null;
    default:
      if (UNIMPLEMENTED.includes(id)) {
        return (
          <div className="module-card">
            <div className="module-card-title">{localizedValue(id, t)}</div>
            <div className="module-card-body dim">{t('unimplemented')}</div>
          </div>
        );
      }
      return null;
  }
}
import { useEffect, useRef, useState } from 'react';
import type { ApiClient, CreateSessionInput, ModelOption, Project, SessionMeta } from '../api';
import { useI18n } from './LanguageProvider';
import { modelKey } from './NewSessionForm';
import { ModelQuickSwitcher } from './providers/ModelQuickSwitcher';
import { PROVIDER_PRESETS_CATALOG } from './providers/presetsData';

export function projectName(root: string): string { return root.split(/[\\/]/).filter(Boolean).at(-1) || root; }
export function readableSessionTitle(session: SessionMeta, fallback: string): string {
  const title = session.topic?.title?.trim();
  return title && !/^sess_|^untitled topic$|^未命名主题$/i.test(title) ? title : fallback;
}
/** Create a session only; its first turn goes through the existing conversation stream. */
export async function createTaskSession(api: ApiClient, input: CreateSessionInput, task: string, onBusyChange?: (busy: boolean) => void): Promise<SessionMeta> {
  if (!input.workspaceRoot.trim() || !task.trim()) throw new Error('Project and task are required');
  onBusyChange?.(true);
  try {
  await api.openProject(input.workspaceRoot.trim());
  const { session } = await api.createSession({ ...input, workspaceRoot: input.workspaceRoot.trim() });
  // ponytail: Titles are deterministic task summaries, never a second model call.
  try { await api.updateSessionTopic(session.id, { title: task.trim().replace(/\s+/g, ' ').slice(0, 80) }); } catch { /* Creation remains usable when metadata cannot be saved. */ }
  return session;
  } finally { onBusyChange?.(false); }
}
export default function TaskComposer({ api, projects, selectedRoot, onSelectProject, providerRevision, disabled, onConfigureModels, onAdvanced, onStarted, onBusyChange, draftRequest }: {
  api: ApiClient; projects: Project[]; selectedRoot: string; onSelectProject: (root: string) => void;
  providerRevision: number; disabled: boolean; onConfigureModels: (presetId?: string) => void; onAdvanced: () => void;
  onBusyChange?: (busy: boolean) => void;
  draftRequest?: { text: string; serial: number };
  onStarted: (session: SessionMeta, task: string) => void;
}) {
  const { t } = useI18n();
  const [task, setTask] = useState('');
  const taskInput = useRef<HTMLTextAreaElement>(null);
  const isComposingRef = useRef(false);
  useEffect(() => {
    if (!draftRequest) return;
    setTask(draftRequest.text);
    taskInput.current?.focus();
  }, [draftRequest]);
  const [path, setPath] = useState('');
  const [models, setModels] = useState<ModelOption[]>([]);
  const [selection, setSelection] = useState('');
  const [permission, setPermission] = useState<NonNullable<CreateSessionInput['permission']>>('workspace-write');
  const [loading, setLoading] = useState(true);
  const [failed, setFailed] = useState(false);
  const [retry, setRetry] = useState(0);
  const [busy, setBusy] = useState(false);
  const [error, setError] = useState('');
  useEffect(() => {
    let live = true; setLoading(true); setFailed(false);
    void api.listModels().then(({ models: catalog }) => {
      if (!live) return;
      const real = catalog.filter(model => model.providerName !== 'mock'); setModels(real);
      setSelection(previous => previous || (real[0] ? modelKey(real[0]) : ''));
    }).catch(() => { if (live) setFailed(true); }).finally(() => { if (live) setLoading(false); });
    return () => { live = false; };
  }, [api, providerRevision, retry]);
  const selectedModel = models.find(model => modelKey(model) === selection);
  const root = selectedRoot || path.trim();
  const unavailable = Boolean(selection && !models.some(model => modelKey(model) === selection));
  async function submit(event: React.FormEvent) {
    event.preventDefault(); if (isComposingRef.current || !root || !task.trim() || busy || loading || failed || unavailable || disabled) return;
    setBusy(true); setError('');
    try {
      const model = models.find(item => modelKey(item) === selection);
      const session = await createTaskSession(api, { workspaceRoot: root, permission, ...(model ? { provider: model.providerName, model: model.id } : {}) }, task, onBusyChange);
      onStarted(session, task.trim());
    } catch { setError(t('sessionCreateFailed')); } finally { setBusy(false); }
  }
  return <form className="task-composer" onSubmit={submit}>
    <h2>{t('taskPrompt')}</h2>
    <label htmlFor="taskProject">{t('chooseProject')}</label>
    <div className="capsule-select">
    <select id="taskProject" className="input" value={selectedRoot} disabled={busy} onChange={event => onSelectProject(event.target.value)}>
      <option value="">{t('openProjectPath')}</option>
      {projects.map(project => <option key={project.root} value={project.root}>{projectName(project.root)}</option>)}
    </select>
    <svg viewBox="0 0 16 16" fill="none" stroke="currentColor" strokeWidth="1.5" aria-hidden="true"><path d="m4 6 4 4 4-4" /></svg>
    </div>
    {selectedRoot ? <p className="composer-root dim" title={root}>{root}</p> : <input className="input" aria-label={t('workspacePath')} placeholder={t('workspacePlaceholder')} value={path} onChange={event => setPath(event.target.value)} disabled={busy} />}
    <div className="composer-surface">
    <label htmlFor="taskInput">{t('taskPrompt')}</label>
    <textarea ref={taskInput} id="taskInput" className="input task-input" placeholder={t('taskPlaceholder')} value={task} onChange={event => setTask(event.target.value)} disabled={busy}
      onCompositionStart={() => { isComposingRef.current = true; }}
      onCompositionEnd={() => { isComposingRef.current = false; }}
      onKeyDown={event => {
        if (event.key === 'Enter' && !event.shiftKey) {
          if (isComposingRef.current || event.nativeEvent.isComposing || event.keyCode === 229) return;
          event.preventDefault(); void submit(event);
        }
      }} />
    <div className="composer-options composer-pills">
      <ModelQuickSwitcher models={models} current={selectedModel ? { provider: selectedModel.providerName, model: selectedModel.id } : null}
        disabled={busy || loading || failed || disabled} onSelect={model => setSelection(JSON.stringify([model.provider, model.model]))} onOpenSettings={() => onConfigureModels()} />
      <label>{t('permissionLabel')}<span className="capsule-select"><select className="input" aria-label={t('permissionLabel')} value={permission} disabled={busy} onChange={event => setPermission(event.target.value as typeof permission)}>
        <option value="read-only">{t('permissionReadOnly')}</option><option value="workspace-write">{t('permissionWorkspaceWrite')}</option>
      </select><svg viewBox="0 0 16 16" fill="none" stroke="currentColor" strokeWidth="1.5" aria-hidden="true"><path d="m4 6 4 4 4-4" /></svg></span></label>
      <button className="btn btn-primary composer-send" type="submit" disabled={busy || disabled || loading || failed || unavailable || !root || !task.trim()}>{busy ? t('creating') : t('startTask')}</button>
    </div>
    </div>
    {unavailable && !loading && <p role="alert" className="error-text">{t('modelUnavailable')}</p>}
    {loading && <p role="status" className="dim">{t('loading')}</p>}
    {failed && <p role="alert" className="error-text">{t('modelLoadFailed')} <button className="btn" type="button" onClick={() => setRetry(value => value + 1)}>{t('modelRetry')}</button></p>}
    {!loading && !failed && !models.length && <section className="task-composer-onboarding" aria-label={t('onboardingTitle')}>
      <h3>{t('onboardingTitle')}</h3><p className="dim">{t('onboardingSubtitle')}</p>
      <div className="onboarding-grid">{['deepseek', 'anthropic', 'openrouter', 'custom'].map(id => {
        const preset = PROVIDER_PRESETS_CATALOG.find(item => item.id === id);
        return <button type="button" key={id} className="onboarding-card" disabled={busy || disabled} onClick={() => onConfigureModels(id)}>
          <strong>{id === 'anthropic' ? 'Claude' : preset?.name ?? t('providerCustom')}</strong>
          <small>{preset?.defaultModel ? t('onboardingRecommendedModels', { models: preset.defaultModel }) : t('onboardingCustomHint')}</small>
        </button>;
      })}</div>
    </section>}
    {error && <p role="alert" className="error-text">{error}</p>}
    <div className="composer-secondary"><button className="btn" type="button" data-action="advanced-session" onClick={onAdvanced} disabled={busy}>{t('advancedSession')}</button><button className="btn" type="button" data-action="configure-models" onClick={() => onConfigureModels()} disabled={busy}>{t('configureModels')}</button></div>
  </form>;
}
import { useCallback, useEffect, useRef, useState } from 'react';
import type { ApiClient } from '../api';
import { ApiError, failureMessage } from '../api';
import { createEventStream, type ConversationDelta, type ThinkingDelta, type ToolDelta, type UsageDelta } from '../sse';
import ModelSelector from './ModelSelector';
import MessageList, { upsertWidget, resolveWidget, type ChatItem } from './MessageList';
import UsageBar, { applyUsageDelta, usageCallCost, emptyUsage, type UsageTotals } from './UsageBar';
import TalkingMetricsBar, { type TalkingMetrics } from './TalkingMetricsBar';
import { useI18n } from './LanguageProvider';
import SandboxAuditHistory from './SandboxAuditHistory';
import PlanChecklist, { usePlanTasks, planProgress } from './PlanChecklist';
import ComposerCapsules, { MetersRow, useContextWindow } from './ComposerMeters';
import { DualSurfaceLayout, appendCacheObservation, type InspectorTab } from './layout/DualSurfaceLayout';
import type { CacheUsageMetrics } from '../cacheUsage';
import type { InspectorObservation } from '../inspector';
import type { ImpactRadarWidget } from '@vessel/shared';
import type { AttentionManager } from '../utils/attentionManager';

interface Props {
  initialTask?: { sessionId: string; text: string };
  onInitialTaskConsumed?: () => void;
  sessionTitle?: string;
  providerRevision?: number;
  onConfigureModels?: () => void;
  attention?: AttentionManager;
  sessionId: string;
  api: ApiClient;
  onSessionUpdated?: () => void;
  viewRequest?: { action: 'clear' | 'collapse' | 'expand' | 'export' | InspectorTab; serial: number };
}

let counter = 0;
function nextId(): string {
  counter += 1;
  return `${Date.now()}-${counter}`;
}

function conversationItem(delta: ConversationDelta): ChatItem {
  return { id: nextId(), kind: 'message', msg: delta };
}

interface ConversationSnapshot {
  items: ChatItem[];
  usage: UsageTotals;
  turnMetrics: TalkingMetrics;
  cacheHistory: CacheUsageMetrics[];
  observation?: InspectorObservation;
  input: string;
  pendingTool: Record<string, ToolDelta>;
}
// ponytail: replay only observations from this page lifetime, including view remounts.
// The existing server API has no transcript hydration; reloads and unseen turns
// cannot be reconstructed here. Weak API ownership keeps different clients isolated.
const snapshotsByClient = new WeakMap<ApiClient, Map<string, ConversationSnapshot>>();

/**
 * Conversation main view for a selected session: message list + input, plus a
 * live SSE stream over /api/sessions/:id/events that appends assistant text,
 * tool activity, usage and policy deltas as they happen.
 */
export default function ConversationView({ sessionId, api, onSessionUpdated, viewRequest, attention, providerRevision, onConfigureModels, initialTask, onInitialTaskConsumed, sessionTitle }: Props) {
  const { t } = useI18n();
  const saved = snapshotsByClient.get(api)?.get(sessionId);
  const [items, setItems] = useState<ChatItem[]>(() => saved?.items ?? []);
  const [usage, setUsage] = useState<UsageTotals>(() => saved?.usage ?? emptyUsage());
  const [turnMetrics, setTurnMetrics] = useState<TalkingMetrics>(() => saved?.turnMetrics ?? {});
  const [cacheHistory, setCacheHistory] = useState<CacheUsageMetrics[]>(() => saved?.cacheHistory ?? []);
  const [observation, setObservation] = useState<InspectorObservation | undefined>(() => saved?.observation);
  const [input, setInput] = useState(() => saved?.input ?? '');
  const [modelBusy, setModelBusy] = useState(false);
  const [busy, setBusy] = useState(false); // a turn is in flight
  const [error, setError] = useState<string | null>(null);
  const [serverDown, setServerDown] = useState(false);
  const [auditRevision, setAuditRevision] = useState(0);
  const contextWindow = useContextWindow(api, sessionId, providerRevision);
  const planTasks = usePlanTasks(api, sessionId, items.length);
  const planProgressValue = planProgress(planTasks);
  const setRouteMode = useCallback((mode: 'auto' | 'fast' | 'pro') => { void api.setRouteMode(sessionId, mode).catch(() => { /* best effort: the capsule keeps its previous value */ }); }, [api, sessionId]);
  const pendingTool = useRef<Record<string, ToolDelta>>({});
  const latest = useRef({ items, usage, turnMetrics, cacheHistory, observation, input });
  const listRef = useRef<HTMLDivElement | null>(null);
  const activeSession = useRef(sessionId);
  const sessionGeneration = useRef(0);
  activeSession.current = sessionId;
  useEffect(() => {
    if (viewRequest?.action === 'clear') setItems([]);
    if (viewRequest?.action === 'export') {
      const url = URL.createObjectURL(new Blob([JSON.stringify({ sessionId, items }, null, 2)], { type: 'application/json' }));
      const link = document.createElement('a'); link.href = url; link.download = `vessel-${sessionId}-visible.json`; link.click();
      setTimeout(() => URL.revokeObjectURL(url), 0);
    }
  }, [viewRequest]);
  const respondWidget = useCallback(async (widgetId: string, optionId: string) => {
    const generation = sessionGeneration.current;
    await api.respondWidget(sessionId, widgetId, optionId);
    if (activeSession.current === sessionId && sessionGeneration.current === generation) {
      attention?.resolvedWidget(sessionId, widgetId);
      attention?.clear();
      setItems(previous => resolveWidget(previous, { widgetId, selectedOptionId: optionId, resolvedAt: new Date().toISOString() }));
    }
  }, [api, sessionId, attention]);

  const appendMessage = useCallback((delta: ConversationDelta) => {
    setItems((prev) => [...prev, conversationItem(delta)]);
  }, []);

  const onTool = useCallback((delta: ToolDelta) => {
    if (delta.sandbox) setAuditRevision(value => value + 1);
    setItems((prev) => {
      const next = [...prev];
      const key = delta.toolCallId ?? delta.toolName ?? '?';
      if (delta.status === 'started') {
        pendingTool.current[key] = delta;
        next.push({ id: nextId(), kind: 'tool', tool: delta });
      } else {
        // replace the matching started row (by toolName) with its terminal delta
        const idx = next.findIndex(
          (it) => it.kind === 'tool' && (it.tool?.toolCallId ?? it.tool?.toolName ?? '?') === key && it.tool?.status === 'started',
        );
        const start = pendingTool.current[key];
        const closed: ToolDelta = {
          ...(start ?? {}),
          ...delta,
          durationMs: typeof delta.durationMs === 'number' ? delta.durationMs : durationFrom(start, delta),
        };
        delete pendingTool.current[key];
        if (idx >= 0) next[idx] = { id: nextId(), kind: 'tool', tool: closed };
        else next.push({ id: nextId(), kind: 'tool', tool: closed });
      }
      return next;
    });
  }, []);

  const onUsage = useCallback((delta: UsageDelta) => {
    if (delta.cacheMetrics) setCacheHistory(history => appendCacheObservation(history, delta.cacheMetrics!));
    setUsage((prev) => applyUsageDelta(prev, delta));
    const deltaCost = usageCallCost(delta);
    setTurnMetrics((prev) => ({
      inputTokens: (prev.inputTokens ?? 0) + (delta.inputTokens ?? 0),
      outputTokens: (prev.outputTokens ?? 0) + (delta.outputTokens ?? 0),
      ...(prev.reasoningTokens !== undefined || delta.reasoningTokens !== undefined
        ? { reasoningTokens: (prev.reasoningTokens ?? 0) + (delta.reasoningTokens ?? 0) }
        : {}),
      cacheReadTokens: (prev.cacheReadTokens ?? 0) + (delta.cacheReadTokens ?? 0),
      ...(prev.latencyMs !== undefined || delta.latencyMs !== undefined
        ? { latencyMs: (prev.latencyMs ?? 0) + (delta.latencyMs ?? 0) }
        : {}),
      costUsd: (prev.costUsd ?? 0) + deltaCost,
      estimated: Boolean(prev.estimated || (delta.estimated ?? true)),
      ...(delta.cacheMetrics ? { cacheMetrics: {
        ...delta.cacheMetrics,
        promptTokens: (prev.cacheMetrics?.promptTokens ?? 0) + delta.cacheMetrics.promptTokens,
        cachedTokens: (prev.cacheMetrics?.cachedTokens ?? 0) + delta.cacheMetrics.cachedTokens,
        creationTokens: (prev.cacheMetrics?.creationTokens ?? 0) + delta.cacheMetrics.creationTokens,
        estimatedSavingsUsd: (prev.cacheMetrics?.estimatedSavingsUsd ?? 0) + delta.cacheMetrics.estimatedSavingsUsd,



hook: PreToolUse
hook: PreToolUse
hook: PreToolUse Completed
