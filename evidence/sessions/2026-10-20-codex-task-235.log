/* P2/P3: glass shell — frosted rail + session bar, floating panels */
.rail {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 8px;
  min-height: 0;
  padding: 12px 0;
  border-radius: var(--r-panel);
  background: var(--glass);
  border: var(--ring-hairline) solid var(--ring);
  box-shadow: var(--shadow-2);
  backdrop-filter: blur(26px) saturate(1.7);
  -webkit-backdrop-filter: blur(26px) saturate(1.7);
}
.rail-mark {
  display: grid;
  place-items: center;
  width: 30px;
  height: 30px;
  margin-bottom: 4px;
  border-radius: 10px;
  background: var(--accent-soft);
  color: var(--accent);
}
.rail-item {
  display: grid;
  place-items: center;
  width: 34px;
  height: 34px;
  border: 1px solid transparent;
  border-radius: var(--r-md);
  background: transparent;
  color: var(--text-2);
  cursor: pointer;
}
.rail-item:hover { background: var(--panel-2); color: var(--text); }
.rail-item-active { background: var(--accent-soft); border-color: var(--ring-2); color: var(--accent); }
.rail-footer {
  margin-top: auto;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 8px;
}
.rail-theme-toggle {
  border: 1px solid var(--ring);
  background: var(--panel-2);
  color: var(--text-2);
  box-shadow: var(--shadow-1);
}
.rail-theme-toggle:hover {
  background: var(--accent-soft);
  color: var(--accent);
  border-color: var(--ring-2);
}
.desktop-sidebar-toggle { flex-shrink: 0; margin-left: 12px; }
.sidebar-collapse { margin-left: auto; min-width: 40px; min-height: 40px; }
@media (min-width: 1181px) {
  .app.sidebar-collapsed { grid-template-columns: 58px 0px minmax(0, 1fr); }
  .sidebar-collapsed .navigation-shell { visibility: hidden; pointer-events: none; }
}
.navigation-shell {
  display: flex;
  flex-direction: column;
  min-height: 0;
  border-radius: var(--r-3);
  background: var(--panel);
  border: 1px solid var(--ring);
  box-shadow: var(--shadow-2);
  overflow: hidden;
}
.topbar {
  position: sticky;
  top: 0;
  z-index: 20;
  border-radius: var(--r-2);
  background: var(--glass);
  border: 1px solid var(--ring);
  box-shadow: var(--shadow-1);
}
@supports (backdrop-filter: blur(1px)) {
  .navigation-shell, .topbar {
    backdrop-filter: blur(26px) saturate(1.7);
    -webkit-backdrop-filter: blur(26px) saturate(1.7);
  }
}
.main {
  min-width: 0;
  min-height: 0;
  background: var(--panel);
  border: var(--ring-hairline) solid var(--ring);
  border-radius: var(--r-panel);
  box-shadow: var(--shadow-2);
  overflow: hidden;
}
.navigation-shell .sidebar { background: transparent; border-right: 0; padding: 14px 12px 12px; }

/* ---------- subagent workspace ---------- */
.subagent-card { display: flex; align-items: center; gap: 4px; }
.subagent-select { flex: 1; display: flex; justify-content: space-between; gap: 8px; text-align: left; }
.subagent-name { overflow-wrap: anywhere; }
.subagent-badge { font-size: 11px; color: var(--dim); }
.subagent-badge.status-running { color: var(--accent); }
.subagent-badge.status-completed { color: var(--green); }
.subagent-badge.status-failed { color: var(--red); }
.subagent-drawer { position: fixed; z-index: 30; right: 0; top: 0; bottom: 0; width: min(480px, 100vw); padding: 24px; overflow-y: auto; background: var(--bg); border-left: 1px solid var(--border); box-shadow: -8px 0 24px #0002; animation: subagent-slide 160ms ease-out; }
.subagent-drawer-heading { display: flex; align-items: center; justify-content: space-between; gap: 12px; }
.subagent-fields { display: grid; grid-template-columns: auto 1fr; gap: 8px 16px; }
.subagent-fields dt { color: var(--dim); }
.subagent-fields dd { margin: 0; overflow-wrap: anywhere; }
.subagent-logs { padding-left: 20px; overflow-wrap: anywhere; }
.subagent-logs li { margin-bottom: 8px; }
.subagent-logs time { color: var(--dim); font-size: 11px; }
@keyframes subagent-slide { from { transform: translateX(100%); } to { transform: translateX(0); } }
@media (prefers-reduced-motion: reduce) { .subagent-drawer { animation: none; } }

/* ---------- sidebar ---------- */
.sidebar {
  display: flex;
  flex-direction: column;
  gap: 12px;
  padding: 14px 12px 12px;
  background: var(--panel);
  border-right: var(--ring-hairline) solid var(--ring);
  overflow-y: auto;
}

.brand {
  display: flex;
  align-items: center;
  gap: 8px;
  font-size: 16px;
  font-weight: 700;
}

.brand-name {
  letter-spacing: 0.3px;
}

.side-nav {
  display: flex;
  flex-direction: column;
  gap: 16px;
  flex: 1;
}

.side-label {
  font-size: 11px;
  text-transform: uppercase;
  letter-spacing: 0.6px;
  color: var(--dim);
}

.side-list {
  list-style: none;
  margin: 6px 0 0;
  padding: 0;
  display: flex;
  flex-direction: column;
  gap: 2px;
}

.side-item {
  padding: 6px 8px;
  border-radius: var(--r-sm);
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
  color: var(--text-soft);
}

.side-item:hover {
  background: var(--hover);
}

.side-item-active {
  background: var(--panel-2);
  color: var(--accent);
  font-weight: 600;
}

.side-empty {
  padding: 6px 8px;
  color: var(--dim);
}

.side-search { position: relative; display: flex; align-items: center; margin-top: 8px; }
.side-search > svg { position: absolute; left: 9px; width: 13px; height: 13px; color: var(--text-3); pointer-events: none; }
.topic-search {
  width: 100%; min-width: 0; padding: 7px 10px 7px 28px;
  border: var(--ring-hairline) solid var(--ring); border-radius: var(--r-pill);
  background: var(--panel-2); color: var(--text); font: inherit; font-size: 12px;
  transition: border-color var(--dur-snap) var(--ease-swift), box-shadow var(--dur-snap) var(--ease-swift);
}
.topic-search::placeholder { color: var(--text-3); }
.topic-search:hover { border-color: var(--ring-2); }
.topic-search:focus { outline: none; border-color: var(--ring-2); box-shadow: var(--focus-ring); }
.topic-archived-toggle {
  display: inline-flex; align-items: center; gap: 6px; margin: 7px 2px; padding: 4px 8px;
  border-radius: var(--r-pill); color: var(--text-3); font-size: 11px; cursor: pointer;
  transition: background-color var(--dur-snap) var(--ease-swift);
}
.topic-archived-toggle:hover, .topic-archived-toggle:focus-within { background: var(--panel-2); }
.topic-archived-toggle:has(input:checked) { background: var(--accent-soft); color: var(--accent); }
.topic-archived-toggle input { accent-color: var(--accent); margin: 0; }
.topic-period-list { max-height: min(58vh, 680px); overflow-y: auto; }
.topic-period { margin-top: 12px; }
.topic-period-label { padding: 4px 6px; }
.topic-group { margin: 2px 0 4px; padding: 2px 0 4px; }
.topic-heading {
  display: flex; align-items: center; min-width: 0; border-radius: var(--r-sm);
  transition: background-color var(--dur-snap) var(--ease-swift);
}
.topic-heading:hover, .topic-heading:focus-within { background: var(--panel-2); }
.topic-title {
  flex: 1; min-width: 0; border: 0; padding: 4px 6px; border-radius: var(--r-sm);
  background: transparent; color: var(--text); text-align: left; font: inherit; font-size: 13px; font-weight: 650;
  overflow: hidden; text-overflow: ellipsis; white-space: nowrap; cursor: pointer;

