}

/* ---------- conversation view (task 042) ---------- */
.conversation {
  flex: 1;
  display: flex;
  flex-direction: column;
  min-height: 0;
}

.conversation-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 12px;
  padding: 10px 24px;
  border-bottom: 1px solid var(--border);
}

.message-list-scroll {
  flex: 1;
  overflow-y: auto;
  padding: 24px;
  display: flex;
  flex-direction: column;
  gap: 12px;
  min-height: 0;
}

.message-list {
  display: flex;
  flex-direction: column;
  gap: 12px;
  margin: 0 auto;
  width: 100%;
  max-width: 760px;
}

.conversation-empty {
  color: var(--dim);
  text-align: center;
  margin: 40px 0;
}

.conversation-error {
  text-align: center;
.provider-result.failure { color: var(--danger); }

/* P2/P3: rail nav layout (glass shell rules live near the top of this file) */
.primary-nav { display: flex; flex-direction: column; gap: 6px; }
.navigation-shell .sidebar { flex: 1; min-height: 0; border: 0; }
.project-select { background: none; border: 0; color: inherit; padding: 4px; width: 100%; text-align: left; cursor: pointer; }
.main, .topbar, .statusbar { min-width: 0; }
.topbar { flex-wrap: nowrap; }
.statusbar { overflow: hidden; }
.status-text { white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
.topbar-actions { flex-shrink: 0; }
.preferences-menu { position: relative; }
.preferences-menu summary { list-style: none; cursor: pointer; }
.preferences-content { position: absolute; right: 0; top: 100%; z-index: 25; background: var(--panel); border: 1px solid var(--border); padding: 12px; display: grid; gap: 12px; width: 280px; }
.workbench-home { display: flex; flex-direction: column; gap: 20px; width: 100%; max-width: 960px; margin-inline: auto; overflow-y: auto; }
.home-heading h1 { margin: 0; font-size: clamp(24px, 3vw, 32px); font-weight: 500; letter-spacing: -.02em; text-wrap: balance; }
.workbench-home > p { margin: 0; color: var(--text-2); }
.home-workspace { display: flex; flex-wrap: wrap; align-items: center; justify-content: space-between; gap: 12px; background: var(--panel-2); padding: 16px; border-radius: var(--r-1); }
.home-workspace > div { min-width: 0; flex: 1; }
.workbench-home h2 { font-size: 14px; font-weight: 500; }
.home-workspace p { margin: 0; font-size: 12px; color: var(--text-2); overflow-wrap: anywhere; }
.home-health { color: var(--text-2); font-size: 12px; }
.home-health.is-online { color: var(--ok); }
.starter-prompts { display: flex; flex-wrap: wrap; gap: 8px; }
.starter-pill { border-radius: var(--r-pill); min-height: 40px; }
.home-session-grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(min(100%, 220px), 1fr)); gap: 12px; }
.home-session { display: grid; gap: 6px; text-align: left; padding: 16px; border-radius: var(--r-1); min-width: 0; }
.home-session strong { font-weight: 500; overflow-wrap: anywhere; }
.home-session span, .home-session time, .home-recent > p { font-size: 12px; color: var(--text-2); overflow-wrap: anywhere; }
.home-session time { font-variant-numeric: tabular-nums; }
.task-composer { width: min(760px, 100%); display: grid; gap: 12px; margin: 24px auto; padding: 12px; border: 0; border-radius: calc(var(--r-composer) + 12px); background: var(--panel-2); }
.workbench-home .task-composer { width: 100%; margin: 0; }
.task-composer h2 { margin: 0 0 12px; }
.composer-surface {
  display: grid; gap: 12px; min-width: 0; padding: 16px; background: var(--panel);
  border-radius: var(--r-composer); border: var(--ring-hairline) solid var(--ring);
  box-shadow: 0 4px 20px rgba(0, 0, 0, 0.04);
  transition: box-shadow var(--dur-base) var(--ease-swift), border-color var(--dur-base) var(--ease-swift);
}
.composer-surface:hover { border-color: var(--ring-2); box-shadow: 0 6px 24px rgba(0, 0, 0, 0.07); }
.composer-surface:focus-within { border-color: var(--ring-2); box-shadow: 0 6px 28px rgba(0, 0, 0, 0.1), var(--focus-ring); }
.composer-surface .task-input { min-height: 150px; resize: vertical; font: inherit; border: 0; border-radius: var(--r-sm); background: transparent; box-shadow: none; }
.composer-surface .task-input:focus { outline: none; }
.composer-root { margin: 0; overflow-wrap: anywhere; font-size: 12px; }
.composer-options { display: flex; flex-wrap: wrap; gap: 12px; align-items: end; }
.composer-options label { display: grid; gap: 4px; flex: 1; min-width: 0; }
.capsule-select {
  position: relative; display: flex; align-items: center; min-width: 0; border-radius: var(--r-pill);
  border: var(--ring-hairline) solid var(--ring); background: var(--panel-2);
  transition: border-color var(--dur-snap) var(--ease-swift), box-shadow var(--dur-snap) var(--ease-swift);
}
.capsule-select:hover { border-color: var(--ring-2); }
.capsule-select:focus-within { border-color: var(--ring-2); box-shadow: var(--focus-ring); }
.capsule-select select.input {
  appearance: none; width: 100%; min-width: 0; border: 0; border-radius: inherit; padding: 8px 30px 8px 12px;
  background: transparent; color: var(--text); font: inherit; font-size: 12px; text-overflow: ellipsis; cursor: pointer;
}
.capsule-select select:focus { outline: none; box-shadow: none; }
.capsule-select option { background: var(--panel); color: var(--text); }
.capsule-select > svg { position: absolute; right: 10px; width: 14px; height: 14px; color: var(--text-3); pointer-events: none; }
.composer-send { border-radius: var(--r-pill); min-height: 36px; padding: 8px 16px; transition: transform var(--dur-fast) var(--ease-swift), background-color var(--dur-snap) var(--ease-swift); }
.composer-send:active:not(:disabled) { transform: scale(0.98); }
.composer-secondary { display: flex; flex-wrap: wrap; gap: 8px; }
.layout-boundary { font-size: 12px; padding: 0 12px; max-width: 320px; }
.activity-sessions { display: grid; gap: 12px; }
.activity-sessions .btn { display: grid; text-align: left; gap: 4px; }
.activity-sessions span { color: var(--dim); font-size: 12px; }
.command-group summary { font-weight: 600; padding: 10px; color: var(--dim); cursor: pointer; }
.navigation-toggle, .navigation-backdrop { display: none; }
/* ≤1180px: the session bar collapses into a drawer (DESIGN.md §4). The icon rail never collapses. */
@media (max-width: 1180px) {
  .app { grid-template-columns: 58px minmax(0, 1fr); }
  .navigation-shell { display: none; position: fixed; z-index: 45; top: 12px; bottom: 12px; left: 82px; width: min(320px, 82vw); }
  .navigation-open .navigation-shell { display: flex; }
  .navigation-toggle { display: inline-block; flex-shrink: 0; }
  .navigation-backdrop { display: block; position: fixed; z-index: 44; inset: 0; border: 0; background: #0007; }
  .desktop-sidebar-toggle, .sidebar-collapse { display: none; }
}
@media (max-width: 800px) {
  .topbar { gap: 8px; padding: 8px; }
  .topbar-actions { gap: 4px; }
  .topbar-actions .btn { padding: 5px 7px; font-size: 12px; }
  .main-body { padding: 16px; }
  .task-composer { margin: 8px 0; padding: 12px; }
  .composer-options { align-items: stretch; }
  .composer-options label { flex-basis: 100%; }
  .composer-options > button { width: 100%; }
  .modal { width: 100%; max-height: 95dvh; overflow-y: auto; }
  .conversation-head { min-width: 0; flex-wrap: wrap; }
  .preferences-content { width: min(280px, 88vw); }
}

.workbench-region { min-height: 0; flex: 1; display: flex; flex-direction: column; }
.workbench-region[hidden] { display: none; }

.command-group-toggle { background: none; border: 0; color: var(--dim); font: inherit; font-weight: 600; text-align: left; padding: 10px; width: 100%; cursor: pointer; }

.session-navigation { display: flex; flex-direction: column; flex: 1; min-height: 0; }

/* ---------- Task 234: Markdown Rich Formatting & OpenUI Generative Cards ---------- */
.conversation-markdown-body {
  display: flex;
  flex-direction: column;
  gap: 8px;
  line-height: 1.6;
  font-size: 13.5px;
  color: var(--text);
  word-break: break-word;
}
.markdown-p { margin: 0; }
.markdown-blank { height: 6px; }
.markdown-h1 {
  font-size: 18px; font-weight: 700; margin: 12px 0 4px; color: var(--text);
  border-bottom: 1px solid var(--ring); padding-bottom: 4px;
}
.markdown-h2 { font-size: 15px; font-weight: 650; margin: 10px 0 4px; color: var(--text); }
.markdown-h3 { font-size: 13.5px; font-weight: 600; margin: 8px 0 2px; color: var(--text); }
.markdown-blockquote {
  margin: 4px 0; padding: 6px 12px; border-left: 3px solid var(--accent);
  background: var(--panel-2); border-radius: 0 var(--r-sm) var(--r-sm) 0;
  color: var(--text-2); font-style: normal;
}
.markdown-inline-code {
  padding: 2px 6px; background: var(--panel-2); border: 1px solid var(--ring);
  border-radius: var(--r-sm); font-family: ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, monospace;
  font-size: 12px; color: var(--accent);
}
.markdown-code-block {
  margin: 8px 0; border: 1px solid var(--ring); border-radius: var(--r-md);
  background: var(--panel-2); overflow: hidden; box-shadow: var(--shadow-1);
}
.markdown-code-header {
  display: flex; align-items: center; justify-content: space-between;
  padding: 4px 10px; background: var(--panel-3); border-bottom: 1px solid var(--ring); font-size: 11px;
}
.markdown-code-lang {
  color: var(--text-3); font-family: ui-monospace, monospace; text-transform: uppercase; font-weight: 600;
}
.markdown-code-copy {
  border: 1px solid var(--ring); background: var(--panel-2); color: var(--text-2);
  cursor: pointer; padding: 2px 8px; font-size: 11px; border-radius: var(--r-sm);
}
.markdown-code-copy:hover {
  background: var(--accent-soft); color: var(--accent); border-color: var(--ring-2);
}
.markdown-pre {
  margin: 0; padding: 10px 14px; overflow-x: auto;
  font-family: ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, monospace;
  font-size: 12.5px; line-height: 1.5; color: var(--text);
}
.markdown-li { margin-left: 18px; color: var(--text); }
.markdown-ol-item { display: flex; align-items: baseline; gap: 6px; margin-left: 6px; }
.markdown-ol-num { font-weight: 600; color: var(--accent); min-width: 16px; }
.markdown-task-item { display: flex; align-items: center; gap: 8px; font-size: 13px; }
.markdown-checkbox { accent-color: var(--accent); }
.markdown-task-done { text-decoration: line-through; color: var(--text-3); }
.markdown-table-wrapper {
  overflow-x: auto; margin: 8px 0; border: 1px solid var(--ring);
  border-radius: var(--r-md); box-shadow: var(--shadow-1);
}
.markdown-table { width: 100%; border-collapse: collapse; font-size: 12.5px; text-align: left; }
.markdown-table th, .markdown-table td { padding: 8px 12px; border-bottom: 1px solid var(--ring); }
.markdown-table th { background: var(--panel-3); font-weight: 600; color: var(--text); }
.markdown-table tr:last-child td { border-bottom: none; }
.markdown-table tr:hover td { background: var(--panel-2); }

/* OpenUI Generative UI Components */
.openui-card {
  margin: 10px 0; padding: 14px 16px; border: 1px solid var(--ring);
  border-left-width: 4px; border-radius: var(--r-md); background: var(--panel-2);
  display: flex; flex-direction: column; gap: 10px; box-shadow: var(--shadow-2);
}
.openui-card-header { display: flex; align-items: center; gap: 10px; }
.openui-badge {
  font-size: 10px; font-weight: 700; padding: 2px 7px;
  border-radius: var(--r-pill); letter-spacing: 0.08em;
}
.openui-title { font-size: 14px; color: var(--text); }
.openui-summary { margin: 0; font-size: 13px; color: var(--text-2); }
.openui-grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(140px, 1fr)); gap: 10px; }
.openui-metric-box {
  padding: 10px 12px; border: 1px solid var(--ring); border-radius: var(--r-sm);
  background: var(--panel); display: flex; flex-direction: column; gap: 3px;
}
.openui-metric-label { font-size: 11px; color: var(--text-3); text-transform: uppercase; }
.openui-metric-val {
  font-size: 17px; font-weight: 700; color: var(--text); font-variant-numeric: tabular-nums;
}
.openui-metric-change { font-size: 10.5px; color: var(--ok); }
.openui-actions { display: flex; flex-wrap: wrap; gap: 8px; margin-top: 4px; }
@media (prefers-reduced-motion: reduce) { .model-chips *, .provider-hub * { scroll-behavior: auto; transition: none; } }
