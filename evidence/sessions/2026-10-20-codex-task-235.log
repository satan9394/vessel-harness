.onboarding-grid { display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); gap: 10px; margin-block-start: 12px; }
.preset-card:focus-visible, .preset-gallery-tab:focus-visible, .model-chip button:focus-visible, .model-switcher-trigger:focus-visible, .model-switcher-item:focus-visible, .onboarding-card:focus-visible { outline: 2px solid var(--accent); outline-offset: 2px; }
.model-chip button:disabled, .preset-card:disabled, .model-switcher-trigger:disabled, .onboarding-card:disabled { opacity: .5; cursor: default; }
