@@ -0,0 +1,34 @@
+# Task 251 verification
+
+## Changes
+
+- Compaction collects all metadata.keepID/keepId/keepIds aliases, preserves anchored content verbatim with summary IDs, retains tail metadata/id, and supplies requiredKeepIds to the conservation guard.
+- Conservation rejects missing IDs and IDs detached from their original anchor content with keep_id_lost. Multiple original anchors sharing an ID must all survive.
+- Summary metadata is stored in projectionCommit and restored on replay. This requires the small packages/shared/src/projection.ts change; packages/core is untouched.
+- IME Enter calls preventDefault and stopPropagation for composition-ref, native composition, and keyCode 229 signals.
+- Tests cover user/assistant/attempt/tool tails, aliases, duplicate/invalid ID values, disk reload, repeated compaction, detached/missing content, individual IME signals, normal Enter and non-Enter keys.
+
+## Final requested gates
+
+| Command | Result | Log |
+| --- | --- | --- |
+| `npx tsc -b` | exit 0 | [build](2026-10-20-task-251-build.log) |
+| `npm run typecheck:tests` | exit 0 | [test types](2026-10-20-task-251-test-types.log) |
+| `npx vitest run packages/context` | exit 0; 13 files, 113 tests | [context](2026-10-20-task-251-context.log) |
+| `npm run test:web` | exit 0; 51 files, 418 tests | [web](2026-10-20-task-251-web.log) |
+| `node evidence/sessions/2026-10-20-codex-adversarial-review-249-probes.mjs --verify-251` | exit 0; label-only anchor rejected and production keep-0 metadata/content preserved | [probes](2026-10-20-task-251-probes.log) |
+| `git diff HEAD --stat -- packages/core` | empty; Task 251 has zero core changes | see baseline note below |
+| `git diff --check` | exit 0 | no whitespace errors |
+
+All requested build/type/context/web/probe gates above ran after the final product/test edit.
+
+## Independent review
+
+Host-native independent reviewer inspected the Task 251 diff read-only. No blocking bugs found. Its initial request for final repeated-compaction assertions and assistant/attempt tail coverage was addressed; final re-review returned no findings. No local OC/AGY/CC/DSH/Codex CLI agent was launched. This was direct implementation with native review, not a PDW CLI relay.
+
+## Boundaries
+
+- `git diff origin/main --stat -- packages/core` is nonempty from historical local-only development: 8 files, +415/-6. `git diff HEAD --stat -- packages/core` is empty. The origin/main zero-change requirement cannot describe the existing checkout; historical work was preserved.
+- Anchor content is intentionally kept verbatim, so strongly anchored histories may compact less. No real provider calls or credentials used in probes.
+- IME verification uses the existing React hook test harness and models the browser default action; no real browser/OS IME session was exercised.
+- Broader `npm run test:all` was also attempted; final result pending in [full-suite log](2026-10-20-task-251-all.log).
diff --git a/packages/context/src/compaction/Compaction.test.ts b/packages/context/src/compaction/Compaction.test.ts
new file mode 100644
index 0000000000000000000000000000000000000000..9385bd3a777ae2566fb7850331831718ca220289
--- /dev/null
+++ b/packages/context/src/compaction/Compaction.test.ts
@@ -0,0 +1,46 @@
+import * as fs from 'node:fs';
+import * as os from 'node:os';
+import * as path from 'node:path';
+import { afterEach, expect, it } from 'vitest';
+import { Session } from '@vessel/core';
+import { projectSession } from '@vessel/shared';
+import { Compaction } from './Compaction.js';
+import { assertCompactionConservation } from './assertCompactionConservation.js';
+
+const roots: string[] = [];
+afterEach(() => { for (const root of roots.splice(0)) fs.rmSync(root, { recursive: true, force: true }); });
+
+it.each(['user/message', 'assistant/message', 'assistant/attempt', 'tool/result'] as const)(
+  'conserves summary and tail keepIDs through reload and repeated compaction (%s)', async type => {
+    const root = fs.mkdtempSync(path.join(os.tmpdir(), 'vessel-keepid-'));
+    roots.push(root);
+    let session = await Session.open({ workspaceRoot: root, sessionId: 'keepid' });
+    try {
+      await session.appendSync({ type: 'user/message', content: 'goal', metadata: { keepID: 'keep-0' } });
+      await session.appendSync({ type: 'assistant/message', content: 'ESSENTIAL_ANCHOR', metadata: { keepId: 'assistant-anchor', keepIds: ['alias', 'keep-0', 42] } });
+      for (let i = 0; i < 12; i++) await session.appendSync({ type: 'user/message', content: `filler-${i}` });
+      if (type === 'tool/result') await session.appendSync({ type: 'assistant/attempt', content: 'call', toolCalls: [{ toolCallId: 'call', name: 'read', args: {} }] });
+      await session.appendSync({ type, content: 'TAIL_ANCHOR', id: 'tail-message', toolCalls: [], toolCallId: 'call', metadata: { keepID: 'tail', keepId: 'tail-alias', keepIds: ['tail-array'], extra: 'retained' } });
+      const compact = () => new Compaction({ session, summarize: async () => 'unrelated summary' }).compact('manual');
+      const first = await compact();
+      expect(first.summary).toContain('keep-0');
+      expect(first.summary).toContain('ESSENTIAL_ANCHOR');
+      const tail = projectSession(session.sessionId, session.replay()).visibleMessages.find(r => r.id === 'tail-message');
+      expect(tail?.metadata).toEqual({ keepID: 'tail', keepId: 'tail-alias', keepIds: ['tail-array'], extra: 'retained' });
+      await session.close();
+      session = await Session.open({ workspaceRoot: root, sessionId: 'keepid' });
+      const assertAnchors = () => {
+        const projection = projectSession(session.sessionId, session.replay());
+        assertCompactionConservation({ originalMessages: [{ role: 'assistant', content: 'ESSENTIAL_ANCHOR', metadata: { keepId: 'assistant-anchor' } }],
+          compactedMessages: projection.visibleMessages.filter(r => typeof r.content === 'string').map(r => ({ role: 'user', content: r.content, metadata: r.metadata as Record<string, unknown> })),
+          requiredKeepIds: ['keep-0', 'assistant-anchor', 'alias', 'tail', 'tail-alias', 'tail-array'] });
+      };
+      assertAnchors();
+      for (let round = 0; round < 2; round++) {
+        for (let i = 0; i < 8; i++) await session.appendSync({ type: 'user/message', content: `next-${round}-${i}` });
+        await compact();
+        assertAnchors();
+      }
+    } finally { await session.close(); }
+  },
+);
