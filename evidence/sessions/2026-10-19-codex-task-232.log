diff --git a/apps/web/src/styles.css b/apps/web/src/styles.css
index c815c32baee24ce5e8b8c2ce71d1f08d2f113444..720dbd498f0f659a515b61c8a520b3b6d0f04127
--- a/apps/web/src/styles.css
