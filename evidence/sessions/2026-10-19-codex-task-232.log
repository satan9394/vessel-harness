diff --git a/apps/web/src/styles.css b/apps/web/src/styles.css
index c815c32baee24ce5e8b8c2ce71d1f08d2f113444..98cb0ac43e926bb583c88c98a2355c81a94fd4bd
--- a/apps/web/src/styles.css
+++ b/apps/web/src/styles.css
@@ -1578,6 +1578,38 @@
 .model-chip button { background: transparent; color: inherit; border: 0; padding: 7px 9px; cursor: pointer; }
 .model-chip .model-chip-toggle { overflow-wrap: anywhere; min-width: 0; text-align: start; }
 .model-chip-input { flex: 1 1 220px; min-width: 0; }
+
+/* Task 232: providers as a first-class settings surface. */
+.provider-hub-page { display: flex; flex: 0 0 auto; flex-direction: column; gap: 32px; width: 100%; max-width: none; box-sizing: border-box; }
+.provider-hub, .provider-hub-panel, .provider-hub-content > *, .provider-registry { min-width: 0; }
+.provider-hub-content { display: grid; gap: 24px; }
+.provider-hub-panel > .provider-heading { padding-bottom: 22px; border-bottom: var(--ring-hairline) solid var(--ring); }
+.provider-hub-panel .provider-hub-content { grid-template-columns: minmax(220px, 1fr) minmax(0, 2fr); padding-top: 22px; }
+.provider-hub-content h3, .provider-hub-content h4 { margin-top: 0; }
+.provider-hub-panel .provider-list { margin-top: 12px; }
+.provider-hub-panel .provider-card { padding: 16px; background: var(--panel-2); border-radius: var(--r-card, 18px); }
+.provider-hub-panel .provider-card > strong { font-size: 15px; }
+.provider-card-test { flex-basis: 100%; display: flex; flex-wrap: wrap; gap: 8px; }
+.provider-card-test label, .provider-card-test p { width: 100%; }
+.provider-card-test label { display: grid; gap: 6px; }
+.provider-status-ok { color: var(--ok); }
+.settings-secondary-panel { padding-top: 22px; border-top: var(--ring-hairline) solid var(--ring); }
+.model-chips { display: grid; gap: 12px; width: 100%; }
+.model-chips-search { display: flex; align-items: center; gap: 8px; padding-inline: 12px; border: var(--ring-hairline) solid var(--ring-2); border-radius: var(--r-pill, 9999px); background: var(--panel-2); }
+.model-chips-search .input { flex: 1; min-width: 0; border: 0; background: transparent; box-shadow: none; }
+.model-chips-search:focus-within { outline: 2px solid var(--accent); outline-offset: 2px; }
+.model-chips-search > svg { flex-shrink: 0; color: var(--text-2); }
+.model-chips-toolbar, .model-chips-filters, .model-chips-actions { display: flex; flex-wrap: wrap; align-items: center; gap: 8px; }
+.model-chips-toolbar { padding-block: 8px; border-bottom: var(--ring-hairline) solid var(--ring); }
+.model-chips-toolbar .btn, .model-chips-toolbar .preset-gallery-tab { padding: 6px 10px; font-size: 12px; }
+.model-chips-count { margin-inline-start: auto; padding: 5px 10px; border-radius: var(--r-pill, 9999px); color: var(--text-2); background: var(--panel-2); font-size: 12px; font-variant-numeric: tabular-nums; white-space: nowrap; }
+.model-chips-scroll { display: flex; flex-wrap: wrap; align-content: flex-start; gap: 8px; max-height: 240px; overflow-y: auto; overscroll-behavior: contain; scrollbar-gutter: stable; padding: 12px 3px; mask-image: linear-gradient(to bottom, transparent, black 10px, black calc(100% - 10px), transparent); }
+.model-chips :is(button, input):disabled { cursor: not-allowed; opacity: .55; }
+.model-chips :is(button, .model-chips-scroll):focus-visible { outline: 2px solid var(--accent); outline-offset: -2px; }
+.model-chips-toolbar button:not(:disabled):hover { background: var(--accent-soft); }
+@media (max-width: 1100px) { .provider-hub-panel .provider-hub-content { grid-template-columns: minmax(0, 1fr); } }
+@media (max-width: 800px) { .provider-hub-content { gap: 22px; } .model-chips-count { margin-inline-start: 0; } }
+@media (prefers-reduced-motion: reduce) { .model-chips *, .provider-hub * { scroll-behavior: auto; transition: none; } }
 .model-switcher { position: relative; min-width: 0; max-width: 100%; }
 .model-switcher-trigger { display: flex; align-items: center; gap: 8px; max-width: 100%; padding: 8px 12px; border: var(--ring-hairline) solid var(--ring); border-radius: var(--r-pill, 9999px); background: var(--panel-2); color: var(--text); cursor: pointer; }
 .model-switcher-trigger > span:nth-child(2) { overflow: hidden; white-space: nowrap; text-overflow: ellipsis; }
