diff --git a/apps/web/src/styles.css b/apps/web/src/styles.css
index c815c32baee24ce5e8b8c2ce71d1f08d2f113444..2890b1ed363aef1bb358d9615cbdebc05196d0d9
--- a/apps/web/src/styles.css
