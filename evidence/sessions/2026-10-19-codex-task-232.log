+    expect(render('lark').find(node => node.props.id === 'provider-name')!.props.value).toBe('lark');
+    expect(render('lark').find(node => node.props.id === 'provider-models')!.props.value).toBe('doubao-1-5-pro-32k-250115');
+  });
+});
