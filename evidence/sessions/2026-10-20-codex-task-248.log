/* Vessel Local Web UI — per docs/UI-THEME.md:
   light is :root default; dark follows prefers-color-scheme. All colors via vars. */

/* Color tokens live in the `.tokens` layer (index.html sets that class on <html>),
   so the app and the pre-hydration skeleton share one source of truth. */
.tokens {
  /* 玻璃令牌（浅色默认），值取自 docs/DESIGN.md §2.1 与原型 :root */
  --bg: #f6f8fa;
  --panel: #ffffff;
  --panel-2: #f6f8fa;
  --panel-3: #eaeef2;
  --ring: #d1d9e0;
  --ring-2: #b7c0ca;
  --text: #1f2328;
  --text-2: #59636e;
  --text-3: #656d76;
  --accent: #5b6cff;
  --accent-fg: #ffffff;
  --accent-soft: rgba(91, 108, 255, 0.1);
  --ok: #0f7a55;
  --warn: #8a6100;
  --danger: #b4292e;
  --ok-soft: rgba(15, 122, 85, 0.1);
  --warn-soft: rgba(138, 97, 0, 0.11);
  --danger-soft: rgba(180, 41, 46, 0.09);
  /* 结构 / 质感 */
  --glass: var(--panel);
  --hl: none;
  --shadow-1: none;
  --shadow-2: none;
  --shadow-3: 0 8px 24px #0003;
  --glow-a: rgba(122, 132, 255, 0.5);
  --glow-b: rgba(94, 220, 196, 0.42);
  --glow-c: rgba(255, 178, 150, 0.36);
  /* 尺度 */
  --r-0: 4px;
  --r-sm: 6px;
  --r-md: 6px;
  --r-panel: 6px;
  --r-composer: 6px;
  --ring-hairline: 1px;
  --focus-ring: 0 0 0 1px var(--panel), 0 0 0 2.5px var(--accent), 0 0 8px 1px var(--accent-soft);
  --r-1: 6px;
  --r-2: 6px;
  --r-3: 6px;
  --r-4: 6px;
  --r-pill: 4px;
  --ease: cubic-bezier(0.32, 0.72, 0, 1);
  --dur-fast: 60ms;
  --dur-snap: 120ms;
  --dur-base: 200ms;
  --dur-sheet: 300ms;
  --dur-slow: 450ms;
  --ease-swift: cubic-bezier(0.16, 1, 0.3, 1);
  --ease-enter: cubic-bezier(0.22, 1, 0.36, 1);
  /* 时间轴泳道语义色（DESIGN.md §4.3） */
  --think: #7c5ce0;
  --tools: #0e8a9b;
  --approve: #c08a00;
  --policy: #b24a5e;

  /* 旧变量名保留为别名：既有组件 CSS 零改动仍可用（IMPLEMENTATION-PLAN §3） */
  --border: var(--ring);
  --dim: var(--text-3);
  --text-soft: var(--text-2);
  --hover: var(--panel-2);
  --row-line: var(--ring);
  --green: var(--ok);
  --red: var(--danger);
  --yellow: var(--warn);
  --bubble-assistant: var(--panel);
  --bubble-user: var(--accent-soft);
}

@media (min-resolution: 2dppx), (-webkit-min-device-pixel-ratio: 2) {
