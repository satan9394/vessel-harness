import React from 'react';

export interface ConversationRendererProps {
  content: string;
  isStreaming?: boolean;
}

interface OpenUiSpec {
  type: 'summary' | 'metrics' | 'actions' | 'diff';
  title?: string;
  status?: 'success' | 'warning' | 'error' | 'info';
  items?: Array<{ label: string; value: string | number; change?: string; tone?: string }>;
  actions?: Array<{ label: string; actionId: string; primary?: boolean }>;
  summary?: string;
}

/**
 * OpenUI 生成式 UI 规范解析（参考 thesysdev/openui Generative UI 思想）
 * 允许模型以极为精简的 DSL 或 JSON 声明渲染高保真原生交互卡片。
 */
function tryParseOpenUi(code: string): OpenUiSpec | null {
  const trimmed = code.trim();
  if (trimmed.startsWith('{') && trimmed.endsWith('}')) {
    try {
      const parsed = JSON.parse(trimmed) as OpenUiSpec;
      if (parsed.type && ['summary', 'metrics', 'actions', 'diff'].includes(parsed.type)) {
        return parsed;
      }
    } catch {
      // not JSON
    }
  }
  // DSL 简写格式解析: type: summary | title: xxx | status: success
  const lines = trimmed.split('\n').map(l => l.trim()).filter(Boolean);
  const spec: Partial<OpenUiSpec> = {};
  for (const line of lines) {
    const colon = line.indexOf(':');
    if (colon > 0) {
      const key = line.slice(0, colon).trim().toLowerCase();
      const val = line.slice(colon + 1).trim();
      if (key === 'type' && ['summary', 'metrics', 'actions', 'diff'].includes(val)) {
        spec.type = val as OpenUiSpec['type'];
      } else if (key === 'title') {
        spec.title = val;
      } else if (key === 'status') {
        spec.status = val as OpenUiSpec['status'];
      } else if (key === 'summary') {
        spec.summary = val;
      }
    }
  }
  return spec.type ? (spec as OpenUiSpec) : null;
}

export function OpenUiCard({ spec }: { spec: OpenUiSpec }) {
  const statusColor = spec.status === 'success' ? 'var(--ok)' : spec.status === 'error' ? 'var(--danger)' : spec.status === 'warning' ? 'var(--warn)' : 'var(--accent)';
  return (
    <div className="openui-card" style={{ borderColor: statusColor }}>
      <div className="openui-card-header">
        <span className="openui-badge" style={{ background: `color-mix(in srgb, ${statusColor} 15%, transparent)`, color: statusColor }}>
          {spec.type.toUpperCase()}
        </span>
        {spec.title && <strong className="openui-title">{spec.title}</strong>}
      </div>
      {spec.summary && <p className="openui-summary">{spec.summary}</p>}
      {spec.items && spec.items.length > 0 && (
        <div className="openui-grid">
          {spec.items.map((item, index) => (
            <div key={index} className="openui-metric-box">
              <span className="openui-metric-label">{item.label}</span>
              <span className="openui-metric-val">{item.value}</span>
              {item.change && <span className="openui-metric-change">{item.change}</span>}
            </div>
          ))}
        </div>
      )}
      {spec.actions && spec.actions.length > 0 && (
        <div className="openui-actions">
          {spec.actions.map((act, index) => (
            <button key={index} className={`btn ${act.primary ? 'btn-primary' : 'btn-secondary'}`} type="button">
              {act.label}
            </button>
          ))}
        </div>
      )}
    </div>
  );
}

function CodeBlock({ code, lang }: { code: string; lang: string }) {
  const openUiSpec = lang.toLowerCase() === 'openui' ? tryParseOpenUi(code) : null;

  if (openUiSpec) {
    return <OpenUiCard spec={openUiSpec} />;
  }

  const handleCopy = (e: React.MouseEvent<HTMLButtonElement>) => {
    void navigator.clipboard?.writeText(code);
    const btn = e.currentTarget;
    const old = btn.textContent;
    btn.textContent = '✓ 已复制';
    setTimeout(() => {
      btn.textContent = old;
    }, 2000);
  };

  return (
    <div className="markdown-code-block">
      <div className="markdown-code-header">
        <span className="markdown-code-lang">{lang || 'text'}</span>
        <button type="button" className="markdown-code-copy btn-sm" onClick={handleCopy}>
          复制
        </button>
      </div>
      <pre className="markdown-pre">
        <code>{code}</code>
      </pre>
    </div>
  );
}

/** 行内 Markdown 简单渲染器（粗体、斜体、行内代码、链接） */
function InlineMarkdown({ text }: { text: string }) {
  // 简易安全解析器：优先切割行内代码 `code`，再处理加粗 **bold**
  const parts: React.ReactNode[] = [];
  const codeRegex = /`([^`]+)`/g;
  let lastIndex = 0;
  let match: RegExpExecArray | null;

  while ((match = codeRegex.exec(text)) !== null) {
#!/usr/bin/env node
// tasteskill / inspect — render the page in a real browser, measure it, and photograph it.
//
//   node inspect.mjs <url | path/to/file.html> [--out DIR] [--widths 1440,768,390] [--allow rule,rule] [--app] [--film] [--json]
//
// --film also photographs the scroll as a visitor sees it (a frame every third of a screen, real wheel
// input) into desktop-film-NN.jpg, so a scroll scene is judged by its in-between states. A direction
// that dealt scroll scenes switches it on by itself.
//
// --app judges an app screen (dashboard, admin, settings) by the rules in references/app-screens.md; a
// direction dealt with draw.mjs --app switches it on by itself.
//
// Exit code 0 = no FAIL findings. Exit code 1 = at least one FAIL (the page is not done).
// Zero dependencies: drives an installed Chrome/Edge/Chromium. Node 22+.
import { existsSync, mkdirSync, readFileSync, writeFileSync, statSync, createReadStream, readdirSync, unlinkSync } from 'node:fs';
import { resolve, join, relative, dirname, extname, sep } from 'node:path';
import { createServer } from 'node:http';
import { Browser, sleep } from './lib/cdp.mjs';
import { probe, frame, layout, app, colourShare } from './lib/probe.mjs';
import { judge, judgeLayout, judgeApp, APP_SKIP } from './lib/rules.mjs';

const args = process.argv.slice(2);
const flag = (name, def) => { const i = args.indexOf('--' + name); if (i === -1) return def; const v = args[i + 1]; args.splice(i, 2); return v; };
const has = (name) => { const i = args.indexOf('--' + name); if (i === -1) return false; args.splice(i, 1); return true; };
const outDir = resolve(flag('out', '.taste-skill/inspect'));
const widths = flag('widths', '1440,768,390').split(',').map(Number).filter(Boolean);
let allow = flag('allow', '').split(',').filter(Boolean);
const asJson = has('json');
let appMode = has('app');
let film = has('film');
let dealtFonts = []; // the faces the saved sheet dealt, to catch a build that quietly fell back to a default
const target = args[0];
if (!target || target === '-h' || target.startsWith('--')) {
  console.error('usage: node inspect.mjs <url | file.html> [--out DIR] [--widths 1440,768,390] [--allow rule,rule] [--app] [--film] [--json]');
  process.exit(2);
}
// Allowances granted by the drawn direction (written by draw.mjs) apply automatically.
for (const p of ['.taste-skill/direction.json', join(outDir, '..', 'direction.json')]) {
  if (existsSync(p)) { try { const d = JSON.parse(readFileSync(p, 'utf8')); allow = [...new Set([...allow, ...(d.allow || [])])]; if (d.kind === 'app') appMode = true; if (Array.isArray(d.scenes) && d.scenes.length) film = true; dealtFonts = (d.input?.keep || []).includes('type') ? [] : d.kind === 'app' ? [d.style?.tokens?.font?.family].filter(Boolean) : [d.type?.display?.family, d.type?.text?.family].filter(Boolean); } catch {} break; }
}



