  .preferences-content { width: min(280px, 88vw); }
}

.workbench-region { min-height: 0; flex: 1; display: flex; flex-direction: column; }
.workbench-region[hidden] { display: none; }

.command-group-toggle { background: var(--panel-2); border: 1px solid var(--ring); border-radius: var(--r-0); color: var(--text); font: inherit; font-weight: 600; text-align: left; padding: 10px; width: 100%; cursor: pointer; }

.session-navigation { display: flex; flex-direction: column; flex: 1; min-height: 0; }
.session-navigation[inert] { opacity: .65; }
.navigation-close { display: none; }
@media (max-width: 1180px) { .navigation-close { display: block; margin: 12px 12px 0; } }

/* Read-only behavior inspection: keep long source refs and snapshots bounded.
   P6: the bordered card wall is flattened into sections + borderless lists. */
.agent-studio-inspector { min-width: 0; padding: 16px; border: 1px solid var(--ring); border-radius: var(--r-2); margin-bottom: 20px; }
.behavior-inspection, .behavior-entry, .behavior-layers > li { min-width: 0; overflow-wrap: anywhere; }
.behavior-layers { display: grid; grid-template-columns: repeat(5, minmax(0, 1fr)); gap: 12px; padding: 0; list-style: none; }
.behavior-layers > li { border-top: 1px solid var(--ring); padding: 10px 0; }
.behavior-entry { border: 0; border-top: 1px solid var(--ring); border-radius: 0; padding: 10px 0; }
.behavior-layers p { margin: 8px 0; }
.behavior-inspection pre { max-height: 280px; overflow: auto; white-space: pre-wrap; overflow-wrap: anywhere; }
.behavior-inspection summary { cursor: pointer; }
.behavior-entries { display: grid; gap: 8px; }
.task-tree-list,
.activity-queue-list,
.composer-staged-list,
.composer-library-list,
.trace-turns {
  list-style: none;
  margin: 0;
  padding: 0;
  display: flex;
  flex-direction: column;
  gap: 0.4rem;
}

.task-tree-node,
.activity-run,
.composer-rule,
.trace-step {
  border: 1px solid var(--ring);
  border-radius: var(--r-1);
  padding: 0.5rem 0.6rem;
  display: flex;
  flex-wrap: wrap;
  gap: 0.35rem 0.8rem;
  align-items: center;
}

.task-tree-node[data-status='failed'],
.activity-run[data-status='failed'] { border-color: var(--danger); }
.task-tree-node[data-status='cancelled'] { border-color: var(--ring-2); opacity: 0.85; }
.task-tree-node[data-status='waiting_approval'],
.activity-run[data-status='needs_attention'] { border-color: var(--warn); }
.activity-run[data-status='failed'] { border-color: var(--danger); }
.activity-run[data-status='unknown'] { border-color: var(--ring-2); }

.status-badge {
  font-size: 0.75rem;
  padding: 0.1rem 0.45rem;
  border-radius: var(--r-pill);
  background: var(--panel-2);
  white-space: nowrap;
}
.status-badge.status-needs_attention { color: var(--warn); background: var(--warn-soft); }
.status-badge.status-failed { color: var(--danger); background: var(--danger-soft); }
.status-badge.status-unknown { color: var(--dim); background: var(--panel-3); }

.card222-detail {
  margin-top: 0.6rem;
  padding: 0.6rem;
  border: 1px solid var(--ring);
  border-radius: var(--r-1);
}

.composer-grid {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 1rem;
}

.composer-rule-actions { display: flex; gap: 0.3rem; flex-wrap: wrap; }

/* P6: empty/loading states are quiet, readable placeholders — never a bare label. */
.composer-empty { border: 1px dashed var(--ring-2); border-radius: var(--r-1); padding: 0.7rem 0.8rem; margin: 0; }
.composer-advisory-banner { margin-bottom: 0.8rem; padding: 0.4rem 0.6rem; border-left: 3px solid var(--accent); background: var(--panel-2); font-size: 0.8rem; border-radius: 0 var(--r-1) var(--r-1) 0; }
.composer-active-state { display: flex; align-items: center; gap: 0.5rem; margin: 0.4rem 0; font-size: 0.85rem; }
.status-badge.status-draft { background: var(--accent-soft); color: var(--accent); font-weight: 600; }

.trace-detail {
  max-width: 100%;
  overflow-x: auto;
  white-space: pre-wrap;
  word-break: break-word;
  font-size: 0.78rem;
}

@media (max-width: 800px) {
  .composer-grid { grid-template-columns: 1fr; }
  .task-tree-node,
  .activity-run,
  .composer-rule { flex-direction: column; align-items: flex-start; }
}



