// Zero-dependency Chrome DevTools Protocol client.
// Drives an installed Chrome / Edge / Chromium in headless mode over Node's built-in WebSocket.
// Requires Node 22+. No npm install.
import { spawn, spawnSync } from 'node:child_process';
import { existsSync, mkdtempSync, rmSync, writeFileSync, readdirSync, statSync, openSync, closeSync } from 'node:fs';
import { tmpdir } from 'node:os';
import { join } from 'node:path';

const sleep = (ms) => new Promise((r) => setTimeout(r, ms));

export function findChrome() {
  const env = process.env.CHROME_PATH || process.env.PUPPETEER_EXECUTABLE_PATH;
  if (env && existsSync(env)) return env;
  const home = process.env.HOME || process.env.USERPROFILE || '';
  const local = process.env.LOCALAPPDATA || '';
  const pf = process.env.PROGRAMFILES || 'C:\\Program Files';
  const pf86 = process.env['PROGRAMFILES(X86)'] || 'C:\\Program Files (x86)';
  const candidates = [
    // Windows
    join(pf, 'Google/Chrome/Application/chrome.exe'),
    join(pf86, 'Google/Chrome/Application/chrome.exe'),
    join(local, 'Google/Chrome/Application/chrome.exe'),
    join(pf86, 'Microsoft/Edge/Application/msedge.exe'),
    join(pf, 'Microsoft/Edge/Application/msedge.exe'),
    join(pf, 'BraveSoftware/Brave-Browser/Application/brave.exe'),
    // macOS
    '/Applications/Google Chrome.app/Contents/MacOS/Google Chrome',
    '/Applications/Chromium.app/Contents/MacOS/Chromium',
    '/Applications/Microsoft Edge.app/Contents/MacOS/Microsoft Edge',
    '/Applications/Brave Browser.app/Contents/MacOS/Brave Browser',
    join(home, 'Applications/Google Chrome.app/Contents/MacOS/Google Chrome'),
    // Linux
    '/usr/bin/google-chrome', '/usr/bin/google-chrome-stable', '/usr/bin/chromium',
    '/usr/bin/chromium-browser', '/snap/bin/chromium', '/usr/bin/microsoft-edge',
  ];
  for (const c of candidates) if (c && existsSync(c)) return c;
  return null;
}

// Profiles from runs that were killed before close(): removed once no Chrome holds them (a running
// Chrome keeps the profile's lockfile open) and they are a few minutes old.
function sweepProfiles(base) {
  try {
    const cutoff = Date.now() - 3 * 60 * 1000;
    for (const name of readdirSync(base)) {
      if (!name.startsWith('ad-chrome-')) continue;
      const p = join(base, name);
      try {
        if (statSync(p).mtimeMs > cutoff) continue;
        const lock = join(p, 'lockfile');
        if (existsSync(lock)) closeSync(openSync(lock, 'r+')); // throws while a Chrome holds it
        rmSync(p, { recursive: true, force: true });
      } catch {}
    }
  } catch {}
}

export class Browser {
  static async launch({ width = 1440, height = 900, extraArgs = [] } = {}) {
    if (typeof WebSocket === 'undefined') {
      throw new Error('Node 22+ is required (built-in WebSocket missing). Current: ' + process.version);
    }
    const exe = findChrome();
    if (!exe) {
      throw new Error('No Chrome/Edge/Chromium found. Install one or set CHROME_PATH to its executable.');
    }
    // A throwaway profile per run. Its cache is capped (each run starts cold anyway), profiles left by
    // runs that were killed are swept once they are a few hours old, and the profile goes on exit.
    const base = process.env.TASTE_SKILL_TMP || tmpdir();
    sweepProfiles(base);
    const dir = mkdtempSync(join(base, 'ad-chrome-'));
    // On exit Chrome still holds the profile's files: stop it first, then remove the folder.
    let pid = 0;
    const drop = () => {
      try { if (pid) { if (process.platform === 'win32') spawnSync('taskkill', ['/pid', String(pid), '/T', '/F'], { stdio: 'ignore' }); else process.kill(pid, 'SIGKILL'); } } catch {}
      try { rmSync(dir, { recursive: true, force: true, maxRetries: 5, retryDelay: 100 }); } catch {}
    };
    process.once('exit', drop);
    for (const sig of ['SIGINT', 'SIGTERM', 'SIGHUP']) process.once(sig, () => { drop(); process.exit(130); });
    const args = [
      '--headless=new', '--remote-debugging-port=0', `--user-data-dir=${dir}`,
      '--disk-cache-size=16777216', '--media-cache-size=16777216',
      '--no-first-run', '--no-default-browser-check', '--mute-audio', '--hide-scrollbars',
      '--disable-background-timer-throttling', '--disable-renderer-backgrounding',
      '--disable-backgrounding-occluded-windows', '--disable-features=Translate,MediaRouter',
      '--force-color-profile=srgb', '--autoplay-policy=no-user-gesture-required',
      '--enable-unsafe-swiftshader', `--window-size=${width},${height}`, ...extraArgs, 'about:blank',
    ];
    const proc = spawn(exe, args, { stdio: ['ignore', 'ignore', 'pipe'] });
    pid = proc.pid;
    const wsUrl = await new Promise((resolve, reject) => {
      let buf = '';
      const t = setTimeout(() => reject(new Error('Chrome did not start within 20s')), 20000);
      proc.stderr.on('data', (d) => {
        buf += d.toString();
        const m = buf.match(/DevTools listening on (ws:\/\/[^\s]+)/);
        if (m) { clearTimeout(t); resolve(m[1]); }
      });
      proc.on('exit', (code) => { clearTimeout(t); reject(new Error('Chrome exited early, code ' + code + '\n' + buf.slice(-600))); });
    });
    if (tableRows.length > 0) {
      const headers = tableRows[0];
      const rows = tableRows.slice(1);
      elements.push(
        <div key={`table-wrapper-${key}`} className="markdown-table-wrapper">
          <table className="markdown-table">
            <thead>
              <tr>
                {headers?.map((cell, i) => (
                  <th key={i}><InlineMarkdown text={cell.trim()} /></th>
                ))}
              </tr>
            </thead>
            <tbody>
              {rows.map((row, rIdx) => (
                <tr key={rIdx}>
                  {row.map((cell, cIdx) => (
                    <td key={cIdx}><InlineMarkdown text={cell.trim()} /></td>
                  ))}
                </tr>
              ))}
            </tbody>
          </table>
        </div>
      );
      tableRows = [];
    }
    inTable = false;
  };

  for (let idx = 0; idx < lines.length; idx++) {
    const line = lines[idx]!;

    // 代码块检测
    if (line.trim().startsWith('```')) {
      if (inTable) flushTable(idx);
      if (!inCodeBlock) {
        inCodeBlock = true;
        currentLang = line.trim().slice(3).trim();
        currentCode = '';
      } else {
        inCodeBlock = false;
        elements.push(<CodeBlock key={`code-${idx}`} code={currentCode} lang={currentLang} />);
        currentCode = '';
        currentLang = '';
      }
      continue;
    }

    if (inCodeBlock) {
      currentCode += (currentCode ? '\n' : '') + line;
      continue;
    }

    // Markdown 表格检测
    if (line.trim().startsWith('|') && line.trim().endsWith('|')) {
      // 忽略对齐行 |---|---|
      if (/^\|[-:\s|]+\|$/.test(line.trim())) {
        continue;
      }
      const cells = line.trim().slice(1, -1).split('|');
      tableRows.push(cells);
      inTable = true;
      continue;
    } else if (inTable) {
      flushTable(idx);
    }

    // 标题检测
    if (line.startsWith('# ')) {
      elements.push(<h2 key={`h1-${idx}`} className="markdown-h1"><InlineMarkdown text={line.slice(2)} /></h2>);
    } else if (line.startsWith('## ')) {
      elements.push(<h3 key={`h2-${idx}`} className="markdown-h2"><InlineMarkdown text={line.slice(3)} /></h3>);
    } else if (line.startsWith('### ')) {
      elements.push(<h4 key={`h3-${idx}`} className="markdown-h3"><InlineMarkdown text={line.slice(4)} /></h4>);
    } else if (line.startsWith('> ')) {
      // 引用块
      elements.push(
        <blockquote key={`quote-${idx}`} className="markdown-blockquote">
          <InlineMarkdown text={line.slice(2)} />
        </blockquote>
      );
    } else if (line.trim().startsWith('- [ ] ') || line.trim().startsWith('- [x] ')) {
      // 任务清单
      const checked = line.trim().startsWith('- [x] ');
      const label = line.trim().slice(6);
      elements.push(
        <div key={`task-${idx}`} className="markdown-task-item">
          <input type="checkbox" checked={checked} readOnly className="markdown-checkbox" />
          <span className={checked ? 'markdown-task-done' : ''}><InlineMarkdown text={label} /></span>
        </div>
      );
    } else if (line.trim().startsWith('- ') || line.trim().startsWith('* ')) {
      // 无序列表
      elements.push(
        <li key={`li-${idx}`} className="markdown-li">
          <InlineMarkdown text={line.trim().slice(2)} />
        </li>
      );
    } else if (/^\d+\.\s/.test(line.trim())) {
      // 有序列表
      const numMatch = line.trim().match(/^(\d+)\.\s(.*)$/);
      elements.push(
        <div key={`ol-${idx}`} className="markdown-ol-item">
          <span className="markdown-ol-num">{numMatch?.[1]}.</span>
          <span><InlineMarkdown text={numMatch?.[2] ?? ''} /></span>
        </div>
      );
    } else if (line.trim().length === 0) {
      // 空行
      elements.push(<div key={`blank-${idx}`} className="markdown-blank" />);
    } else {
      // 普通段落
      elements.push(
        <p key={`p-${idx}`} className="markdown-p">
          <InlineMarkdown text={line} />
        </p>
      );
    }
  }

  if (inCodeBlock && currentCode) {
    elements.push(<CodeBlock key="code-unclosed" code={currentCode} lang={currentLang} />);
  }
  if (inTable) {
    flushTable(lines.length);
  }

  return <div className="conversation-markdown-body">{elements}</div>;
}



