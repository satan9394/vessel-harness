.team-dag-node[aria-pressed="true"] { outline: 3px solid var(--accent); }
.team-dag-node.status-completed { border-color: var(--ok); }
.team-dag-node.status-failed { border-color: var(--danger); }
.team-dag-node.status-running, .team-dag-node.status-ready { border-color: var(--accent); animation: team-pulse 1.5s ease-in-out infinite; }
.team-dag-node.status-claimed { border-color: var(--warn); }
.team-staged-banner { position: sticky; top: 0; z-index: 1; padding: 12px; background: var(--panel-2); border: 1px solid var(--accent); }
.team-node-drawer { border-left: 2px solid var(--accent); padding: 12px; overflow-wrap: anywhere; animation: team-drawer .2s ease-out; }
.team-node-drawer pre { white-space: pre-wrap; }
@keyframes team-pulse { 50% { opacity: .6; } }
@keyframes team-drawer { from { transform: translateX(16px); opacity: 0; } }
@media (prefers-reduced-motion: reduce) { .team-dag-node, .team-node-drawer { animation: none; } }
.team-plan-editor-row { display: flex; flex-wrap: wrap; align-items: center; gap: 8px; padding: 8px 0; }
.team-plan-editor-row label { display: grid; gap: 4px; max-width: 100%; }
.team-plan-editor-row input, .team-plan-editor-row textarea, .team-plan-editor-row select { max-width: 100%; }

/* ponytail: reuse the installed CSS theme; no Tailwind dependency is needed. */
.inline-widget { margin: 12px 0; padding: 14px; border: 1px solid var(--border); border-radius: 6px; background: var(--panel); min-width: 0; }
.widget-head, .widget-actions { display: flex; flex-wrap: wrap; align-items: center; gap: 10px; }
.widget-head .btn { margin-left: auto; }
.inline-widget code, .inline-widget pre { font-family: var(--mono, monospace); }
.inline-widget pre, .widget-hash { overflow-wrap: anywhere; white-space: pre-wrap; }
.inline-widget details { margin-top: 10px; }
.inline-widget summary { cursor: pointer; }
.widget-diff { overflow-x: auto; margin-top: 12px; }
.widget-diff table { border-collapse: collapse; width: 100%; white-space: pre; font-size: 12px; }
.widget-diff td { padding: 2px 8px; }
.widget-diff .diff-number { width: 3em; text-align: right; opacity: .6; user-select: none; }
.diff-add { color: var(--green); background: rgba(45, 160, 99, .12); }
.diff-remove { color: var(--red); background: rgba(210, 65, 65, .12); }
.diff-meta { color: var(--dim); }
.gate-light { width: 10px; height: 10px; border-radius: 50%; background: var(--yellow); }
.gate-green_verified .gate-light { background: var(--green); }
.gate-rejected .gate-light { background: var(--red); }
.widget-danger { color: var(--red); }
.widget-actions .btn:hover:not(:disabled) { transform: translateY(-1px); }

.streaming-reasoning { min-width: 0; }
.reasoning-rate { font-size: .8em; color: var(--dim); }
.reasoning-rules { display: flex; flex-wrap: wrap; gap: .4rem; margin-block: .4rem; }
.reasoning-rule { border: 1px solid var(--border); border-radius: .5rem; padding: .4rem .6rem; max-width: 100%; overflow-wrap: anywhere; }
.reasoning-rule summary { cursor: pointer; }
.reasoning-rule p { white-space: pre-wrap; }
@supports (interpolate-size: allow-keywords) {
  .streaming-reasoning details { interpolate-size: allow-keywords; }
  .streaming-reasoning details::details-content { height: 0; overflow: clip; transition: height 160ms ease, content-visibility 160ms allow-discrete; }
  .streaming-reasoning details[open]::details-content { height: auto; }
}
@media (prefers-reduced-motion: reduce) {
  .streaming-reasoning details::details-content { transition: none; }
  .streaming-reasoning .thinking-dot { animation: none; }
}

/* V2.6 provider settings */
.provider-overlay { z-index: 40; padding: 4vh 12px; background: rgba(0, 0, 0, .6); }
.provider-modal { width: min(620px, 100%); max-height: 92vh; overflow-y: auto; }
.provider-heading { display: flex; align-items: center; justify-content: space-between; gap: 12px; }
.provider-heading h3 { margin: 0; }
.provider-list { display: grid; gap: 10px; margin-top: 18px; }
.provider-card { display: flex; flex-wrap: wrap; align-items: center; gap: 10px; padding: 12px; border: 1px solid var(--border); border-radius: 6px; }
.provider-card code, .provider-card > span:not(.provider-badge) { flex-basis: 100%; overflow-wrap: anywhere; }
.provider-badge { border: 1px solid var(--border); border-radius: 5px; padding: 2px 6px; font-size: 12px; color: var(--dim); }
.provider-fields { border: 0; padding: 0; margin: 0; display: grid; gap: 7px; min-width: 0; }
.provider-fields p { margin: 0 0 5px; font-size: 12px; }
.provider-result { padding: 8px 12px; border: 1px solid currentColor; border-radius: var(--r-1); }
.provider-result.success { color: var(--ok); }
.provider-result.failure { color: var(--danger); }

/* Rail navigation; edge-to-edge shell rules live near the top of this file. */
.primary-nav { display: flex; flex-direction: column; gap: 6px; }
.navigation-shell .sidebar { flex: 1; min-height: 0; border: 0; }
.project-select { background: none; border: 0; color: inherit; padding: 4px; width: 100%; text-align: left; cursor: pointer; }
.main, .topbar, .statusbar { min-width: 0; }
.topbar { flex-wrap: nowrap; }
.statusbar { overflow: hidden; }
.status-text { white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
.topbar-actions { flex-shrink: 0; }
.preferences-menu { position: relative; }
.preferences-menu summary { list-style: none; cursor: pointer; }
.preferences-content { position: absolute; right: 0; top: 100%; z-index: 25; background: var(--panel); border: 1px solid var(--border); padding: 12px; display: grid; gap: 12px; width: 280px; }
.workbench-home { display: flex; flex-direction: column; gap: 20px; width: 100%; max-width: none; height: 100%; flex: 1; margin: 0; overflow-y: auto; }
.home-heading h1 { margin: 0; font-size: clamp(24px, 3vw, 32px); font-weight: 500; letter-spacing: -.02em; text-wrap: balance; }
.workbench-home > p { margin: 0; color: var(--text-2); }
.home-workspace { display: flex; flex-wrap: wrap; align-items: center; justify-content: space-between; gap: 12px; background: var(--panel-2); padding: 16px; border-radius: var(--r-1); }
.home-workspace > div { min-width: 0; flex: 1; }
.workbench-home h2 { font-size: 14px; font-weight: 500; }
.home-workspace p { margin: 0; font-size: 12px; color: var(--text-2); overflow-wrap: anywhere; }
.home-health { color: var(--text-2); font-size: 12px; }
.home-health.is-online { color: var(--ok); }
.starter-prompts { display: flex; flex-wrap: wrap; gap: 8px; }
.starter-pill { border-radius: var(--r-pill); min-height: 40px; }
.home-session-grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(min(100%, 220px), 1fr)); gap: 12px; }
.home-session { display: grid; gap: 6px; text-align: left; padding: 16px; border-radius: var(--r-1); min-width: 0; }
.home-session strong { font-weight: 500; overflow-wrap: anywhere; }
.home-session span, .home-session time, .home-recent > p { font-size: 12px; color: var(--text-2); overflow-wrap: anywhere; }
.home-session time { font-variant-numeric: tabular-nums; }
.task-composer { width: 100%; display: grid; gap: 12px; margin: 0; padding: 0; border: 0; border-radius: 0; background: transparent; }
.workbench-home .task-composer { width: 100%; margin: 0; }
.task-composer h2 { margin: 0 0 12px; }
.composer-surface {
  display: grid; gap: 12px; min-width: 0; padding: 16px; background: var(--panel);
  border-radius: var(--r-composer); border: var(--ring-hairline) solid var(--ring);
  box-shadow: none;
  transition: box-shadow var(--dur-base) var(--ease-swift), border-color var(--dur-base) var(--ease-swift);
}
.composer-surface:hover { border-color: var(--ring-2); box-shadow: none; }
.composer-surface:focus-within { border-color: var(--ring-2); box-shadow: var(--focus-ring); }
.composer-surface .task-input { min-height: 150px; resize: vertical; font: inherit; border: 0; border-radius: var(--r-sm); background: transparent; box-shadow: none; }
.composer-surface .task-input:focus { outline: none; }
.composer-root { margin: 0; overflow-wrap: anywhere; font-size: 12px; }
.composer-options { display: flex; flex-wrap: wrap; gap: 12px; align-items: end; }
.composer-options label { display: grid; gap: 4px; flex: 1; min-width: 0; }
.capsule-select {
  position: relative; display: flex; align-items: center; min-width: 0; border-radius: var(--r-pill);
  border: var(--ring-hairline) solid var(--ring); background: var(--panel-2);
  transition: border-color var(--dur-snap) var(--ease-swift), box-shadow var(--dur-snap) var(--ease-swift);
}
.capsule-select:hover { border-color: var(--ring-2); }
.capsule-select:focus-within { border-color: var(--ring-2); box-shadow: var(--focus-ring); }
.capsule-select select.input {
  appearance: none; width: 100%; min-width: 0; border: 0; border-radius: inherit; padding: 8px 30px 8px 12px;
  background: transparent; color: var(--text); font: inherit; font-size: 12px; text-overflow: ellipsis; cursor: pointer;
}
.capsule-select select:focus { outline: none; box-shadow: none; }
.capsule-select option { background: var(--panel); color: var(--text); }
.capsule-select > svg { position: absolute; right: 10px; width: 14px; height: 14px; color: var(--text-3); pointer-events: none; }
.composer-send { border-radius: var(--r-pill); min-height: 36px; padding: 8px 16px; transition: transform var(--dur-fast) var(--ease-swift), background-color var(--dur-snap) var(--ease-swift); }
.composer-send:active:not(:disabled) { transform: scale(0.98); }
.composer-secondary { display: flex; flex-wrap: wrap; gap: 8px; }
.layout-boundary { font-size: 12px; padding: 0 12px; max-width: 320px; }
.activity-sessions { display: grid; gap: 12px; }
.activity-sessions .btn { display: grid; text-align: left; gap: 4px; }
.activity-sessions span { color: var(--dim); font-size: 12px; }
.command-group summary { font-weight: 600; padding: 10px; color: var(--dim); cursor: pointer; }
.navigation-toggle, .navigation-backdrop { display: none; }
/* ≤1180px: the sidebar collapses into a full-height drawer from left: 0. */
@media (max-width: 1180px) {
  .app { grid-template-columns: minmax(0, 1fr); }
  .navigation-shell { display: none; position: fixed; z-index: 45; top: 0; bottom: 0; left: 0; width: min(300px, 85vw); box-shadow: 4px 0 24px #0004; }
  .navigation-open .navigation-shell { display: flex; }
  .navigation-toggle { display: inline-block; flex-shrink: 0; }
  .navigation-backdrop { display: block; position: fixed; z-index: 44; inset: 0; border: 0; background: #0007; }
  .desktop-sidebar-toggle, .sidebar-collapse { display: none; }
}
@media (max-width: 800px) {
  .topbar { gap: 8px; padding: 8px; }
  .topbar-actions { gap: 4px; }
  .topbar-actions .btn { padding: 5px 7px; font-size: 12px; }
  .main-body { padding: 16px; }
  .task-composer { margin: 0; padding: 0; }
  .composer-options { align-items: stretch; }
  .composer-options label { flex-basis: 100%; }
  .composer-options > button { width: 100%; }
  .modal { width: 100%; max-height: 95dvh; overflow-y: auto; }
  .conversation-head { min-width: 0; flex-wrap: wrap; }
  .preferences-content { width: min(280px, 88vw); }
}

.workbench-region { min-height: 0; flex: 1; display: flex; flex-direction: column; }
.workbench-region[hidden] { display: none; }

.command-group-toggle { background: none; border: 0; color: var(--dim); font: inherit; font-weight: 600; text-align: left; padding: 10px; width: 100%; cursor: pointer; }

.session-navigation { display: flex; flex-direction: column; flex: 1; min-height: 0; }
.session-navigation[inert] { opacity: .65; }
.navigation-close { display: none; }
@media (max-width: 1180px) { .navigation-close { display: block; margin: 12px 12px 0; } }

/* Read-only behavior inspection: keep long source refs and snapshots bounded.
   P6: the bordered card wall is flattened into sections + borderless lists. */
.agent-studio-inspector { min-width: 0; padding: 16px; border: 1px solid var(--ring); border-radius: var(--r-2); margin-bottom: 20px; }
.behavior-inspection, .behavior-entry, .behavior-layers > li { min-width: 0; overflow-wrap: anywhere; }
.behavior-layers { display: grid; grid-template-columns: repeat(5, minmax(0, 1fr)); gap: 12px; padding: 0; list-style: none; }
.behavior-layers > li { border-top: 1px solid var(--ring); padding: 10px 0; }
.behavior-entry { border: 0; border-top: 1px solid var(--ring); border-radius: 0; padding: 10px 0; }
.behavior-layers p { margin: 8px 0; }
.behavior-inspection pre { max-height: 280px; overflow: auto; white-space: pre-wrap; overflow-wrap: anywhere; }
.behavior-inspection summary { cursor: pointer; }
.behavior-entries { display: grid; gap: 8px; }
.behavior-entry dl { display: grid; grid-template-columns: max-content minmax(0, 1fr); gap: 6px 16px; }
.behavior-entry dd { margin: 0; }
.behavior-ladder { display: flex; flex-wrap: wrap; gap: 8px; padding: 0; list-style: none; }
.behavior-ladder li { padding: 4px 8px; border: 1px dashed var(--ring-2); border-radius: var(--r-1); opacity: .55; }
.behavior-ladder li[data-reached="true"] { opacity: 1; border-style: solid; border-color: var(--accent); }
.behavior-ladder li[aria-current="step"] { font-weight: 700; }
@media (max-width: 800px) { .behavior-layers { grid-template-columns: 1fr; } .agent-studio-inspector { padding: 12px; } }
/* Task 231: Provider hub and shared model picker. */
.provider-modal { width: min(960px, 94vw); }
.preset-gallery { display: grid; gap: 12px; margin-block: 16px; }
.preset-gallery-tabs { display: flex; flex-wrap: wrap; gap: 6px; }
.preset-gallery-tab { border: var(--ring-hairline) solid var(--ring); border-radius: var(--r-pill, 9999px); padding: 6px 12px; background: var(--panel-2); color: var(--text); cursor: pointer; }
.preset-gallery-tab[aria-pressed="true"] { border-color: var(--accent); background: var(--accent-soft); }
.preset-gallery-grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(min(100%, 190px), 1fr)); gap: 10px; max-height: 290px; overflow-y: auto; padding: 3px; }
.preset-card, .onboarding-card { display: flex; flex-direction: column; align-items: flex-start; gap: 8px; min-width: 0; padding: 14px; border: var(--ring-hairline) solid var(--ring); border-radius: var(--r-panel); background: var(--panel-2); color: var(--text); text-align: start; cursor: pointer; transition: border-color 140ms ease, background 140ms ease; }
.preset-card:hover, .onboarding-card:hover, .preset-card[aria-pressed="true"] { border-color: var(--accent); background: var(--accent-soft); }
.preset-card small, .onboarding-card small { color: var(--text-2); line-height: 1.5; }
.preset-card code, .preset-card strong { max-width: 100%; overflow-wrap: anywhere; }
.preset-avatar { display: grid; place-items: center; width: 30px; height: 30px; border: var(--ring-hairline) solid var(--ring); border-radius: 6px; font-weight: 650; }
.model-chips { display: flex; flex-wrap: wrap; align-items: center; gap: 8px; min-width: 0; }
.model-chip { display: inline-flex; align-items: center; max-width: 100%; border: var(--ring-hairline) solid var(--ring); border-radius: var(--r-pill, 9999px); background: var(--panel-2); overflow: hidden; }
.model-chip.is-selected { border-color: var(--accent); background: var(--accent-soft); }
.model-chip.is-default { box-shadow: inset 0 0 0 1px var(--accent); }
.model-chip button { background: transparent; color: inherit; border: 0; padding: 7px 9px; cursor: pointer; }
.model-chip .model-chip-toggle { overflow-wrap: anywhere; min-width: 0; text-align: start; }
.model-chip-input { flex: 1 1 220px; min-width: 0; }

/* Task 232: providers as a first-class settings surface. */
.provider-hub-page { display: flex; flex: 0 0 auto; flex-direction: column; gap: 32px; width: 100%; max-width: none; box-sizing: border-box; }
.provider-hub, .provider-hub-panel, .provider-hub-content > *, .provider-registry { min-width: 0; }
.provider-hub-content { display: grid; gap: 24px; }
.provider-hub-panel > .provider-heading { padding-bottom: 22px; border-bottom: var(--ring-hairline) solid var(--ring); }
.provider-hub-panel .provider-hub-content { grid-template-columns: minmax(220px, 1fr) minmax(0, 2fr); padding-top: 22px; }
.provider-hub-content h3, .provider-hub-content h4 { margin-top: 0; }
.provider-hub-panel .provider-list { margin-top: 12px; }
.provider-hub-panel .provider-card { padding: 16px; background: var(--panel-2); border-radius: var(--r-panel); }
.provider-hub-panel .provider-card > strong { font-size: 15px; }
.provider-card-actions { display: flex; flex-wrap: wrap; align-items: center; gap: 8px; width: 100%; margin-top: 8px; padding-top: 8px; border-top: var(--ring-hairline) solid var(--ring); }
.provider-card-test { flex-basis: 100%; display: flex; flex-wrap: wrap; gap: 8px; }
.provider-card-test label, .provider-card-test p { width: 100%; }
.provider-card-test label { display: grid; gap: 6px; }
.provider-status-ok { color: var(--ok); }
.settings-secondary-panel { padding-top: 22px; border-top: var(--ring-hairline) solid var(--ring); }
.model-chips { display: grid; gap: 12px; width: 100%; }
.model-chips-search { display: flex; align-items: center; gap: 8px; padding-inline: 12px; border: var(--ring-hairline) solid var(--ring-2); border-radius: var(--r-pill, 9999px); background: var(--panel-2); }
.model-chips-search .input { flex: 1; min-width: 0; border: 0; background: transparent; box-shadow: none; }
.model-chips-search:focus-within { outline: 2px solid var(--accent); outline-offset: 2px; }
.model-chips-search > svg { flex-shrink: 0; color: var(--text-2); }
.model-chips-toolbar, .model-chips-filters, .model-chips-actions { display: flex; flex-wrap: wrap; align-items: center; gap: 8px; }
.model-chips-toolbar { padding-block: 8px; border-bottom: var(--ring-hairline) solid var(--ring); }
.model-chips-toolbar .btn, .model-chips-toolbar .preset-gallery-tab { padding: 6px 10px; font-size: 12px; }
.model-chips-count { margin-inline-start: auto; padding: 5px 10px; border-radius: var(--r-pill, 9999px); color: var(--text-2); background: var(--panel-2); font-size: 12px; font-variant-numeric: tabular-nums; white-space: nowrap; }
.model-chips-scroll { display: flex; flex-wrap: wrap; align-content: flex-start; gap: 8px; max-height: 240px; overflow-y: auto; overscroll-behavior: contain; scrollbar-gutter: stable; padding: 12px 3px; mask-image: linear-gradient(to bottom, transparent, black 10px, black calc(100% - 10px), transparent); }
.model-chips :is(button, input):disabled { cursor: not-allowed; opacity: .55; }
.model-chips :is(button, .model-chips-scroll):focus-visible { outline: 2px solid var(--accent); outline-offset: -2px; }
.model-chips-toolbar button:not(:disabled):hover { background: var(--accent-soft); }
@media (max-width: 1100px) { .provider-hub-panel .provider-hub-content { grid-template-columns: minmax(0, 1fr); } }
@media (max-width: 800px) { .provider-hub-content { gap: 22px; } .model-chips-count { margin-inline-start: 0; } }

/* ---------- Task 234: Markdown Rich Formatting & OpenUI Generative Cards ---------- */
.conversation-markdown-body {
  display: flex;
  flex-direction: column;
  gap: 8px;
  line-height: 1.6;
  font-size: 13.5px;
  color: var(--text);
  word-break: break-word;
}
.markdown-p { margin: 0; }
.markdown-blank { height: 6px; }
.markdown-h1 {
  font-size: 18px; font-weight: 700; margin: 12px 0 4px; color: var(--text);
  border-bottom: 1px solid var(--ring); padding-bottom: 4px;
}
.markdown-h2 { font-size: 15px; font-weight: 650; margin: 10px 0 4px; color: var(--text); }
.markdown-h3 { font-size: 13.5px; font-weight: 600; margin: 8px 0 2px; color: var(--text); }
.markdown-blockquote {
  margin: 4px 0; padding: 6px 12px; border-left: 3px solid var(--accent);
  background: var(--panel-2); border-radius: 0 var(--r-sm) var(--r-sm) 0;
  color: var(--text-2); font-style: normal;
}
.markdown-inline-code {
  padding: 2px 6px; background: var(--panel-2); border: 1px solid var(--ring);
  border-radius: var(--r-sm); font-family: ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, monospace;
  font-size: 12px; color: var(--accent);
}
.markdown-code-block {
  margin: 8px 0; border: 1px solid var(--ring); border-radius: var(--r-md);
  background: var(--panel-2); overflow: hidden; box-shadow: var(--shadow-1);
}
.markdown-code-header {
  display: flex; align-items: center; justify-content: space-between;
  padding: 4px 10px; background: var(--panel-3); border-bottom: 1px solid var(--ring); font-size: 11px;
}
.markdown-code-lang {
  color: var(--text-3); font-family: ui-monospace, monospace; text-transform: uppercase; font-weight: 600;
}
.markdown-code-copy {
  border: 1px solid var(--ring); background: var(--panel-2); color: var(--text-2);
  cursor: pointer; padding: 2px 8px; font-size: 11px; border-radius: var(--r-sm);
}
.markdown-code-copy:hover {
  background: var(--accent-soft); color: var(--accent); border-color: var(--ring-2);
}
.markdown-pre {
  margin: 0; padding: 10px 14px; overflow-x: auto;
  font-family: ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, monospace;
  font-size: 12.5px; line-height: 1.5; color: var(--text);
}
.markdown-li { margin-left: 18px; color: var(--text); }
.markdown-ol-item { display: flex; align-items: baseline; gap: 6px; margin-left: 6px; }
.markdown-ol-num { font-weight: 600; color: var(--accent); min-width: 16px; }
.markdown-task-item { display: flex; align-items: center; gap: 8px; font-size: 13px; }
.markdown-checkbox { accent-color: var(--accent); }
.markdown-task-done { text-decoration: line-through; color: var(--text-3); }
.markdown-table-wrapper {
  overflow-x: auto; margin: 8px 0; border: 1px solid var(--ring);
  border-radius: var(--r-md); box-shadow: var(--shadow-1);
}
.markdown-table { width: 100%; border-collapse: collapse; font-size: 12.5px; text-align: left; }
.markdown-table th, .markdown-table td { padding: 8px 12px; border-bottom: 1px solid var(--ring); }
.markdown-table th { background: var(--panel-3); font-weight: 600; color: var(--text); }
.markdown-table tr:last-child td { border-bottom: none; }
.markdown-table tr:hover td { background: var(--panel-2); }

/* OpenUI Generative UI Components */
.openui-card {
  margin: 10px 0; padding: 14px 16px; border: 1px solid var(--ring);
  border-left-width: 4px; border-radius: var(--r-md); background: var(--panel-2);
  display: flex; flex-direction: column; gap: 10px; box-shadow: var(--shadow-2);
}
.openui-card-header { display: flex; align-items: center; gap: 10px; }
.openui-badge {
  font-size: 10px; font-weight: 700; padding: 2px 7px;
  border-radius: var(--r-pill); letter-spacing: 0.08em;
}
.openui-title { font-size: 14px; color: var(--text); }
.openui-summary { margin: 0; font-size: 13px; color: var(--text-2); }
.openui-grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(140px, 1fr)); gap: 10px; }
.openui-metric-box {
  padding: 10px 12px; border: 1px solid var(--ring); border-radius: var(--r-sm);
  background: var(--panel); display: flex; flex-direction: column; gap: 3px;
}
.openui-metric-label { font-size: 11px; color: var(--text-3); text-transform: uppercase; }
.openui-metric-val {
  font-size: 17px; font-weight: 700; color: var(--text); font-variant-numeric: tabular-nums;
}
.openui-metric-change { font-size: 10.5px; color: var(--ok); }
.openui-actions { display: flex; flex-wrap: wrap; gap: 8px; margin-top: 4px; }
@media (prefers-reduced-motion: reduce) { .model-chips *, .provider-hub * { scroll-behavior: auto; transition: none; } }
.model-switcher { position: relative; min-width: 0; max-width: 100%; }
.model-switcher-trigger { display: flex; align-items: center; gap: 8px; max-width: 100%; padding: 8px 12px; border: var(--ring-hairline) solid var(--ring); border-radius: var(--r-pill, 9999px); background: var(--panel-2); color: var(--text); cursor: pointer; }
.model-switcher-trigger > span:nth-child(2) { overflow: hidden; white-space: nowrap; text-overflow: ellipsis; }
.model-switcher-dot { flex: 0 0 6px; width: 6px; height: 6px; border-radius: 50%; background: var(--text-2); }
.model-switcher-dot[data-state="online"] { background: var(--ok); }
.model-switcher-panel { position: absolute; inset-block-end: calc(100% + 8px); inset-inline-start: 0; z-index: 80; width: min(380px, calc(100vw - 48px)); padding: 12px; border: var(--ring-hairline) solid var(--ring); border-radius: var(--r-panel); background: var(--panel); box-shadow: 0 12px 36px rgb(0 0 0 / 18%); }
.model-selector .model-switcher-panel { inset-block-end: auto; inset-block-start: calc(100% + 8px); }
.model-switcher .model-switcher-search { width: 100%; }
.model-switcher-list { max-height: 260px; overflow-y: auto; }
.model-switcher-group h4 { margin: 12px 8px 6px; color: var(--text-2); font-size: 11px; }
.model-switcher-item { display: flex; align-items: center; justify-content: space-between; gap: 10px; width: 100%; border: 0; border-radius: 6px; background: transparent; color: var(--text); padding: 9px 8px; text-align: start; cursor: pointer; }
.model-switcher-item > span:first-child { min-width: 0; overflow-wrap: anywhere; }
.model-switcher-item:hover, .model-switcher-item.is-active { background: var(--accent-soft); }
.model-switcher-footer { width: 100%; margin-block-start: 10px; }
.task-composer-onboarding { margin-block: 16px; }
.task-composer-onboarding h3 { margin-block: 0 6px; font-size: 15px; }
.onboarding-grid { display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); gap: 10px; margin-block-start: 12px; }
.preset-card:focus-visible, .preset-gallery-tab:focus-visible, .model-chip button:focus-visible, .model-switcher-trigger:focus-visible, .model-switcher-item:focus-visible, .onboarding-card:focus-visible { outline: 2px solid var(--accent); outline-offset: 2px; }
.model-chip button:disabled, .preset-card:disabled, .model-switcher-trigger:disabled, .onboarding-card:disabled { opacity: .5; cursor: default; }
@media (max-width: 800px) { .onboarding-grid { grid-template-columns: repeat(2, minmax(0, 1fr)); } }
@media (prefers-reduced-motion: reduce) { .preset-card, .onboarding-card { transition: none; } }
