 @media (prefers-reduced-motion: reduce) { .preset-card, .onboarding-card { transition: none; } }
+
+@media (pointer: coarse) {
+  :is(.btn, .topic-action, .markdown-code-copy, .model-switcher-trigger) { min-height: 44px; }
+  :is(.topic-action, .rail-item) { min-width: 44px; min-height: 44px; }
+}
