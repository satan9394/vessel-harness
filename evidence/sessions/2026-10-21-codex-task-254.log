import { useEffect, useState } from 'react';
import { useI18n } from '../LanguageProvider';
import type { ApiClient } from '../../api';
import { activityStatusLabelKey, groupActivity, type ActivityResponse, type ActivityRunView } from '../../workbench';
import { formatStamp, shortPathLabel } from '../../utils/timeFormat';
import '../card222.css';

export interface ActivityQueueProps {
  api?: Pick<ApiClient, 'activityRuns' | 'respondWidget'>;
  onOpenSession?: (sessionId: string) => void;
  /** server-side render / test fixture: preloaded queue, no fetch. */
  initial?: ActivityResponse;
}

const KIND_KEYS = { session: 'activityKindSession', team: 'activityKindTeam', subagent: 'activityKindSubagent', goal: 'activityKindGoal' } as const;

/**
 * UI-013 — cross-project Activity queue. Surfaces every `needs_attention` /
 * `running` / `failed` run and lets the user decide a pending approval inline.
 * State comes from the backend aggregation; the UI never infers completion.
 */
export default function ActivityQueue({ api, onOpenSession, initial }: ActivityQueueProps) {
  const { t } = useI18n();
  const [data, setData] = useState<ActivityResponse | null>(initial ?? null);
  const [error, setError] = useState<unknown>(null);
  const [busy, setBusy] = useState<string | null>(null);
  const [notice, setNotice] = useState<string | null>(null);
  const [revision, setRevision] = useState(0);

  useEffect(() => {
    if (!api) return;
    let active = true;
    api.activityRuns()
      .then((response) => { if (active) { setData(response); setError(null); } })
      .catch((failure) => { if (active) setError(failure); });
    return () => { active = false; };
  }, [api, revision]);

  const decide = async (run: ActivityRunView, optionId: string) => {
    if (!api || !run.approval) return;
    setBusy(`${run.id}:${optionId}`);
    setNotice(null);
    try {
      await api.respondWidget(run.approval.sessionId, run.approval.widgetId, optionId);
      setNotice(t('activityApprovalDone'));
      setRevision((value) => value + 1);
    } catch (failure) {
      setError(failure);
    } finally {
      setBusy(null);
    }
  };

  const groups = data ? groupActivity(data.runs) : [];

  return (
    <section className="dashboard-panel activity-queue" aria-label={t('activityQueueTitle')}>
      <h3>{t('activityQueueTitle')}</h3>
      <p className="dim">{t('activityQueueHint')}</p>
      <button className="btn" onClick={() => setRevision((value) => value + 1)}>{t('modelRetry')}</button>
      {error ? <p role="alert" className="error-text">{t('activityQueueReadError', { error: String((error as Error)?.message ?? error) })}</p> : null}
      {notice ? <p role="status">{notice}</p> : null}
      {data && data.runs.length === 0 ? <p className="dim">{t('activityQueueEmpty')}</p> : null}

      {groups.map((group) => {
        const isCompleted = group.status === 'completed';
        const content = (
          <ul className="activity-queue-list">
            {group.runs.map((run) => (
              <li key={`${run.kind}:${run.id}`} className="activity-run" data-status={run.status} data-kind={run.kind} data-run-id={run.id}>
                <span className={`status-badge status-${run.status}`}>{t(activityStatusLabelKey(run.status))}</span>
                <span className="status-badge">{t(KIND_KEYS[run.kind])}</span>
                <strong>{run.title}</strong>
                <span className="dim" title={run.projectRoot}>{t('activityProject')}: {shortPathLabel(run.projectRoot)}</span>
                <span className="dim">{t('activityUpdated')}: {formatStamp(run.updatedAt)}</span>
                {run.kind === 'session' && onOpenSession && (
                  <button className="btn" onClick={() => onOpenSession(run.id)}>
                    {t('activityKindSession')}
                  </button>
                )}
                {run.approval && (
                  <>
                    <span className="dim">{t('activityApprovalFor')}: {run.approval.description}</span>
                    {run.approval.options.map((option) => (
                      <button key={option.id} className={`btn ${option.tone === 'danger' ? 'btn-danger' : 'btn-secondary'}`} disabled={busy !== null}
                        onClick={() => void decide(run, option.id)}>
                        {option.tone === 'danger' ? t('activityDeny') : t('activityApprove')} ({option.label})
                      </button>
                    ))}
                  </>
                )}
              </li>
            ))}
          </ul>
        );

        if (isCompleted) {
          return (
            <details key={group.status} className="activity-completed-group" aria-label={t(activityStatusLabelKey(group.status))}>
              <summary><h4>{t(activityStatusLabelKey(group.status))} · {group.runs.length}</h4></summary>
              {content}
            </details>
          );
        }

        return (
          <section key={group.status} aria-label={t(activityStatusLabelKey(group.status))}>
            <h4>{t(activityStatusLabelKey(group.status))} · {group.runs.length}</h4>
            {content}
          </section>
        );
      })}
    </section>
  );
}
export interface ActivityApproval {
  sessionId: string;
  widgetId: string;
  actionType: string;
  description: string;
  requestedAt: string;
  options: ActivityApprovalOption[];
}

export interface ActivitySessionSource {
  id: string;
  workspaceRoot: string;
  createdAt?: string;
  updatedAt?: string;
  topic?: { title?: string; isArchived?: boolean };
  lastRunStatus?: RunOutcomeStatus;
  errorDetail?: string;
  recordCount?: number;
}

export interface ActivityLiveState {
  turnActive: boolean;
  lastRunStatus?: RunOutcomeStatus;
  errorDetail?: string;
  recordCount?: number;
}

export interface ActivitySubagentSource {
  id: string;
  name: string;
  status: 'idle' | 'running' | 'completed' | 'failed' | 'cancelled';
  worktreePath?: string;
  startedAt: string;
  endedAt?: string;
}

export interface ActivityTeamStageSource {
  id: string;
  status: 'staged' | 'approved' | 'rejected' | 'running' | 'finished';
  createdAt: number;
  tasks?: { status: string }[];
}

export interface ActivityGoalSource {
  id: string;
  projectRoot: string;
  goal: string;
  status: 'pending' | 'in-progress' | 'paused' | 'met' | 'not_met' | 'cancelled';
  createdAt?: string;
  updatedAt?: string;
}

export interface ActivitySources {
  sessions: () => Promise<ActivitySessionSource[]>;
  live: (sessionId: string) => ActivityLiveState | undefined;
  /** every pending permission decision across projects. */
  approvals: () => ActivityApproval[];
  subagents: () => Promise<ActivitySubagentSource[]>;
  teamStages: () => ActivityTeamStageSource[];
  goalTasks: () => ActivityGoalSource[];
  /** project root attributed to team/subagent activity when unknown. */
  defaultProjectRoot?: string;
}

const STATUS_ORDER: Record<ActivityStatus, number> = {
  needs_attention: 0,
  failed: 1,
  running: 2,
  unknown: 3,
  completed: 4,
};

function time(value: string | number | undefined): number {
  if (typeof value === 'number') return value;
  if (typeof value === 'string') { const parsed = Date.parse(value); if (Number.isFinite(parsed)) return parsed; }
  return 0;
}

export class ActivityRoutes {
  constructor(private readonly sources: ActivitySources) {}

  async list(): Promise<{ runs: ActivityRun[]; updatedAt: number }> {
    const root = this.sources.defaultProjectRoot ?? '';
    const [sessions, subagents] = await Promise.all([this.sources.sessions(), this.sources.subagents()]);
    const approvals = this.sources.approvals();
    const approvalBySession = new Map<string, ActivityApproval>();
    for (const approval of approvals) if (!approvalBySession.has(approval.sessionId)) approvalBySession.set(approval.sessionId, approval);
    const runs: ActivityRun[] = [];

    for (const session of sessions) {
      if (session.topic?.isArchived) continue;
      const approval = approvalBySession.get(session.id);
      const live = this.sources.live(session.id);

      let status: ActivityStatus;
      let outcome: RunOutcomeStatus;
      let statusSource: 'live' | 'event_log' | 'approval_queue' | 'inferred';

      if (approval) {
        status = 'needs_attention';
        outcome = 'waiting_approval';
        statusSource = 'approval_queue';
      } else if (live?.turnActive) {
        status = 'running';
        outcome = 'running';
        statusSource = 'live';
      } else if (live?.lastRunStatus) {
        outcome = live.lastRunStatus;
        status = outcome === 'failed' || outcome === 'interrupted' || outcome === 'cancelled'
          ? 'failed'
          : outcome === 'completed'
            ? 'completed'
            : 'unknown';
        statusSource = 'live';
      } else if (session.lastRunStatus) {
        outcome = session.lastRunStatus;
        status = outcome === 'failed' || outcome === 'interrupted' || outcome === 'cancelled'
          ? 'failed'
          : outcome === 'completed'
            ? 'completed'
            : 'unknown';
        statusSource = 'event_log';
      } else if (session.recordCount === 0 || live?.recordCount === 0) {
        // 空会话，从未执行任何有效 Turn，归为 unknown / queued，绝不冒充 completed
        status = 'unknown';
        outcome = 'queued';
        statusSource = 'inferred';
      } else {
        // 无法从现有数据确证成功结果，归为 unknown
        status = 'unknown';
        outcome = 'unknown';
        statusSource = 'inferred';
      }

      runs.push({
        id: session.id,
        kind: 'session',
        projectRoot: session.workspaceRoot,
        title: session.topic?.title?.trim() || session.id,
        status,
        outcome,
        statusSource,
        detail: live?.errorDetail ?? session.errorDetail,
        needsApproval: Boolean(approval),
        approval,
        updatedAt: time(session.updatedAt ?? session.createdAt),
        href: `/api/sessions/${session.id}`,
      });
    }

    for (const stage of this.sources.teamStages()) {
      const failed = stage.status === 'finished' && (stage.tasks ?? []).some((task) => task.status === 'failed');
      const status: ActivityStatus = stage.status === 'staged' ? 'needs_attention' : stage.status === 'running' ? 'running' : failed ? 'failed' : 'completed';
      runs.push({ id: stage.id, kind: 'team', projectRoot: root, title: `Team plan ${stage.id}`, status, needsApproval: stage.status === 'staged', updatedAt: stage.createdAt });
    }

    for (const subagent of subagents) {
      const status: ActivityStatus = subagent.status === 'running' ? 'running' : subagent.status === 'failed' || subagent.status === 'cancelled' ? 'failed' : 'completed';
      runs.push({ id: subagent.id, kind: 'subagent', projectRoot: subagent.worktreePath ?? root, title: subagent.name, status, needsApproval: false, updatedAt: time(subagent.endedAt ?? subagent.startedAt) });
    }

    for (const task of this.sources.goalTasks()) {
      const status: ActivityStatus = task.status === 'paused' ? 'needs_attention' : task.status === 'met' ? 'completed' : task.status === 'not_met' || task.status === 'cancelled' ? 'failed' : 'running';
      runs.push({ id: task.id, kind: 'goal', projectRoot: task.projectRoot, title: task.goal, status, needsApproval: false, updatedAt: time(task.updatedAt ?? task.createdAt) });
    }

    runs.sort((a, b) => STATUS_ORDER[a.status] - STATUS_ORDER[b.status] || b.updatedAt - a.updatedAt || a.id.localeCompare(b.id));
    return { runs, updatedAt: Date.now() };
  }
}
