import { useMemo, useState } from 'react';
import type { Project, SessionMeta } from '../api';
import { VesselLogo } from './VesselLogo';
import { useI18n } from './LanguageProvider';
import { projectName, readableSessionTitle } from './TaskComposer';
import { formatClock } from '../utils/timeFormat';

export interface SidebarProps {
  selectedProjectRoot?: string;
  onSelectProject?: (root: string) => void;
  projects: Project[];
  sessions: SessionMeta[];
  onNewSession: () => void;
  /** currently open session id (if any); highlights its row. */
  selectedSessionId?: string | null;
  /** invoked when the user clicks a session row. */
  onSelectSession: (id: string) => void;
  onRenameTopic?: (sessionId: string, title: string) => void;
  onArchiveTopic?: (sessionId: string, archived: boolean) => void;
  onCollapse?: () => void;
}

type TopicPeriodKey = 'topicToday' | 'topicLastSevenDays' | 'topicEarlier';

export interface SidebarTopicGroup {
  topicId: string;
  title: string;
  isArchived: boolean;
  sessions: SessionMeta[];
}

export interface SidebarPeriodGroup {
  key: TopicPeriodKey;
  topics: SidebarTopicGroup[];
}

/** Search by Topic title, workspace path, or stable session id. */
export function filterSessionsByTopic(sessions: SessionMeta[], query: string, showArchived: boolean): SessionMeta[] {
  const needle = query.trim().toLocaleLowerCase();
  return sessions.filter((session) => {
    if (!showArchived && session.topic?.isArchived) return false;
    if (!needle) return true;
    return [session.topic?.title, session.workspaceRoot, session.id].some((value) => value?.toLocaleLowerCase().includes(needle));
  });
}

/** Pure grouping helper, shared by the sidebar and its deterministic tests. */
export function groupSessionsByDateAndTopic(sessions: SessionMeta[], now = Date.now()): SidebarPeriodGroup[] {
  const today = new Date(now);
  today.setHours(0, 0, 0, 0);
  const todayStart = today.getTime();
  const lastWeekStart = todayStart - 7 * 24 * 60 * 60 * 1000;
  const topics = new Map<string, SidebarTopicGroup>();

  const ordered = [...sessions].sort((a, b) => (b.updatedAt ?? b.createdAt).localeCompare(a.updatedAt ?? a.createdAt));
  for (const session of ordered) {
    const topicId = session.topic?.topicId ?? `session:${session.id}`;
    let group = topics.get(topicId);
    if (!group) {
      group = {
        topicId,
        title: session.topic?.title ?? '',
        isArchived: session.topic?.isArchived === true,
        sessions: [],
      };
      topics.set(topicId, group);
    }
    group.isArchived ||= session.topic?.isArchived === true;
    group.sessions.push(session);
  }

  const periods = new Map<TopicPeriodKey, Map<string, SidebarTopicGroup>>([
    ['topicToday', new Map()],
    ['topicLastSevenDays', new Map()],
    ['topicEarlier', new Map()],
  ]);
  // A Topic stays together even when its sessions span multiple date ranges;
  // place the entire group according to its latest activity.
  for (const group of topics.values()) {
    const latest = group.sessions[0];
    const timestamp = latest ? Date.parse(latest.updatedAt ?? latest.createdAt) : Number.NaN;
    const periodKey: TopicPeriodKey = !Number.isFinite(timestamp) || timestamp < lastWeekStart
      ? 'topicEarlier'
      : timestamp < todayStart
        ? 'topicLastSevenDays'
        : 'topicToday';
    periods.get(periodKey)!.set(group.topicId, group);
  }

  return [...periods].map(([key, topics]) => ({ key, topics: [...topics.values()] })).filter((period) => period.topics.length > 0);
}

/** Left rail: projects plus searchable, date-grouped Topic navigation. */
export default function Sidebar({
  projects,
  selectedProjectRoot,
  onSelectProject,
  sessions,
  onNewSession,
  selectedSessionId,
  onSelectSession,
  onRenameTopic,
  onArchiveTopic,
  onCollapse,
}: SidebarProps) {
  const { t } = useI18n();
  const [query, setQuery] = useState('');
  const [showArchived, setShowArchived] = useState(false);
  const [editingTopicId, setEditingTopicId] = useState<string | null>(null);
  const [draftTitle, setDraftTitle] = useState('');
  const periods = useMemo(
    () => [...new Set([...projects.map(project => project.root), ...sessions.map(session => session.workspaceRoot)])].map(root => ({ root, topics: groupSessionsByDateAndTopic(filterSessionsByTopic(sessions.filter(session => session.workspaceRoot === root), query, showArchived)).flatMap(period => period.topics) })),
    [projects, sessions, query, showArchived],
  );

  function beginRename(group: SidebarTopicGroup) {
    setEditingTopicId(group.topicId);
    setDraftTitle(group.title);
  }

  function saveRename(group: SidebarTopicGroup) {
    const title = draftTitle.trim();
    if (title) onRenameTopic?.(group.sessions[0]!.id, title);
    setEditingTopicId(null);
  }

  return (
    <aside className="sidebar">
      <div className="brand">
        <VesselLogo />
        <span className="brand-name">Vessel</span>
        {onCollapse && <button type="button" className="btn sidebar-collapse" aria-label={t('collapseSidebar')} onClick={onCollapse}>‹</button>}
      </div>

      <button type="button" className="btn btn-primary" onClick={onNewSession}>
        {t('newSession')}
      </button>

      <nav className="side-nav">
        <section>
          <div className="side-label">{t('projects')}</div>
          <ul className="side-list">
            {projects.length === 0 ? (
              <li className="side-empty">{t('noProjects')}</li>
            ) : (
              projects.map((project) => (
                <li key={project.root} className="side-item" title={project.root}>
                  <button type="button" className={`project-select${project.root === selectedProjectRoot ? ' side-item-active' : ''}`} onClick={() => onSelectProject?.(project.root)}>{projectName(project.root)}</button>
                </li>
              ))
            )}
          </ul>
        </section>

        <section>
          <div className="side-label">{t('recentSessions')}</div>
          <input
            className="input topic-search"
            aria-label={t('topicSearch')}
            placeholder={t('topicSearch')}
            value={query}
            onChange={(event) => setQuery(event.target.value)}
          />
          <label className="topic-archived-toggle">
            <input type="checkbox" checked={showArchived} onChange={(event) => setShowArchived(event.target.checked)} />
            {t('topicShowArchived')}
          </label>
          {sessions.length === 0 ? (
            <div className="side-empty">{t('noSessions')}</div>
          ) : periods.length === 0 ? (
            <div className="side-empty">{t('noSessions')}</div>
          ) : (
            <div className="topic-period-list">
              {periods.map((period) => (
                <section className="topic-period" key={period.root}>
                  <div className="side-label">{projectName(period.root)}</div>
                  {period.topics.map((group) => (
                    <section className="topic-group" key={group.topicId}>
                      <div className="topic-heading">
                        {editingTopicId === group.topicId ? (
                          <form
                            className="topic-edit"
                            onSubmit={(event) => {
                              event.preventDefault();
                              saveRename(group);
                            }}
                          >
                            <input
                              className="input"
                              aria-label={t('topicRename')}
                              value={draftTitle}
                              onChange={(event) => setDraftTitle(event.target.value)}
                              autoFocus
                            />
                            <button type="submit" className="topic-action" aria-label={t('topicSave')}>{t('topicSave')}</button>
                            <button type="button" className="topic-action" onClick={() => setEditingTopicId(null)}>{t('topicCancel')}</button>
                          </form>
                        ) : (
                          <button
                            type="button"
                            className="topic-title"
                            onClick={() => onSelectSession(group.sessions[0]!.id)}
                            title={group.title}
                          >
                            {readableSessionTitle(group.sessions[0]!, t('sessionNew'))}
                          </button>
                        )}
                      </div>
                      {group.sessions.map((session) => (
                        <button
                          key={session.id}
                          type="button"
                          className={`side-item topic-session${session.id === selectedSessionId ? ' side-item-active' : ''}`}
                          title={session.workspaceRoot}
                          onClick={() => onSelectSession(session.id)}
                        >
                          {group.sessions.length > 1 ? readableSessionTitle(session, t('sessionNew')) : formatClock(session.updatedAt ?? session.createdAt)}
                        </button>
                      ))}
                      {editingTopicId !== group.topicId && (
                        <details className="topic-actions"><summary aria-label={t('preferences')}>···</summary>
                          <button type="button" className="topic-action" onClick={() => beginRename(group)}>
                            {t('topicRename')}
                          </button>
                          <button
                            type="button"
                            className="topic-action"
                            onClick={() => onArchiveTopic?.(group.sessions[0]!.id, !group.isArchived)}
                          >
                            {group.isArchived ? t('topicRestore') : t('topicArchive')}
                          </button>
                        </details>
                      )}
                    </section>
                  ))}
                </section>
              ))}
            </div>
          )}
        </section>
        <p className="dim hierarchy-hint">{t('hierarchyHint')}</p>
      </nav>


    </aside>
  );
}
import { useEffect, useRef, useState } from 'react';
import type { ApiClient, CreateSessionInput, ModelOption, Project, SessionMeta } from '../api';
import { useI18n } from './LanguageProvider';
import { modelKey } from './NewSessionForm';

export function projectName(root: string): string { return root.split(/[\\/]/).filter(Boolean).at(-1) || root; }
export function readableSessionTitle(session: SessionMeta, fallback: string): string {
  const title = session.topic?.title?.trim();
  return title && !/^sess_|^untitled topic$|^未命名主题$/i.test(title) ? title : fallback;
}
/** Create a session only; its first turn goes through the existing conversation stream. */
export async function createTaskSession(api: ApiClient, input: CreateSessionInput, task: string, onBusyChange?: (busy: boolean) => void): Promise<SessionMeta> {
  if (!input.workspaceRoot.trim() || !task.trim()) throw new Error('Project and task are required');
  onBusyChange?.(true);
  try {
  await api.openProject(input.workspaceRoot.trim());
  const { session } = await api.createSession({ ...input, workspaceRoot: input.workspaceRoot.trim() });
  // ponytail: Titles are deterministic task summaries, never a second model call.
  try { await api.updateSessionTopic(session.id, { title: task.trim().replace(/\s+/g, ' ').slice(0, 80) }); } catch { /* Creation remains usable when metadata cannot be saved. */ }
  return session;
  } finally { onBusyChange?.(false); }
}
export default function TaskComposer({ api, projects, selectedRoot, onSelectProject, providerRevision, disabled, onConfigureModels, onAdvanced, onStarted, onBusyChange, draftRequest }: {
  api: ApiClient; projects: Project[]; selectedRoot: string; onSelectProject: (root: string) => void;
  providerRevision: number; disabled: boolean; onConfigureModels: () => void; onAdvanced: () => void;
  onBusyChange?: (busy: boolean) => void;
  draftRequest?: { text: string; serial: number };
  onStarted: (session: SessionMeta, task: string) => void;
}) {
  const { t } = useI18n();
  const [task, setTask] = useState('');
  const taskInput = useRef<HTMLTextAreaElement>(null);
  const isComposingRef = useRef(false);
  useEffect(() => {
    if (!draftRequest) return;
    setTask(draftRequest.text);
    taskInput.current?.focus();
  }, [draftRequest]);
  const [path, setPath] = useState('');
  const [models, setModels] = useState<ModelOption[]>([]);
  const [selection, setSelection] = useState('');
  const [permission, setPermission] = useState<NonNullable<CreateSessionInput['permission']>>('workspace-write');
  const [loading, setLoading] = useState(true);
  const [failed, setFailed] = useState(false);
  const [retry, setRetry] = useState(0);
  const [busy, setBusy] = useState(false);
  const [error, setError] = useState('');
  useEffect(() => {
    let live = true; setLoading(true); setFailed(false);
    void api.listModels().then(({ models: catalog }) => {
      if (!live) return;
      const real = catalog.filter(model => model.providerName !== 'mock'); setModels(real);
      setSelection(previous => previous || (real[0] ? modelKey(real[0]) : ''));
    }).catch(() => { if (live) setFailed(true); }).finally(() => { if (live) setLoading(false); });
    return () => { live = false; };
  }, [api, providerRevision, retry]);
  const root = selectedRoot || path.trim();
  const unavailable = Boolean(selection && !models.some(model => modelKey(model) === selection));
  async function submit(event: React.FormEvent) {
    event.preventDefault(); if (isComposingRef.current || !root || !task.trim() || busy || loading || failed || unavailable || disabled) return;
    setBusy(true); setError('');
    try {
      const model = models.find(item => modelKey(item) === selection);
      const session = await createTaskSession(api, { workspaceRoot: root, permission, ...(model ? { provider: model.providerName, model: model.id } : {}) }, task, onBusyChange);
      onStarted(session, task.trim());
    } catch { setError(t('sessionCreateFailed')); } finally { setBusy(false); }
  }
  return <form className="task-composer" onSubmit={submit}>
    <h2>{t('taskPrompt')}</h2>
    <label htmlFor="taskProject">{t('chooseProject')}</label>
    <select id="taskProject" className="input" value={selectedRoot} disabled={busy} onChange={event => onSelectProject(event.target.value)}>
      <option value="">{t('openProjectPath')}</option>
      {projects.map(project => <option key={project.root} value={project.root}>{projectName(project.root)}</option>)}
    </select>
    {selectedRoot ? <p className="composer-root dim" title={root}>{root}</p> : <input className="input" aria-label={t('workspacePath')} placeholder={t('workspacePlaceholder')} value={path} onChange={event => setPath(event.target.value)} disabled={busy} />}
    <label htmlFor="taskInput">{t('taskPrompt')}</label>
    <textarea ref={taskInput} id="taskInput" className="input task-input" placeholder={t('taskPlaceholder')} value={task} onChange={event => setTask(event.target.value)} disabled={busy}
      onCompositionStart={() => { isComposingRef.current = true; }}
      onCompositionEnd={() => { isComposingRef.current = false; }}
      onKeyDown={event => {
        if (event.key === 'Enter' && !event.shiftKey) {
          if (isComposingRef.current || event.nativeEvent.isComposing || event.keyCode === 229) return;
          event.preventDefault(); void submit(event);
        }
      }} />
    <div className="composer-options">
      <label>{t('selectModel')}<select className="input model-pill" aria-label={t('selectModel')} value={selection} disabled={busy || loading} onChange={event => setSelection(event.target.value)}>
        {unavailable && <option value={selection}>{t('modelUnavailable')}</option>}
        {!models.length && !selection && <option value="">{t('modelOffline')}</option>}
        {models.map(model => <option key={modelKey(model)} value={modelKey(model)}>{model.providerName} / {model.id}</option>)}
      </select></label>
      <label>{t('permissionLabel')}<select className="input" aria-label={t('permissionLabel')} value={permission} disabled={busy} onChange={event => setPermission(event.target.value as typeof permission)}>
        <option value="read-only">{t('permissionReadOnly')}</option><option value="workspace-write">{t('permissionWorkspaceWrite')}</option>
      </select></label>
      <button className="btn btn-primary" type="submit" disabled={busy || disabled || loading || failed || unavailable || !root || !task.trim()}>{busy ? t('creating') : t('startTask')}</button>
    </div>
    {unavailable && !loading && <p role="alert" className="error-text">{t('modelUnavailable')}</p>}
    {loading && <p role="status" className="dim">{t('loading')}</p>}
    {failed && <p role="alert" className="error-text">{t('modelLoadFailed')} <button className="btn" type="button" onClick={() => setRetry(value => value + 1)}>{t('modelRetry')}</button></p>}
    {!loading && !failed && !models.length && <p className="dim">{t('noModelsConfigured')} · {t('modelOffline')}</p>}
    {error && <p role="alert" className="error-text">{error}</p>}
    <div className="composer-secondary"><button className="btn" type="button" data-action="advanced-session" onClick={onAdvanced} disabled={busy}>{t('advancedSession')}</button><button className="btn" type="button" data-action="configure-models" onClick={onConfigureModels} disabled={busy}>{t('configureModels')}</button></div>
  </form>;
}
