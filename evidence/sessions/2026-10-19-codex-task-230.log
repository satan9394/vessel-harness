s=s.slice(0,a)+"'`.side-search { position: relative; display: flex; align-items: center; margin-top: 8px; }
.side-search > svg { position: absolute; left: 9px; width: 13px; height: 13px; color: var(--text-3); pointer-events: none; }
.topic-search {
  width: 100%; min-width: 0; padding: 7px 10px 7px 28px;
  border: var(--ring-hairline) solid var(--ring); border-radius: var(--r-pill);
  background: var(--panel-2); color: var(--text); font: inherit; font-size: 12px;
  transition: border-color var(--dur-snap) var(--ease-swift), box-shadow var(--dur-snap) var(--ease-swift);
}
.topic-search::placeholder { color: var(--text-3); }
.topic-search:hover { border-color: var(--ring-2); }
.topic-search:focus { outline: none; border-color: var(--ring-2); box-shadow: var(--focus-ring); }
.topic-archived-toggle {
  display: inline-flex; align-items: center; gap: 6px; margin: 7px 2px; padding: 4px 8px;
  border-radius: var(--r-pill); color: var(--text-3); font-size: 11px; cursor: pointer;
  transition: background-color var(--dur-snap) var(--ease-swift);
}
.topic-archived-toggle:hover, .topic-archived-toggle:focus-within { background: var(--panel-2); }
.topic-archived-toggle:has(input:checked) { background: var(--accent-soft); color: var(--accent); }
.topic-archived-toggle input { accent-color: var(--accent); margin: 0; }
.topic-period-list { max-height: min(58vh, 680px); overflow-y: auto; }
.topic-period { margin-top: 12px; }
.topic-period-label { padding: 4px 6px; }
.topic-group { margin: 2px 0 4px; padding: 2px 0 4px; }
.topic-heading {
  display: flex; align-items: center; min-width: 0; border-radius: var(--r-sm);
  transition: background-color var(--dur-snap) var(--ease-swift);
}
.topic-heading:hover, .topic-heading:focus-within { background: var(--panel-2); }
.topic-title {
  flex: 1; min-width: 0; border: 0; padding: 4px 6px; border-radius: var(--r-sm);
  background: transparent; color: var(--text); text-align: left; font: inherit; font-size: 13px; font-weight: 650;
  overflow: hidden; text-overflow: ellipsis; white-space: nowrap; cursor: pointer;
}
.topic-title:hover { color: var(--accent); }
.side-item.topic-session {
  position: relative; display: block; width: 100%; border: 0; padding-left: 12px;
  background: transparent; text-align: left; font-size: 11px; cursor: pointer;
  transition: background-color var(--dur-snap) var(--ease-swift), transform var(--dur-fast) var(--ease-swift);
}
.side-item.topic-session:hover { background: var(--panel-2); }
.side-item.topic-session.side-item-active { background: var(--accent-soft); color: var(--accent); }
.side-item.topic-session::before {
  content: '"''; position: absolute; left: 3px; top: 50%; transform: translateY(-50%);
  width: 2px; height: 0; border-radius: var(--r-pill); background: var(--accent);
  transition: height var(--dur-base) var(--ease-swift);
}
.side-item.topic-session.side-item-active::before { height: 14px; }
.topic-actions-inline {
  display: inline-flex; flex: none; gap: 2px; padding-right: 2px; opacity: 0; pointer-events: none;
  transition: opacity var(--dur-snap) var(--ease-swift);
}
.topic-heading:hover .topic-actions-inline, .topic-heading:focus-within .topic-actions-inline { opacity: 1; pointer-events: auto; }
.topic-edit { display: flex; flex: 1; min-width: 0; flex-wrap: wrap; align-items: center; gap: 5px; padding: 3px 6px; }
.topic-action {
  display: inline-flex; align-items: center; justify-content: center; min-width: 24px; min-height: 24px;
  border: 0; border-radius: var(--r-sm); padding: 3px; background: transparent; color: var(--text-3);
  font: inherit; font-size: 10px; cursor: pointer;
  transition: background-color var(--dur-snap) var(--ease-swift), transform var(--dur-fast) var(--ease-swift);
}
.topic-action svg { width: 14px; height: 14px; }
.topic-action:hover { color: var(--accent); background: var(--panel-2); }
.topic-action:focus-visible, .topic-title:focus-visible { outline: none; box-shadow: var(--focus-ring); }
.topic-action:active, .side-item.topic-session:active { transform: scale(0.98); }
.topic-edit .input { flex: 1 1 100%; min-width: 0; padding: 5px 7px; font-size: 12px; }
@media (hover: none) { .topic-actions-inline { opacity: 1; pointer-events: auto; } }
