    console.warn(
      `[vessel] projects.json 损坏（${why}）：已将原索引留档为 "${bak}"（内容保留，未删除）；` +
        `本次改用空索引继续，核对后可从该留档文件手工恢复（原路径 "${this.file}"）。`,
    );
