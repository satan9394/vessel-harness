    name: (name ?? '') as string,
    protocol,
    baseUrl: typeof rawUrl === 'string' ? rawUrl : '',
    apiKey: typeof rawKey === 'string' ? rawKey : '',
    models,
    ...(modelCapabilities ? { modelCapabilities } : {}),
  };
}
export function providerUrl(value: unknown): URL {
