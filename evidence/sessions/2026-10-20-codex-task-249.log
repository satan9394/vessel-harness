  delta?: unknown;
  ts?: number;
}

// ---- Delta shapes (mirror packages/application projections + server SSE) ----

/** conversation delta — a user prompt or an assistant text / tool-call marker. */
export interface ConversationDelta {
  role: 'user' | 'assistant';
