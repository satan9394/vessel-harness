/**
 * UI-013 read side: aggregate active and `WAITING_APPROVAL` work across every
 * project into a single Activity queue. Pure aggregation over injected sources so
 * it is deterministic and testable without spinning up a real session.
 */

export type ActivityKind = 'session' | 'team' | 'subagent' | 'goal';
export type RunOutcomeStatus = 'queued' | 'running' | 'waiting_approval' | 'completed' | 'failed' | 'interrupted' | 'cancelled' | 'unknown';
export type ActivityStatus = 'needs_attention' | 'running' | 'completed' | 'failed' | 'unknown';

export interface ActivityRun {
  id: string;
  kind: ActivityKind;
  projectRoot: string;
  title: string;
  status: ActivityStatus;
  needsApproval: boolean;
  /** present when an inline decision is possible (UI-013 approval queue). */
  approval?: ActivityApproval;
  /** short, already-sanitized human hint (never raw prompt text). */
  detail?: string;
  updatedAt: number;
  href?: string;
  /** canonical observed outcome (ARCH-01) */
  outcome?: RunOutcomeStatus;
  statusSource?: 'live' | 'event_log' | 'approval_queue' | 'inferred';
}

export interface ActivityApprovalOption { id: string; label: string; tone: string }

export interface ActivityApproval {
  sessionId: string;
  widgetId: string;
  actionType: string;
  description: string;
  requestedAt: string;
  options: ActivityApprovalOption[];
}

export interface ActivitySessionSource {
  id: string;
  workspaceRoot: string;
  createdAt?: string;
  updatedAt?: string;
  topic?: { title?: string; isArchived?: boolean };
  lastRunStatus?: RunOutcomeStatus;
  recordCount?: number;
}

export interface ActivityLiveState {
  turnActive: boolean;
  lastRunStatus?: RunOutcomeStatus;
  errorDetail?: string;
  recordCount?: number;
}

export interface ActivitySubagentSource {
  id: string;
  name: string;
  status: 'idle' | 'running' | 'completed' | 'failed' | 'cancelled';
  worktreePath?: string;
  startedAt: string;
  endedAt?: string;
}

export interface ActivityTeamStageSource {
  id: string;
  status: 'staged' | 'approved' | 'rejected' | 'running' | 'finished';
  createdAt: number;
  tasks?: { status: string }[];
}

export interface ActivityGoalSource {
  id: string;
  projectRoot: string;
  goal: string;
  status: 'pending' | 'in-progress' | 'paused' | 'met' | 'not_met' | 'cancelled';
  createdAt?: string;
  updatedAt?: string;
}

export interface ActivitySources {
  sessions: () => Promise<ActivitySessionSource[]>;
  live: (sessionId: string) => ActivityLiveState | undefined;
  /** every pending permission decision across projects. */
  approvals: () => ActivityApproval[];
  subagents: () => Promise<ActivitySubagentSource[]>;
  teamStages: () => ActivityTeamStageSource[];
  goalTasks: () => ActivityGoalSource[];
  /** project root attributed to team/subagent activity when unknown. */
  defaultProjectRoot?: string;
}

const STATUS_ORDER: Record<ActivityStatus, number> = {
  needs_attention: 0,
  failed: 1,
  running: 2,
  unknown: 3,
  completed: 4,
};

function time(value: string | number | undefined): number {
  if (typeof value === 'number') return value;
  if (typeof value === 'string') { const parsed = Date.parse(value); if (Number.isFinite(parsed)) return parsed; }
  return 0;
}

export class ActivityRoutes {
  constructor(private readonly sources: ActivitySources) {}

  async list(): Promise<{ runs: ActivityRun[]; updatedAt: number }> {
    const root = this.sources.defaultProjectRoot ?? '';
    const [sessions, subagents] = await Promise.all([this.sources.sessions(), this.sources.subagents()]);
    const approvals = this.sources.approvals();
    const approvalBySession = new Map<string, ActivityApproval>();
    for (const approval of approvals) if (!approvalBySession.has(approval.sessionId)) approvalBySession.set(approval.sessionId, approval);
    const runs: ActivityRun[] = [];

    for (const session of sessions) {
      if (session.topic?.isArchived) continue;
      const approval = approvalBySession.get(session.id);
      const live = this.sources.live(session.id);

      let status: ActivityStatus;
      let outcome: RunOutcomeStatus;
      let statusSource: 'live' | 'event_log' | 'approval_queue' | 'inferred';

      if (approval) {
        status = 'needs_attention';
        outcome = 'waiting_approval';
        statusSource = 'approval_queue';
      } else if (live?.turnActive) {
        status = 'running';
        outcome = 'running';
        statusSource = 'live';
      } else if (live?.lastRunStatus) {
        outcome = live.lastRunStatus;
        status = outcome === 'failed' || outcome === 'interrupted' || outcome === 'cancelled'
          ? 'failed'
          : outcome === 'completed'
            ? 'completed'
            : 'unknown';
        statusSource = 'live';
      } else if (session.lastRunStatus) {
        outcome = session.lastRunStatus;
        status = outcome === 'failed' || outcome === 'interrupted' || outcome === 'cancelled'
          ? 'failed'
          : outcome === 'completed'
            ? 'completed'
            : 'unknown';
        statusSource = 'event_log';
      } else if (session.recordCount === 0 || live?.recordCount === 0) {
        // 空会话，从未执行任何有效 Turn，归为 unknown / queued，绝不冒充 completed
        status = 'unknown';
        outcome = 'queued';
        statusSource = 'inferred';
      } else if (typeof session.recordCount === 'number' && session.recordCount > 0) {
        // 历史已索引会话带有有效记录，且未被标记报错中断
        status = 'completed';
        outcome = 'completed';
        statusSource = 'inferred';
      } else {
        // 无法从现有数据确证成功结果，归为 unknown
        status = 'unknown';
        outcome = 'unknown';
        statusSource = 'inferred';
      }

      runs.push({
        id: session.id,
        kind: 'session',
        projectRoot: session.workspaceRoot,
        title: session.topic?.title?.trim() || session.id,
        status,
        outcome,
        statusSource,
        needsApproval: Boolean(approval),
        approval,
        updatedAt: time(session.updatedAt ?? session.createdAt),
        href: `/api/sessions/${session.id}`,
      });
    }

    for (const stage of this.sources.teamStages()) {
      const failed = stage.status === 'finished' && (stage.tasks ?? []).some((task) => task.status === 'failed');
      const status: ActivityStatus = stage.status === 'staged' ? 'needs_attention' : stage.status === 'running' ? 'running' : failed ? 'failed' : 'completed';
      runs.push({ id: stage.id, kind: 'team', projectRoot: root, title: `Team plan ${stage.id}`, status, needsApproval: stage.status === 'staged', updatedAt: stage.createdAt });
    }

    for (const subagent of subagents) {
      const status: ActivityStatus = subagent.status === 'running' ? 'running' : subagent.status === 'failed' || subagent.status === 'cancelled' ? 'failed' : 'completed';
      runs.push({ id: subagent.id, kind: 'subagent', projectRoot: subagent.worktreePath ?? root, title: subagent.name, status, needsApproval: false, updatedAt: time(subagent.endedAt ?? subagent.startedAt) });
    }

    for (const task of this.sources.goalTasks()) {
      const status: ActivityStatus = task.status === 'paused' ? 'needs_attention' : task.status === 'met' ? 'completed' : task.status === 'not_met' || task.status === 'cancelled' ? 'failed' : 'running';
      runs.push({ id: task.id, kind: 'goal', projectRoot: task.projectRoot, title: task.goal, status, needsApproval: false, updatedAt: time(task.updatedAt ?? task.createdAt) });
    }

    runs.sort((a, b) => STATUS_ORDER[a.status] - STATUS_ORDER[b.status] || b.updatedAt - a.updatedAt || a.id.localeCompare(b.id));
    return { runs, updatedAt: Date.now() };
  }
}
import * as fs from 'node:fs';
import { canonicalArgumentsHash, type CanonicalToolInvocation, type ToolCall, type ToolExecutionResult, type ToolSpec } from '@vessel/shared';

type Effect = NonNullable<ToolSpec['effects']>;
interface Intent { kind: 'intent'; key: string; attempt: number; effects: Effect; invocation: CanonicalToolInvocation }
interface Outcome { kind: 'outcome'; key: string; attempt: number; status: 'observed' | 'outcome_unknown' }
type Entry = Intent | Outcome;

/** Durable dispatch boundary. Unknown writes are reconciled by a caller, never replayed.
 * The owning Session supplies its existing single-writer lease for this journal.
 */
export class EffectJournal {
  private readonly entries: Entry[];
  constructor(private readonly file: string) {
    this.entries = fs.existsSync(file) ? fs.readFileSync(file, 'utf8').split('\n').filter(Boolean).map(line => JSON.parse(line) as Entry) : [];
  }
  private append(entry: Entry): void {
    const fd = fs.openSync(this.file, 'a');
    try { fs.writeSync(fd, JSON.stringify(entry) + '\n'); fs.fsyncSync(fd); } finally { fs.closeSync(fd); }
    this.entries.push(entry);
  }
  pending(): Intent[] {
    return this.entries.filter((entry): entry is Intent => entry.kind === 'intent' && !this.entries.some(outcome => outcome.kind === 'outcome' && outcome.key === entry.key && outcome.attempt === entry.attempt && outcome.status === 'observed'));
  }
  begin(call: ToolCall, tool: ToolSpec, invocation: CanonicalToolInvocation, key = call.toolCallId): void {
    const previous = this.entries.filter((entry): entry is Intent => entry.kind === 'intent' && entry.key === key).at(-1);
    const effects = tool.effects ?? (tool.requiredPermission === 'read' ? 'read_only' : 'non_idempotent');
    if (!previous && effects !== 'read_only' && this.pending().some(intent => intent.effects !== 'read_only')) {
      throw new Error('OUTCOME_UNKNOWN: pending session effect requires reconciliation before further writes');
    }
    if (previous) {
      if (previous.effects !== effects) throw new Error('Effect classification changed during recovery');
      if (canonicalArgumentsHash(previous.invocation) !== canonicalArgumentsHash(invocation)) throw new Error('Invocation identity changed during recovery');
      const complete = this.entries.some(entry => entry.kind === 'outcome' && entry.key === key && entry.attempt === previous.attempt && entry.status === 'observed');
      if (complete || effects !== 'read_only') throw new Error(complete ? 'Invocation already observed; replay prohibited' : 'OUTCOME_UNKNOWN: effect reconciliation required');
    }
    this.append({ kind: 'intent', key, attempt: (previous?.attempt ?? 0) + 1, effects, invocation });
  }
  finish(call: ToolCall, result: ToolExecutionResult, key = call.toolCallId): void {
    const intent = this.entries.filter((entry): entry is Intent => entry.kind === 'intent' && entry.key === key).at(-1);
    if (!intent) throw new Error('Missing execution intent');
    this.append({ kind: 'outcome', key: intent.key, attempt: intent.attempt, status: result.error && intent.effects !== 'read_only' ? 'outcome_unknown' : 'observed' });
  }
}
import * as fs from 'node:fs';
import * as os from 'node:os';
import * as path from 'node:path';
import { afterEach, beforeEach, describe, expect, it } from 'vitest';
import type { CanonicalToolInvocation, ToolCall, ToolExecutionResult, ToolSpec } from '@vessel/shared';
import { EffectJournal } from './EffectJournal.js';

/**
 * ARC-11 §11.1.3 — Crash / Fault Injection gates.
 *
 * A durable side-effect counter file stands in for an *irreversible* external
 * effect (the file system / an outbound call). Across a simulated process
 * restart the journal must:
 *   - surface every boundary that has an *unknown* outcome, and
 *   - refuse to replay a non-idempotent call, so the counter can never advance
 *     twice for the same invocation.
 */

const call: ToolCall = { toolCallId: 'call-1', toolName: 'Write', arguments: { path: 'out.txt' } };
const invocation: CanonicalToolInvocation = {
  canonicalToolId: 'builtin:Write',
  subject: { sessionId: 's', runId: 'r', agentInstanceId: 'agent-1' },
  argumentsCanonicalHash: 'hash-v1',
  requestedScopes: ['workspace-write'],
};
const writeTool = { name: 'Write', requiredPermission: 'workspace-write', effects: 'non_idempotent' } as ToolSpec;
const observedResult: ToolExecutionResult = { content: 'wrote 1 line', meta: { bytes: 12 } };

describe('ARC-11 fault injection — no duplicate execution of non-idempotent tools', () => {
  let root: string; let journalFile: string; let effectFile: string;

  beforeEach(() => {
    root = fs.mkdtempSync(path.join(os.tmpdir(), 'vessel-fault-'));
    journalFile = path.join(root, 'execution.jsonl');
    effectFile = path.join(root, 'effect-count');
  });
  afterEach(() => fs.rmSync(root, { recursive: true, force: true }));

  /** The irreversible side effect: every real run appends to the durable counter. */
  const runEffect = (): ToolExecutionResult => {
    const current = fs.existsSync(effectFile) ? Number(fs.readFileSync(effectFile, 'utf8')) : 0;
    fs.writeFileSync(effectFile, String(current + 1));
    return observedResult;
  };
  const effectCount = (): number => fs.existsSync(effectFile) ? Number(fs.readFileSync(effectFile, 'utf8')) : 0;

  /**
   * Mirror the runtime dispatch contract: `begin` (intent) → run → `finish`
   * (outcome). A crash is modelled by performing a subset of those steps.
   */
  const dispatchOnce = (journal: EffectJournal, tool: ToolSpec = writeTool, inv: CanonicalToolInvocation = invocation): 'completed' => {
    journal.begin(call, tool, inv);
    const result = runEffect();
    journal.finish(call, result);
    return 'completed';
  };

  it('boundary 1 — crash after pre-dispatch intent: recovery pauses, never re-executes', () => {
    const journal = new EffectJournal(journalFile);
    journal.begin(call, writeTool, invocation); // intent written, effect not yet run
    expect(effectCount()).toBe(0);

    const recovered = new EffectJournal(journalFile);
    expect(recovered.pending()).toHaveLength(1);
    expect(() => dispatchOnce(recovered)).toThrow('OUTCOME_UNKNOWN');
    expect(effectCount()).toBe(0); // the blind retry never reached the side effect
  });

  it('boundary 2 — crash after dispatch, before tool result: unknown outcome blocks replay', () => {
    const journal = new EffectJournal(journalFile);
    journal.begin(call, writeTool, invocation);
    runEffect(); // the irreversible effect happened
    expect(effectCount()).toBe(1); // then the process crashed before finish()

    const recovered = new EffectJournal(journalFile);
    expect(recovered.pending()).toHaveLength(1);
    expect(() => dispatchOnce(recovered)).toThrow('OUTCOME_UNKNOWN');
    expect(effectCount()).toBe(1); // never executed twice
  });

  it('boundary 3 — crash after the tool result is recorded: replay is prohibited outright', () => {
    const journal = new EffectJournal(journalFile);
    expect(dispatchOnce(journal)).toBe('completed');
    expect(effectCount()).toBe(1);

    const recovered = new EffectJournal(journalFile);
    expect(recovered.pending()).toEqual([]);
    expect(() => dispatchOnce(recovered)).toThrow('already observed');
    expect(effectCount()).toBe(1);
  });

  it('boundary 3b — an errored non-idempotent effect stays unresolved (outcome_unknown)', () => {
    const journal = new EffectJournal(journalFile);
    journal.begin(call, writeTool, invocation);
    journal.finish(call, { content: '', error: { errorClass: 'TOOL_FAILURE', message: 'lost response' }, meta: {} });
    const recovered = new EffectJournal(journalFile);
    expect(recovered.pending()).toHaveLength(1);
    expect(() => dispatchOnce(recovered)).toThrow('OUTCOME_UNKNOWN');
  });

  it('boundary 4 — approval transition binds the exact operation hash (no widen, no replay)', () => {
    const journal = new EffectJournal(journalFile);
    journal.begin(call, writeTool, invocation); // intent recorded at the approval boundary

    const recovered = new EffectJournal(journalFile);
    // A renewed approval must re-evaluate against the same canonical arguments.
    expect(() => recovered.begin(call, writeTool, { ...invocation, argumentsCanonicalHash: 'tampered-hash' })).toThrow('identity changed');
    // The original approval still cannot blind-dispatch an unknown effect.
    expect(() => dispatchOnce(recovered)).toThrow('OUTCOME_UNKNOWN');
    expect(effectCount()).toBe(0);
  });

  it('a pending non-idempotent effect blocks any further write until reconciled', () => {
    const journal = new EffectJournal(journalFile);
    journal.begin(call, writeTool, invocation);
    expect(() => journal.begin({ ...call, toolCallId: 'other-write' }, writeTool, invocation)).toThrow('reconciliation');
  });

  it('read-only work is recoverable without reconciliation (safe to regenerate)', () => {
    const readTool = { ...writeTool, effects: 'read_only' as const } as ToolSpec;
    const readCall = { ...call, toolCallId: 'read-1' };
    const journal = new EffectJournal(journalFile);
    journal.begin(readCall, readTool, invocation);
    const recovered = new EffectJournal(journalFile);
    expect(() => recovered.begin(readCall, readTool, invocation)).not.toThrow();
    expect(fs.readFileSync(journalFile, 'utf8')).toContain('"attempt":2');
  });
});

