    const headers: Record<string, string> = conn.protocol === 'anthropic' ? { 'x-api-key': conn.apiKey, 'anthropic-version': '2023-06-01' } : conn.apiKey ? { Authorization: `Bearer ${conn.apiKey}` } : {};
