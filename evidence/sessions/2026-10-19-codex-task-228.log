import { useEffect, useRef, useState } from 'react';
import type { ApiClient, CreateSessionInput, ModelOption, Project, SessionMeta } from '../api';
import { useI18n } from './LanguageProvider';
import { modelKey } from './NewSessionForm';

export function projectName(root: string): string { return root.split(/[\\/]/).filter(Boolean).at(-1) || root; }
export function readableSessionTitle(session: SessionMeta, fallback: string): string {
  const title = session.topic?.title?.trim();
  return title && !/^sess_|^untitled topic$|^未命名主题$/i.test(title) ? title : fallback;
}
/** Create a session only; its first turn goes through the existing conversation stream. */
export async function createTaskSession(api: ApiClient, input: CreateSessionInput, task: string, onBusyChange?: (busy: boolean) => void): Promise<SessionMeta> {
  if (!input.workspaceRoot.trim() || !task.trim()) throw new Error('Project and task are required');
  onBusyChange?.(true);
  try {
  await api.openProject(input.workspaceRoot.trim());
  const { session } = await api.createSession({ ...input, workspaceRoot: input.workspaceRoot.trim() });
  // ponytail: Titles are deterministic task summaries, never a second model call.
  try { await api.updateSessionTopic(session.id, { title: task.trim().replace(/\s+/g, ' ').slice(0, 80) }); } catch { /* Creation remains usable when metadata cannot be saved. */ }
  return session;
  } finally { onBusyChange?.(false); }
}
export default function TaskComposer({ api, projects, selectedRoot, onSelectProject, providerRevision, disabled, onConfigureModels, onAdvanced, onStarted, onBusyChange, draftRequest }: {
  api: ApiClient; projects: Project[]; selectedRoot: string; onSelectProject: (root: string) => void;
  providerRevision: number; disabled: boolean; onConfigureModels: () => void; onAdvanced: () => void;
  onBusyChange?: (busy: boolean) => void;
  draftRequest?: { text: string; serial: number };
  onStarted: (session: SessionMeta, task: string) => void;
}) {
  const { t } = useI18n();
  const [task, setTask] = useState('');
  const taskInput = useRef<HTMLTextAreaElement>(null);
  useEffect(() => {
    if (!draftRequest) return;
    setTask(draftRequest.text);
    taskInput.current?.focus();
  }, [draftRequest]);
  const [path, setPath] = useState('');
  const [models, setModels] = useState<ModelOption[]>([]);
  const [selection, setSelection] = useState('');
  const [permission, setPermission] = useState<NonNullable<CreateSessionInput['permission']>>('workspace-write');
  const [loading, setLoading] = useState(true);
  const [failed, setFailed] = useState(false);
  const [retry, setRetry] = useState(0);
  const [busy, setBusy] = useState(false);
  const [error, setError] = useState('');
  useEffect(() => {
    let live = true; setLoading(true); setFailed(false);
    void api.listModels().then(({ models: catalog }) => {
      if (!live) return;
      const real = catalog.filter(model => model.providerName !== 'mock'); setModels(real);
      setSelection(previous => previous || (real[0] ? modelKey(real[0]) : ''));
    }).catch(() => { if (live) setFailed(true); }).finally(() => { if (live) setLoading(false); });
    return () => { live = false; };
  }, [api, providerRevision, retry]);
  const root = selectedRoot || path.trim();
  const unavailable = Boolean(selection && !models.some(model => modelKey(model) === selection));
  async function submit(event: React.FormEvent) {
    event.preventDefault(); if (!root || !task.trim() || busy || loading || failed || unavailable || disabled) return;
    setBusy(true); setError('');
    try {
      const model = models.find(item => modelKey(item) === selection);
      const session = await createTaskSession(api, { workspaceRoot: root, permission, ...(model ? { provider: model.providerName, model: model.id } : {}) }, task, onBusyChange);
      onStarted(session, task.trim());
    } catch { setError(t('sessionCreateFailed')); } finally { setBusy(false); }
  }
  return <form className="task-composer" onSubmit={submit}>
    <h2>{t('taskPrompt')}</h2>
    <label htmlFor="taskProject">{t('chooseProject')}</label>
    <select id="taskProject" className="input" value={selectedRoot} disabled={busy} onChange={event => onSelectProject(event.target.value)}>
      <option value="">{t('openProjectPath')}</option>
      {projects.map(project => <option key={project.root} value={project.root}>{projectName(project.root)}</option>)}
    </select>
    {selectedRoot ? <p className="composer-root dim" title={root}>{root}</p> : <input className="input" aria-label={t('workspacePath')} placeholder={t('workspacePlaceholder')} value={path} onChange={event => setPath(event.target.value)} disabled={busy} />}
    <label htmlFor="taskInput">{t('taskPrompt')}</label>
    <textarea ref={taskInput} id="taskInput" className="input task-input" placeholder={t('taskPlaceholder')} value={task} onChange={event => setTask(event.target.value)} disabled={busy} />
    <div className="composer-options">
      <label>{t('selectModel')}<select className="input model-pill" aria-label={t('selectModel')} value={selection} disabled={busy || loading} onChange={event => setSelection(event.target.value)}>
        {unavailable && <option value={selection}>{t('modelUnavailable')}</option>}
        {!models.length && !selection && <option value="">{t('modelOffline')}</option>}
        {models.map(model => <option key={modelKey(model)} value={modelKey(model)}>{model.providerName} / {model.id}</option>)}
      </select></label>
      <label>{t('permissionLabel')}<select className="input" aria-label={t('permissionLabel')} value={permission} disabled={busy} onChange={event => setPermission(event.target.value as typeof permission)}>
        <option value="read-only">{t('permissionReadOnly')}</option><option value="workspace-write">{t('permissionWorkspaceWrite')}</option>
      </select></label>
      <button className="btn btn-primary" type="submit" disabled={busy || disabled || loading || failed || unavailable || !root || !task.trim()}>{busy ? t('creating') : t('startTask')}</button>
    </div>
    {unavailable && !loading && <p role="alert" className="error-text">{t('modelUnavailable')}</p>}
    {loading && <p role="status" className="dim">{t('loading')}</p>}
    {failed && <p role="alert" className="error-text">{t('modelLoadFailed')} <button className="btn" type="button" onClick={() => setRetry(value => value + 1)}>{t('modelRetry')}</button></p>}
    {!loading && !failed && !models.length && <p className="dim">{t('noModelsConfigured')} · {t('modelOffline')}</p>}
    {error && <p role="alert" className="error-text">{error}</p>}
    <div className="composer-secondary"><button className="btn" type="button" data-action="advanced-session" onClick={onAdvanced} disabled={busy}>{t('advancedSession')}</button><button className="btn" type="button" data-action="configure-models" onClick={onConfigureModels} disabled={busy}>{t('configureModels')}</button></div>
  </form>;
}
/* Vessel Local Web UI — per docs/UI-THEME.md:
   light is :root default; dark follows prefers-color-scheme. All colors via vars. */

/* Color tokens live in the `.tokens` layer (index.html sets that class on <html>),
   so the app and the pre-hydration skeleton share one source of truth. */
.tokens {
  /* 玻璃令牌（浅色默认），值取自 docs/DESIGN.md §2.1 与原型 :root */
  --bg: #e4e8f3;
  --panel: #ffffff;
  --panel-2: #f2f4fb;
  --panel-3: #e4e8f5;
  --ring: rgba(38, 44, 80, 0.08);
  --ring-2: rgba(38, 44, 80, 0.16);
  --text: #0c1020;
  --text-2: #525a73;
  --text-3: #858ca3;
  --accent: #5b6cff;
  --accent-fg: #ffffff;
  --accent-soft: rgba(91, 108, 255, 0.1);
  --ok: #0f7a55;
  --warn: #8a6100;
  --danger: #b4292e;
  --ok-soft: rgba(15, 122, 85, 0.1);
  --warn-soft: rgba(138, 97, 0, 0.11);
  --danger-soft: rgba(180, 41, 46, 0.09);
  /* 结构 / 质感 */
  --glass: color-mix(in srgb, var(--panel) 78%, transparent);
  --hl: inset 0 1px 0 rgba(255, 255, 255, 0.9);
  --shadow-1: 0 1px 2px rgba(38, 44, 80, 0.05);
  --shadow-2: 0 1px 1px rgba(38, 44, 80, 0.04), 0 40px 90px -40px rgba(38, 44, 80, 0.32);
  --shadow-3: 0 2px 6px rgba(38, 44, 80, 0.06), 0 60px 120px -46px rgba(38, 44, 80, 0.42);
  --glow-a: rgba(122, 132, 255, 0.5);
  --glow-b: rgba(94, 220, 196, 0.42);
  --glow-c: rgba(255, 178, 150, 0.36);
  /* 尺度 */
  --r-1: 14px;
  --r-2: 18px;
  --r-3: 24px;
  --r-4: 30px;
  --r-pill: 999px;
  --ease: cubic-bezier(0.32, 0.72, 0, 1);
  /* 时间轴泳道语义色（DESIGN.md §4.3） */
  --think: #7c5ce0;
  --tools: #0e8a9b;
  --approve: #c08a00;
  --policy: #b24a5e;

  /* 旧变量名保留为别名：既有组件 CSS 零改动仍可用（IMPLEMENTATION-PLAN §3） */
  --panel2: var(--panel-2);
  --border: var(--ring);
  --dim: var(--text-3);
  --text-soft: var(--text-2);
  --hover: var(--panel-2);
  --row-line: var(--ring);
  --green: var(--ok);
  --red: var(--danger);
  --yellow: var(--warn);
  --bubble-assistant: var(--panel);
  --bubble-user: var(--accent-soft);
}

/* 无 JS 回退：跟随系统深色（DESIGN.md §1；产品不提供手动切换） */
@media (prefers-color-scheme: dark) {
  .tokens {
    --bg: #06070d;
    --panel: #0d0f18;
    --panel-2: #131725;
    --panel-3: #1a1f30;
    --ring: rgba(255, 255, 255, 0.08);
    --ring-2: rgba(255, 255, 255, 0.16);
    --text: #eef0f8;
    --text-2: #98a0b8;
    --text-3: #6a7288;
    --accent: #9ba6ff;
    --accent-fg: #0a0c18;
    --accent-soft: rgba(155, 166, 255, 0.14);
    --ok: #4ade94;
    --warn: #f4c151;
    --danger: #ff7c72;
    --ok-soft: rgba(74, 222, 148, 0.12);
    --warn-soft: rgba(244, 193, 81, 0.12);
    --danger-soft: rgba(255, 124, 114, 0.12);
    --glass: color-mix(in srgb, var(--panel) 82%, transparent);
    --hl: inset 0 1px 0 rgba(255, 255, 255, 0.07);
    --shadow-1: 0 1px 2px rgba(0, 0, 0, 0.5);
    --shadow-2: 0 1px 0 rgba(255, 255, 255, 0.06), 0 50px 110px -50px rgba(0, 0, 0, 0.98);
    --shadow-3: 0 1px 0 rgba(255, 255, 255, 0.07), 0 70px 150px -60px #000;
    --glow-a: rgba(112, 124, 255, 0.42);
    --glow-b: rgba(46, 180, 166, 0.34);
    --glow-c: rgba(255, 140, 120, 0.26);
    --think: #a78bfa;
    --tools: #3dd6e8;
    --approve: #f4c151;
    --policy: #ff8fa3;
  }
}

* {
  box-sizing: border-box;
}

html,
body,
#root {
  height: 100%;
  margin: 0;
}

body {
  background: var(--bg);
  color: var(--text);
  font-family: 'Geist', 'Segoe UI Variable Display', -apple-system, BlinkMacSystemFont, 'Segoe UI',
    Roboto, 'Helvetica Neue', Arial, 'PingFang SC', 'Microsoft YaHei', sans-serif;
  font-size: 13.5px;
  line-height: 1.55;
  letter-spacing: -0.006em;
  font-variant-numeric: tabular-nums;
  -webkit-font-smoothing: antialiased;
}

/* 固定光场：不随滚动，位于内容之下（DESIGN.md §2.1，只用于 body::before） */
body::before {
  content: '';
  position: fixed;
  inset: 0;
  pointer-events: none;
  z-index: 0;
  background:
    radial-gradient(52% 42% at 6% -4%, var(--glow-a), transparent 60%),
    radial-gradient(46% 40% at 98% 4%, var(--glow-b), transparent 62%),
    radial-gradient(60% 44% at 52% 106%, var(--glow-c), transparent 64%);
}

@media (prefers-reduced-motion: reduce) {
  * {
    animation-duration: 0.01ms !important;
    animation-iteration-count: 1 !important;
    transition-duration: 0.01ms !important;
  }
}

/* ---------- layout: 58px rail + 232px session bar + main (DESIGN.md §4) ---------- */
.app {
  position: relative;
  z-index: 1;
  display: grid;
  grid-template-columns: 58px 232px minmax(0, 1fr);
  transition: grid-template-columns 200ms var(--ease);
  gap: 12px;
  padding: 12px;
  height: 100vh;
  height: 100dvh;
}

/* P2/P3: glass shell — frosted rail + session bar, floating panels */
.rail {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 8px;
  min-height: 0;
  padding: 12px 0;
  border-radius: var(--r-3);
  background: var(--glass);
  border: 1px solid var(--ring);
  box-shadow: var(--shadow-2);
  backdrop-filter: blur(26px) saturate(1.7);
  -webkit-backdrop-filter: blur(26px) saturate(1.7);
}
.rail-mark {
  display: grid;
  place-items: center;
  width: 30px;
  height: 30px;
  margin-bottom: 4px;
  border-radius: 10px;
  background: var(--accent-soft);
  color: var(--accent);
}
.rail-item {
  display: grid;
  place-items: center;
  width: 34px;
  height: 34px;
  border: 1px solid transparent;
  border-radius: 11px;
  background: transparent;
  color: var(--text-2);
  cursor: pointer;
  transition: background 120ms var(--ease), color 120ms var(--ease), transform 120ms var(--ease);
}
.rail-item:hover { background: var(--panel-2); color: var(--text); }
.rail-item-active { background: var(--accent-soft); border-color: var(--ring-2); color: var(--accent); }
.desktop-sidebar-toggle { flex-shrink: 0; margin-left: 12px; }
.sidebar-collapse { margin-left: auto; min-width: 40px; min-height: 40px; }
@media (min-width: 1181px) {
  .app.sidebar-collapsed { grid-template-columns: 58px 0px minmax(0, 1fr); }
  .sidebar-collapsed .navigation-shell { visibility: hidden; pointer-events: none; }
}
.navigation-shell {
  display: flex;
  flex-direction: column;
  min-height: 0;
  border-radius: var(--r-3);
  background: var(--panel);
  border: 1px solid var(--ring);
  box-shadow: var(--shadow-2);
  overflow: hidden;
}
.topbar {
  position: sticky;
  top: 0;
  z-index: 20;
  border-radius: var(--r-2);
  background: var(--glass);
  border: 1px solid var(--ring);
  box-shadow: var(--shadow-1);
}
@supports (backdrop-filter: blur(1px)) {
  .navigation-shell, .topbar {
    backdrop-filter: blur(26px) saturate(1.7);
    -webkit-backdrop-filter: blur(26px) saturate(1.7);
  }
}
.main {
  min-width: 0;
  min-height: 0;
  background: var(--panel);
  border: 1px solid var(--ring);
  border-radius: var(--r-3);
  box-shadow: var(--shadow-2);
  overflow: hidden;
}
.navigation-shell .sidebar { background: transparent; border-right: 0; padding: 14px; }

/* ---------- subagent workspace ---------- */
.subagent-card { display: flex; align-items: center; gap: 4px; }
.subagent-select { flex: 1; display: flex; justify-content: space-between; gap: 8px; text-align: left; }
.subagent-name { overflow-wrap: anywhere; }
.subagent-badge { font-size: 11px; color: var(--dim); }
.subagent-badge.status-running { color: var(--accent); }
.subagent-badge.status-completed { color: var(--green); }
.subagent-badge.status-failed { color: var(--red); }
.subagent-drawer { position: fixed; z-index: 30; right: 0; top: 0; bottom: 0; width: min(480px, 100vw); padding: 24px; overflow-y: auto; background: var(--bg); border-left: 1px solid var(--border); box-shadow: -8px 0 24px #0002; animation: subagent-slide 160ms ease-out; }
.subagent-drawer-heading { display: flex; align-items: center; justify-content: space-between; gap: 12px; }
.subagent-fields { display: grid; grid-template-columns: auto 1fr; gap: 8px 16px; }
.subagent-fields dt { color: var(--dim); }
.subagent-fields dd { margin: 0; overflow-wrap: anywhere; }
.subagent-logs { padding-left: 20px; overflow-wrap: anywhere; }
.subagent-logs li { margin-bottom: 8px; }
.subagent-logs time { color: var(--dim); font-size: 11px; }
@keyframes subagent-slide { from { transform: translateX(100%); } to { transform: translateX(0); } }
@media (prefers-reduced-motion: reduce) { .subagent-drawer { animation: none; } }

/* ---------- sidebar ---------- */
.sidebar {
  display: flex;
  flex-direction: column;
  gap: 12px;
  padding: 16px;
  background: var(--panel);
  border-right: 1px solid var(--border);
  overflow-y: auto;
}

.brand {
  display: flex;
  align-items: center;
  gap: 8px;
  font-size: 16px;
  font-weight: 700;
}

.brand-name {
  letter-spacing: 0.3px;
}

.side-nav {
  display: flex;
  flex-direction: column;
  gap: 16px;
  flex: 1;
}

.side-label {
  font-size: 11px;
  text-transform: uppercase;
  letter-spacing: 0.6px;
  color: var(--dim);
}

.side-list {
  list-style: none;
  margin: 6px 0 0;
  padding: 0;
  display: flex;
  flex-direction: column;
  gap: 2px;
}

.side-item {
  padding: 6px 8px;
  border-radius: 6px;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
  color: var(--text-soft);
}

.side-item:hover {
  background: var(--hover);
}

.side-item-active {
  background: var(--panel2);
  color: var(--accent);
  font-weight: 600;
}

.side-empty {
  padding: 6px 8px;
  color: var(--dim);
}

.topic-search {
  margin-top: 8px;
  padding: 7px 9px;
  font-size: 12px;
}

.topic-archived-toggle {
  display: flex;
  align-items: center;
  gap: 6px;
  margin: 7px 2px;
  color: var(--dim);
  font-size: 11px;
}

.topic-period-list {
  max-height: min(58vh, 680px);
  overflow-y: auto;
}

.topic-period {
  margin-top: 12px;
}

.topic-group {
  margin-top: 5px;
  padding: 5px 4px 7px;
  border-bottom: 1px solid var(--row-line);
}

.topic-heading {
  display: flex;
  min-width: 0;
}

.topic-title {
  min-width: 0;
  width: 100%;
  border: 0;
  padding: 4px 6px;
  background: transparent;
  color: var(--text);
  text-align: left;
  font: inherit;
  font-size: 13px;
  font-weight: 650;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
  cursor: pointer;
}

.topic-title:hover {
  color: var(--accent);
}

.topic-session {
  display: block;
  width: 100%;
  border: 0;
  background: transparent;
  text-align: left;
  font-size: 11px;
  cursor: pointer;
}

.topic-actions,
.topic-edit {
  display: flex;
  flex-wrap: wrap;
  align-items: center;
  gap: 5px;
  padding: 3px 6px 0;
}

.topic-action {
  border: 0;
  padding: 2px 0;
  background: transparent;
  color: var(--dim);
  font: inherit;
  font-size: 10px;
  cursor: pointer;
}

.topic-action:hover {
  color: var(--accent);
  text-decoration: underline;
}

.topic-edit .input {
  flex: 1 1 100%;
  min-width: 0;
  padding: 5px 7px;
  font-size: 12px;
}

.side-footer {
  border-top: 1px solid var(--border);
  padding-top: 8px;
}

/* ---------- P4: persistent plan checklist (DESIGN.md §4.1) ---------- */
.plan-checklist { margin: 0 auto 8px; width: 100%; max-width: 760px; padding: 12px 14px; border: 1px solid var(--ring); border-radius: var(--r-2); background: var(--panel-2); }
.plan-head { display: flex; align-items: center; justify-content: space-between; gap: 8px; }
.plan-title { font-size: 11px; letter-spacing: 0.14em; text-transform: uppercase; color: var(--text-3); }
.plan-steps { list-style: none; margin: 8px 0 0; padding: 0; display: flex; flex-direction: column; gap: 2px; }
.plan-step { display: flex; align-items: baseline; gap: 8px; font-size: 12.5px; color: var(--text-2); }
.plan-step-done { color: var(--text-3); }
.plan-step-done .plan-label { text-decoration: line-through; text-decoration-color: var(--ring-2); }
.plan-step-current { color: var(--text); }
.plan-glyph { flex: none; width: 12px; text-align: center; }
.plan-step-done .plan-glyph { color: var(--ok); }
.plan-step-current .plan-glyph { color: var(--accent); }
.plan-step-todo .plan-glyph { color: var(--text-3); }
.plan-label { flex: 1; min-width: 0; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
.plan-meta { font-size: 11px; font-variant-numeric: tabular-nums; }
.plan-empty { margin: 6px 0 0; font-size: 12px; }

/* ---------- P5: composer capsules + always-on meters (DESIGN.md §4.2) ---------- */
.composer-shell { display: flex; flex-direction: column; gap: 8px; padding: 10px 16px 12px; border-top: 1px solid var(--ring); }
.composer-capsules { display: flex; flex-wrap: wrap; gap: 8px; align-items: center; }
.capsule { display: inline-flex; align-items: center; gap: 6px; padding: 4px 10px; border: 1px solid var(--ring); border-radius: var(--r-pill); background: var(--panel-2); font-size: 11.5px; max-width: 100%; }
.capsule-k { color: var(--text-3); letter-spacing: 0.1em; text-transform: uppercase; font-size: 10px; }
.capsule b { color: var(--text); font-weight: 600; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; max-width: 220px; }
.capsule-solid { background: var(--accent-soft); border-color: var(--ring-2); }
.capsule-modes { gap: 4px; }
.mode-pill { border: 1px solid transparent; background: transparent; color: var(--text-2); border-radius: var(--r-pill); padding: 2px 9px; font: inherit; font-size: 11px; cursor: pointer; transition: background 200ms var(--ease), color 200ms var(--ease); }
.mode-pill:hover { background: var(--panel); color: var(--text); }
.mode-pill-active { background: var(--accent-soft); border-color: var(--ring-2); color: var(--accent); }
.mode-resolve, .mode-pin { border: 1px dashed var(--ring-2); color: var(--text-3); }
.capsule-resolved { color: var(--text-3); font-variant-numeric: tabular-nums; font-size: 11px; }
.meters { display: flex; flex-wrap: wrap; gap: 6px 18px; align-items: center; font-size: 11.5px; color: var(--text-2); font-variant-numeric: tabular-nums; }
.meters .meter { display: inline-flex; align-items: center; gap: 6px; }
.meters .meter b { color: var(--text-3); font-weight: 600; letter-spacing: 0.1em; text-transform: uppercase; font-size: 10px; }
.cbar { display: inline-block; width: 64px; height: 6px; border-radius: var(--r-pill); background: var(--panel-3); overflow: hidden; }
.cbar i { display: block; height: 100%; background: var(--accent); }
.meter-keys { margin-left: auto; }
.meter-keys kbd { border: 1px solid var(--ring-2); border-radius: 5px; padding: 0 5px; font: inherit; font-size: 10px; background: var(--panel-2); }
.composer-shell .composer { padding: 0; border-top: 0; }

/* ---------- buttons / inputs ---------- */
.btn {
  appearance: none;
  border: 1px solid transparent;
  background: var(--panel-2);
  color: var(--text);
  border-radius: 6px;
  padding: 6px 12px;
  font-size: 14px;
  cursor: pointer;
}

.btn:hover:not(:disabled) {
  background: var(--hover);
}

.btn:disabled {
  opacity: 0.55;
  cursor: default;
}

.btn, .starter-pill, .model-pill { transition: background-color 120ms var(--ease), color 120ms var(--ease), transform 120ms var(--ease); }
.btn:active:not(:disabled), .rail-item:active:not(:disabled), .model-pill:active:not(:disabled) { transform: scale(.98); }
.btn:focus-visible, .rail-item:focus-visible, .model-pill:focus-visible { outline: 2px solid var(--accent); outline-offset: 3px; }
@media (prefers-reduced-motion: reduce) {
  .btn:active:not(:disabled), .rail-item:active:not(:disabled), .model-pill:active:not(:disabled) { transform: none; }
}

.btn-primary {
  background: var(--accent);
  border-color: var(--accent);
  color: var(--accent-fg);
}

.btn-primary:hover:not(:disabled) {
  filter: brightness(1.05);
}

.input {
  width: 100%;
  border: 1px solid var(--border);
  background: var(--bg);
  color: var(--text);
  border-radius: 6px;
  padding: 8px 10px;
  font-size: 14px;
}

/* ---------- main ---------- */
.main {
  display: flex;
  flex-direction: column;
  overflow-y: auto;
}

.statusbar {
  display: flex;
  align-items: center;
  gap: 8px;
  padding: 12px 24px;
  border-bottom: 1px solid var(--border);
  font-size: 13px;
  color: var(--text-soft);
}

.dot {
  width: 10px;
  height: 10px;
  border-radius: 50%;
  flex: none;
}

.dot-ok {
  background: var(--green);
}

.dot-err {
  background: var(--red);
}

.status-err {
  color: var(--red);
}

.main-body {
  padding: 40px 48px;
  max-width: 720px;
}

.main-body h2 {
  margin: 0 0 8px;
  font-weight: 600;
}

.dim {
  color: var(--dim);
}

.result-line {
  margin: 4px 0;
}

code {
  background: var(--panel2);
  border-radius: 4px;
  padding: 1px 6px;
  font-family: ui-monospace, SFMono-Regular, Menlo, Consolas, monospace;
  font-size: 12px;
}

.error-text {
  color: var(--red);
}

/* ---------- new session modal ---------- */
.overlay {
  position: fixed;
  inset: 0;
  background: rgba(0, 0, 0, 0.35);
  display: flex;
  align-items: flex-start;
  justify-content: center;
  padding-top: 12vh;
}

.modal {
  width: 420px;
  background: var(--bg);
  border: 1px solid var(--border);
  border-radius: 8px;
  padding: 20px;
  box-shadow: 0 8px 24px rgba(0, 0, 0, 0.12);
}

.modal h3 {
  margin: 0 0 12px;
  font-weight: 600;
}

.field-label {
  display: block;
  margin-bottom: 4px;
  color: var(--dim);
  font-size: 13px;
}

.modal-actions {
  display: flex;
  justify-content: flex-end;
  gap: 8px;
  margin-top: 16px;
}

/* ---------- conversation view (task 042) ---------- */
.conversation {
  flex: 1;
  display: flex;
  flex-direction: column;
  min-height: 0;
}

.conversation-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 12px;
  padding: 10px 24px;
  border-bottom: 1px solid var(--border);
}

.message-list-scroll {
  flex: 1;
  overflow-y: auto;
  padding: 20px 24px;
  display: flex;
  flex-direction: column;
  gap: 12px;
  min-height: 0;
}

.message-list {
  display: flex;
  flex-direction: column;
  gap: 12px;
  margin: 0 auto;
  width: 100%;
  max-width: 760px;
}

.conversation-empty {
  color: var(--dim);
  text-align: center;
  margin: 40px 0;
}

.conversation-error {
  text-align: center;
}

.msg {
  display: flex;
  flex-direction: column;
  gap: 4px;
  max-width: 84%;
}

.msg-user {
  align-self: flex-end;
  align-items: flex-end;
}

.msg-assistant {
  align-self: flex-start;
  align-items: flex-start;
}

.msg-role {
  font-size: 11px;
  text-transform: uppercase;
  letter-spacing: 0.5px;
  color: var(--dim);
}

.msg-body {
  background: var(--bubble-assistant);
  border: 1px solid var(--border);
  border-radius: 8px;
  padding: 8px 12px;
  white-space: pre-wrap;
  word-break: break-word;
}

.msg-user .msg-body {
  background: var(--bubble-user);
  border-color: transparent;
}

.msg-tool-call {
  color: var(--dim);
  font-size: 12px;
  font-style: italic;
  margin-left: 4px;
}

.msg-thinking {
  color: var(--dim);
  display: flex;
  align-items: center;
  gap: 8px;
}

.thinking-block {
  width: min(760px, 100%);
  border: 1px solid var(--border);
  border-radius: 8px;
  background: var(--panel);
  color: var(--text-soft);
  overflow: hidden;
}

.thinking-block summary {
  display: flex;
  align-items: center;
  gap: 8px;
  padding: 8px 12px;
  color: var(--dim);
  font-size: 12px;
  cursor: pointer;
  user-select: none;
}

.thinking-block summary:hover {
  color: var(--accent);
}

.thinking-block summary .thinking-dot {
  flex: 0 0 8px;
}

.thinking-mark {
  width: 8px;
  height: 8px;
  flex: 0 0 8px;
  border-radius: 50%;
  background: var(--dim);
  opacity: 0.65;
}

.thinking-content {
  max-height: 38vh;
  overflow: auto;
  margin: 0;
  padding: 10px 12px;
  border-top: 1px solid var(--border);
  color: var(--text-soft);
  font: 12px/1.55 ui-monospace, SFMono-Regular, Menlo, Consolas, monospace;
  white-space: pre-wrap;
  overflow-wrap: anywhere;
}

.thinking-dot {
  width: 8px;
  height: 8px;
  border-radius: 50%;
  background: var(--accent);
  animation: pulse 1s ease-in-out infinite;
}

@keyframes pulse {
  0%,
  100% {
    opacity: 0.3;
  }
  50% {
    opacity: 1;
  }
}

/* tool activity rows */
.tool-row {
  display: flex;
  align-items: center;
  gap: 8px;
  font-size: 13px;
  color: var(--text-soft);
  font-family: ui-monospace, SFMono-Regular, Menlo, Consolas, monospace;
}

.tool-name {
  font-weight: 600;
}

.tool-status {
  color: var(--dim);
}

.tool-dur {
  color: var(--dim);
}

.tool-args {
  color: var(--dim);
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
  max-width: 320px;
}

/* usage strip */
.usage-bar {
  display: flex;
  align-items: center;
  gap: 12px;
  font-size: 12px;
  color: var(--dim);
  font-family: ui-monospace, SFMono-Regular, Menlo, Consolas, monospace;
}

.talking-metrics {
  display: flex;
  flex-wrap: wrap;
  gap: 5px 14px;
  margin: 0 auto;
  padding: 6px 24px;
  max-width: 760px;
  width: 100%;
  border-top: 1px solid var(--row-line);
  color: var(--dim);
  font-size: 11px;
  font-family: ui-monospace, SFMono-Regular, Menlo, Consolas, monospace;
}

.talking-metric {
  display: flex;
  align-items: baseline;
  gap: 5px;
}

.talking-metric dt {
  color: var(--dim);
}

.talking-metric dd {
  margin: 0;
  color: var(--text-soft);
}

/* composer */
.composer {
  display: flex;
  gap: 8px;
  padding: 12px 24px;
  border-top: 1px solid var(--border);
  max-width: 760px;
  width: 100%;
  margin: 0 auto;
}

.composer-input {
  flex: 1;
}

/* ---------- top bar: status + customize (task 043) ---------- */
.topbar {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 12px;
  padding-right: 16px;
  border-bottom: 1px solid var(--border);
}

.topbar .statusbar {
  flex: 1;
  border-bottom: none;
}

.topbar-actions {
  flex-wrap: wrap;
  display: flex;
  align-items: center;
  gap: 8px;
}
.attention-controls { display: flex; flex-wrap: wrap; gap: 6px; }

/* ---------- language switch (task 045) ---------- */
.lang-switch {
  position: relative;
}

.lang-switch-toggle {
  white-space: nowrap;
}

.lang-switch-popover {
  position: absolute;
  top: calc(100% + 6px);
  right: 0;
  z-index: 20;
  min-width: 130px;
  background: var(--bg);
  border: 1px solid var(--border);
  border-radius: 8px;
  box-shadow: 0 8px 24px rgba(0, 0, 0, 0.16);
  padding: 4px;
  display: flex;
  flex-direction: column;
}

.lang-option {
  appearance: none;
  border: none;
  background: transparent;
  color: var(--text-soft);
  text-align: left;
  padding: 6px 10px;
  border-radius: 6px;
  font-size: 14px;
  cursor: pointer;
}

.lang-option:hover {
  background: var(--hover);
}

.lang-option-active {
  color: var(--accent);
  font-weight: 600;
}

.customize {
  position: relative;
}

.customize-toggle {
  white-space: nowrap;
}

.customize-popover {
  position: absolute;
  top: calc(100% + 6px);
  right: 0;
  z-index: 20;
  min-width: 220px;
  background: var(--bg);
  border: 1px solid var(--border);
  border-radius: 8px;
  box-shadow: 0 8px 24px rgba(0, 0, 0, 0.16);
  padding: 8px;
}

.customize-head {
  font-size: 11px;
  text-transform: uppercase;
  letter-spacing: 0.6px;
  color: var(--dim);
  padding: 4px 6px 8px;
}

.customize-list {
  display: flex;
  flex-direction: column;
  gap: 2px;
}

.customize-item {
  display: flex;
  align-items: center;
  gap: 8px;
  padding: 6px 8px;
  border-radius: 6px;
  cursor: pointer;
  color: var(--text-soft);
}

.customize-item:hover {
  background: var(--hover);
}

.customize-item input[type='checkbox'] {
  accent-color: var(--accent);
}

/* ---------- module sections (task 043) ---------- */
.conversation-wrap {
  display: flex;
  flex-direction: column;
  flex: 1;
  min-height: 0;
  /* The conversation keeps a usable height (`layout.css`) and the extra module
     panels sit below; when the pair does not fit, scroll rather than overlap. */
  overflow-y: auto;
}

.module-sections {
  flex: none;
  display: grid;
  grid-template-columns: repeat(auto-fill, minmax(260px, 1fr));
  gap: 12px;
  padding: 20px 24px;
  border-top: 1px solid var(--border);
}

.module-card {
  background: var(--panel);
  border: 1px solid var(--border);
  border-radius: 8px;
  padding: 12px 14px;
}

.module-card-title {
  font-size: 12px;
  text-transform: uppercase;
  letter-spacing: 0.5px;
  font-weight: 600;
  color: var(--text-soft);
  margin-bottom: 8px;
}

.module-card-body {
  font-size: 13px;
}

.tool-activity-list {
  display: flex;
  flex-direction: column;
  gap: 6px;
}
/* ===== Team module (task 060) ===== */
.team-module { display: flex; flex-direction: column; gap: 10px; }

.model-selector { display: flex; flex-wrap: wrap; align-items: center; gap: 8px; min-width: 0; }
.model-selector .input { width: auto; max-width: 100%; min-width: 0; }
.model-capabilities { flex-basis: 100%; }
.provider-capabilities { flex-basis: 100%; min-width: 0; }
.capability-status { display: grid; gap: 6px; margin: 10px 0; font-size: 0.85rem; }
.capability-status > div { display: flex; flex-wrap: wrap; gap: 4px 12px; }
.capability-status dt { min-width: 140px; font-weight: 600; }
.capability-status dd { margin: 0; overflow-wrap: anywhere; }
.model-modes { display: inline-flex; border: 1px solid var(--border); border-radius: 6px; overflow: hidden; }
.mode-btn { border: 0; border-right: 1px solid var(--border); background: var(--panel); color: var(--text); padding: 4px 10px; cursor: pointer; font-size: 12px; }
.mode-btn:last-child { border-right: 0; }
.mode-btn-active { background: var(--accent); color: #fff; }
.mode-btn:disabled { opacity: 0.6; cursor: default; }
.model-resolved { font-family: ui-monospace, monospace; font-size: 12px; }
.model-actions { display: inline-flex; gap: 6px; margin-left: auto; }
.model-pin-on { color: var(--yellow); }

.team-run-composer { display: flex; gap: 8px; }

.team-module-section { border-top: 1px solid var(--row-line); padding-top: 10px; }
.team-module-hint { font-size: 11px; }

.team-empty { font-size: 12px; }
.team-empty-title { font-weight: 600; margin-bottom: 2px; }

.team-panel { display: flex; flex-direction: column; gap: 8px; }
.team-run-head { display: flex; align-items: center; gap: 8px; font-size: 12px; flex-wrap: wrap; }
.run-status { text-transform: uppercase; font-size: 10px; border: 1px solid var(--border); padding: 0 6px; border-radius: 8px; }
.run-status-running { color: var(--accent); border-color: var(--accent); }
.run-status-completed { color: var(--green); border-color: var(--green); }
.run-status-failed { color: var(--red); border-color: var(--red); }
.team-run-task { font-weight: 600; max-width: 55ch; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
.team-run-summary { font-size: 11px; }
.team-run-error { font-size: 12px; margin: 0; }

.team-cards { display: flex; flex-direction: column; gap: 8px; }
.team-member { border: 1px solid var(--border); border-radius: 8px; padding: 8px 10px; background: var(--panel); }
.team-member-running { border-color: var(--accent); }
.team-member-head { display: flex; align-items: center; gap: 8px; flex-wrap: wrap; }
.team-member-name { font-weight: 600; }
.team-member-model { font-family: ui-monospace, monospace; font-size: 11px; color: var(--text-soft); background: var(--panel2); border-radius: 4px; padding: 0 4px; }
.team-member-tier { font-size: 11px; }
.team-member-live { color: var(--accent); font-size: 10px; text-transform: uppercase; animation: blink 1.2s infinite; }
@keyframes blink { 50% { opacity: 0.2; } }

.team-phase { display: flex; gap: 8px; align-items: center; font-size: 12px; margin-top: 4px; }
.phase-status { font-size: 10px; border-radius: 8px; padding: 0 6px; border: 1px solid var(--border); }
.phase-completed { color: var(--green); border-color: var(--green); }
.phase-running { color: var(--accent); border-color: var(--accent); }
.phase-failed { color: var(--red); border-color: var(--red); }
.team-phase-waiting { font-size: 12px; margin-top: 4px; }
.team-label { font-size: 10px; text-transform: uppercase; color: var(--dim); margin: 6px 0 2px; }
.team-pre { font-size: 11px; white-space: pre-wrap; word-break: break-word; background: var(--panel2); border-radius: 6px; padding: 6px 8px; max-height: 8em; overflow: auto; }
.team-turns { font-size: 11px; margin-top: 4px; }
.team-tools { display: flex; flex-wrap: wrap; gap: 4px; margin-top: 6px; }
.tool-chip { font-size: 10px; border-radius: 4px; border: 1px solid var(--border); padding: 0 5px; background: var(--bg); }
.tool-done { color: var(--green); }
.tool-error { color: var(--red); }
.tool-denied { color: var(--yellow); }
.tool-started { color: var(--accent); }
.team-delegates { margin-top: 6px; font-size: 11px; display: flex; flex-direction: column; gap: 4px; }
.team-delegate { border-left: 2px solid var(--border); padding-left: 8px; }
.team-delegate-output { max-height: 5em; }

.review-box { border-radius: 6px; padding: 6px 8px; font-size: 12px; margin-top: 6px; border: 1px solid var(--border); }
.review-met { border-color: var(--green); }
.review-not_met { border-color: var(--yellow); }
.review-impossible, .review-error { border-color: var(--red); }
.review-verdict { font-weight: 600; }
.review-list { margin: 4px 0 0; padding-left: 18px; font-size: 11px; }

.review-required { border-top: 1px dashed var(--border); padding-top: 8px; display: flex; flex-direction: column; gap: 8px; }
.review-required-title { font-weight: 600; color: var(--red); font-size: 12px; }
.review-row { border: 1px solid var(--border); border-radius: 8px; padding: 8px; background: var(--panel); font-size: 12px; }
.review-row-pending { border-left: 3px solid var(--red); }
.review-row-head { display: flex; gap: 8px; align-items: center; }
.review-status { font-size: 10px; text-transform: uppercase; border-radius: 8px; padding: 0 6px; border: 1px solid var(--border); }
.review-row-pending .review-status { color: var(--red); border-color: var(--red); }
.review-row-imported .review-status { color: var(--green); border-color: var(--green); }
.review-id { font-size: 10px; font-family: ui-monospace, monospace; overflow: hidden; text-overflow: ellipsis; max-width: 30ch; white-space: nowrap; }
.review-task { margin-top: 2px; }
.review-results { margin-top: 4px; font-size: 11px; }
.review-result { color: var(--dim); }
.review-result-not_met { color: var(--yellow); }
.review-result-met { color: var(--green); }
.review-actions { display: flex; gap: 6px; margin-top: 8px; flex-wrap: wrap; }
.review-import-input { display: none; }
.review-import-label { cursor: pointer; }
.team-notice { font-size: 11px; }

/* ===== Goal/Loop module (task 065) ===== */
.goal-module { display: flex; flex-direction: column; gap: 10px; }

.goal-composer { display: flex; gap: 8px; }

.goal-panel { display: flex; flex-direction: column; gap: 10px; }

.goal-queue { display: flex; flex-direction: column; gap: 6px; }
.goal-queue-head { display: flex; align-items: center; justify-content: space-between; gap: 8px; }

.goal-label { font-size: 10px; text-transform: uppercase; letter-spacing: 0.5px; color: var(--dim); font-weight: 600; }

.goal-note { font-size: 11px; }

.goal-empty { font-size: 12px; }
.goal-empty-title { font-weight: 600; margin-bottom: 2px; }

.goal-task-list { display: flex; flex-direction: column; gap: 4px; }
.goal-task-row {
  appearance: none;
  border: 1px solid var(--border);
  background: var(--bg);
  color: var(--text);
  border-radius: 6px;
  padding: 6px 8px;
  font-size: 12px;
  text-align: left;
  cursor: pointer;
  display: flex;
  align-items: center;
  gap: 8px;
  width: 100%;
}
.goal-task-row:hover { background: var(--hover); }
.goal-task-row-active { border-color: var(--accent); background: var(--panel2); }
.goal-task-goal { overflow: hidden; text-overflow: ellipsis; white-space: nowrap; flex: 1; }

.goal-status { font-size: 10px; text-transform: uppercase; border: 1px solid var(--border); border-radius: 8px; padding: 0 6px; flex: none; }
.goal-status-pending { color: var(--dim); }
.goal-status-in-progress { color: var(--accent); border-color: var(--accent); }
.goal-status-met { color: var(--green); border-color: var(--green); }
.goal-status-not_met { color: var(--yellow); border-color: var(--yellow); }
.goal-status-cancelled { color: var(--red); border-color: var(--red); }

.goal-detail { border-top: 1px solid var(--row-line); padding-top: 10px; display: flex; flex-direction: column; gap: 8px; }
.goal-detail-head { display: flex; align-items: center; gap: 8px; flex-wrap: wrap; }
.goal-task-title { font-weight: 600; max-width: 40ch; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
.goal-outcome-reason { font-size: 11px; }

.goal-actions { display: flex; align-items: center; gap: 8px; flex-wrap: wrap; }
.goal-run-hint { font-size: 11px; }
.goal-controls { display: inline-flex; gap: 6px; margin-left: 2px; }
.goal-control-btn { padding: 4px 10px; font-size: 12px; }
.goal-control-btn:disabled { cursor: not-allowed; }
.goal-control-reserved { opacity: 0.6; }

.goal-iterations { display: flex; flex-direction: column; gap: 6px; }
.goal-iterations-list { display: flex; flex-direction: column; gap: 8px; }

.goal-iteration { border: 1px solid var(--border); border-radius: 8px; padding: 8px 10px; background: var(--panel); display: flex; flex-direction: column; gap: 4px; }
.goal-iteration-head { display: flex; align-items: center; gap: 8px; font-size: 12px; flex-wrap: wrap; }
.goal-iteration-num { font-family: ui-monospace, monospace; font-size: 11px; color: var(--dim); }
.goal-verdict { font-size: 10px; text-transform: uppercase; border-radius: 8px; padding: 0 6px; border: 1px solid var(--border); }
.goal-verdict-met { color: var(--green); border-color: var(--green); }
.goal-verdict-not_met { color: var(--yellow); border-color: var(--yellow); }
.goal-verdict-impossible, .goal-verdict-error { color: var(--red); border-color: var(--red); }
.goal-iteration-reason { font-size: 11px; }

.goal-gen-eval { display: grid; grid-template-columns: 1fr 1fr; gap: 8px; margin-top: 4px; }
.goal-gen, .goal-eval { display: flex; flex-direction: column; gap: 4px; font-size: 12px; }
.goal-pre { font-size: 11px; white-space: pre-wrap; word-break: break-word; background: var(--panel2); border-radius: 6px; padding: 6px 8px; max-height: 6em; overflow: auto; }
.goal-artifact-count { font-size: 11px; }

.goal-review { border: 1px solid var(--border); border-radius: 6px; padding: 6px 8px; font-size: 12px; }
.goal-review-met { border-color: var(--green); }
.goal-review-not_met { border-color: var(--yellow); }
.goal-review-impossible, .goal-review-error { border-color: var(--red); }
.goal-review-verdict { font-weight: 600; }
.goal-review-list { margin: 4px 0 0; padding-left: 16px; font-size: 11px; }

.goal-acceptance { display: flex; flex-direction: column; gap: 4px; font-size: 11px; }
.goal-acceptance-list { margin: 0; padding-left: 16px; }

.goal-module-hint { font-size: 11px; }

/* Keep the session navigator usable without squeezing the conversation on phones. */
@media (max-width: 700px) {
  .app {
    grid-template-columns: 58px minmax(0, 1fr);
    height: 100dvh;
    overflow: hidden;
  }

  .sidebar {
    min-width: 0;
    min-height: 0;
    padding: 10px 12px;
    border-right: 0;
    border-bottom: 1px solid var(--ring);
  }

  .side-nav {
    min-height: 0;
    gap: 8px;
  }

  .topic-period-list {
    max-height: 18vh;
  }

  .main {
    min-width: 0;
    min-height: 0;
    overflow-x: hidden;
    overflow-y: auto;
  }

  .conversation-wrap {
    min-height: 420px;
    flex: 0 0 auto;
  }

  .topbar {
    flex-wrap: wrap;
    gap: 6px;
    padding: 6px 10px;
  }

  .topbar-actions {
    gap: 6px;
  }

  .conversation-head {
    flex-wrap: wrap;
    gap: 5px 10px;
    padding: 8px 10px;
  }

  .message-list-scroll {
    min-width: 0;
    padding: 12px;
  }

  .msg {
    max-width: 100%;
  }

  .thinking-content {
    max-width: 100%;
    overflow-x: auto;
    white-space: pre-wrap;
    overflow-wrap: anywhere;
  }

  .talking-metrics {
    box-sizing: border-box;
    max-width: none;
    padding: 6px 10px;
    gap: 4px 9px;
  }

  .composer {
    box-sizing: border-box;
    max-width: none;
    padding: 10px;
    gap: 6px;
  }

  .composer-input {
    min-width: 0;
  }

  .main-body {
    padding: 20px 16px;
  }

  .module-sections {
    grid-template-columns: minmax(0, 1fr);
    padding: 12px;
  }

  .goal-gen-eval {
    grid-template-columns: minmax(0, 1fr);
  }
}

.team-dag-scroll { overflow-x: auto; }
.team-dag-edge { fill: none; stroke: var(--text-3); stroke-width: 2; }
.team-dag-node { width: 200px; min-height: 68px; border: 2px solid var(--ring-2); border-radius: var(--r-1); background: var(--panel-2); color: inherit; cursor: pointer; display: grid; padding: 8px; text-align: left; }
.team-dag-node[aria-pressed="true"] { outline: 3px solid var(--accent); }
.team-dag-node.status-completed { border-color: var(--ok); }
.team-dag-node.status-failed { border-color: var(--danger); }
.team-dag-node.status-running, .team-dag-node.status-ready { border-color: var(--accent); animation: team-pulse 1.5s ease-in-out infinite; }
.team-dag-node.status-claimed { border-color: var(--warn); }
.team-staged-banner { position: sticky; top: 0; z-index: 1; padding: 12px; background: var(--panel-2); border: 1px solid var(--accent); }
.team-node-drawer { border-left: 2px solid var(--accent); padding: 12px; overflow-wrap: anywhere; animation: team-drawer .2s ease-out; }
.team-node-drawer pre { white-space: pre-wrap; }
@keyframes team-pulse { 50% { opacity: .6; } }
@keyframes team-drawer { from { transform: translateX(16px); opacity: 0; } }
@media (prefers-reduced-motion: reduce) { .team-dag-node, .team-node-drawer { animation: none; } }
.team-plan-editor-row { display: flex; flex-wrap: wrap; align-items: center; gap: 8px; padding: 8px 0; }
.team-plan-editor-row label { display: grid; gap: 4px; max-width: 100%; }
.team-plan-editor-row input, .team-plan-editor-row textarea, .team-plan-editor-row select { max-width: 100%; }

/* ponytail: reuse the installed CSS theme; no Tailwind dependency is needed. */
.inline-widget { margin: 12px 0; padding: 14px; border: 1px solid var(--border); border-radius: 10px; background: var(--panel); min-width: 0; }
.widget-head, .widget-actions { display: flex; flex-wrap: wrap; align-items: center; gap: 10px; }
.widget-head .btn { margin-left: auto; }
.inline-widget code, .inline-widget pre { font-family: var(--mono, monospace); }
.inline-widget pre, .widget-hash { overflow-wrap: anywhere; white-space: pre-wrap; }
.inline-widget details { margin-top: 10px; }
.inline-widget summary { cursor: pointer; }
.widget-diff { overflow-x: auto; margin-top: 12px; }
.widget-diff table { border-collapse: collapse; width: 100%; white-space: pre; font-size: 12px; }
.widget-diff td { padding: 2px 8px; }
.widget-diff .diff-number { width: 3em; text-align: right; opacity: .6; user-select: none; }
.diff-add { color: var(--green); background: rgba(45, 160, 99, .12); }
.diff-remove { color: var(--red); background: rgba(210, 65, 65, .12); }
.diff-meta { color: var(--dim); }
.gate-light { width: 10px; height: 10px; border-radius: 50%; background: var(--yellow); }
.gate-green_verified .gate-light { background: var(--green); }
.gate-rejected .gate-light { background: var(--red); }
.widget-danger { color: var(--red); }
.widget-actions .btn:hover:not(:disabled) { transform: translateY(-1px); }

.streaming-reasoning { min-width: 0; }
.reasoning-rate { font-size: .8em; color: var(--dim); }
.reasoning-rules { display: flex; flex-wrap: wrap; gap: .4rem; margin-block: .4rem; }
.reasoning-rule { border: 1px solid var(--border); border-radius: .5rem; padding: .4rem .6rem; max-width: 100%; overflow-wrap: anywhere; }
.reasoning-rule summary { cursor: pointer; }
.reasoning-rule p { white-space: pre-wrap; }
@supports (interpolate-size: allow-keywords) {
  .streaming-reasoning details { interpolate-size: allow-keywords; }
  .streaming-reasoning details::details-content { height: 0; overflow: clip; transition: height 160ms ease, content-visibility 160ms allow-discrete; }
  .streaming-reasoning details[open]::details-content { height: auto; }
}
@media (prefers-reduced-motion: reduce) {
  .streaming-reasoning details::details-content { transition: none; }
  .streaming-reasoning .thinking-dot { animation: none; }
}

/* V2.6 provider settings */
.provider-overlay { z-index: 40; padding: 4vh 12px; background: rgba(0, 0, 0, .6); }
.provider-modal { width: min(620px, 100%); max-height: 92vh; overflow-y: auto; }
.provider-heading { display: flex; align-items: center; justify-content: space-between; gap: 12px; }
.provider-heading h3 { margin: 0; }
.provider-list { display: grid; gap: 10px; margin-top: 18px; }
.provider-card { display: flex; flex-wrap: wrap; align-items: center; gap: 10px; padding: 12px; border: 1px solid var(--border); border-radius: 8px; }
.provider-card code, .provider-card > span:not(.provider-badge) { flex-basis: 100%; overflow-wrap: anywhere; }
.provider-badge { border: 1px solid var(--border); border-radius: 5px; padding: 2px 6px; font-size: 12px; color: var(--dim); }
.provider-fields { border: 0; padding: 0; margin: 0; display: grid; gap: 7px; min-width: 0; }
.provider-fields p { margin: 0 0 5px; font-size: 12px; }
.provider-result { padding: 8px 12px; border: 1px solid currentColor; border-radius: var(--r-1); }
.provider-result.success { color: var(--ok); }
.provider-result.failure { color: var(--danger); }

/* P2/P3: rail nav layout (glass shell rules live near the top of this file) */
.primary-nav { display: flex; flex-direction: column; gap: 6px; }
.navigation-shell .sidebar { flex: 1; min-height: 0; border: 0; }
.project-select { background: none; border: 0; color: inherit; padding: 4px; width: 100%; text-align: left; cursor: pointer; }
.main, .topbar, .statusbar { min-width: 0; }
.topbar { flex-wrap: nowrap; }
.statusbar { overflow: hidden; }
.status-text { white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
.topbar-actions { flex-shrink: 0; }
.preferences-menu { position: relative; }
.preferences-menu summary { list-style: none; cursor: pointer; }
.preferences-content { position: absolute; right: 0; top: 100%; z-index: 25; background: var(--panel); border: 1px solid var(--border); padding: 12px; display: grid; gap: 12px; width: 280px; }
.workbench-home { display: flex; flex-direction: column; gap: 20px; width: 100%; max-width: 960px; margin-inline: auto; overflow-y: auto; }
.home-heading h1 { margin: 0; font-size: clamp(24px, 3vw, 32px); font-weight: 500; letter-spacing: -.02em; text-wrap: balance; }
.workbench-home > p { margin: 0; color: var(--text-2); }
.home-workspace { display: flex; flex-wrap: wrap; align-items: center; justify-content: space-between; gap: 12px; background: var(--panel-2); padding: 16px; border-radius: var(--r-1); }
.home-workspace > div { min-width: 0; flex: 1; }
.workbench-home h2 { font-size: 14px; font-weight: 500; }
.home-workspace p { margin: 0; font-size: 12px; color: var(--text-2); overflow-wrap: anywhere; }
.home-health { color: var(--text-2); font-size: 12px; }
.home-health.is-online { color: var(--ok); }
.starter-prompts { display: flex; flex-wrap: wrap; gap: 8px; }
.starter-pill { border-radius: var(--r-pill); min-height: 40px; }
.home-session-grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(min(100%, 220px), 1fr)); gap: 12px; }
.home-session { display: grid; gap: 6px; text-align: left; padding: 16px; border-radius: var(--r-1); min-width: 0; }
.home-session strong { font-weight: 500; overflow-wrap: anywhere; }
.home-session span, .home-session time, .home-recent > p { font-size: 12px; color: var(--text-2); overflow-wrap: anywhere; }
.home-session time { font-variant-numeric: tabular-nums; }
.task-composer { width: min(760px, 100%); display: grid; gap: 12px; margin: 24px auto; padding: 24px; border: 0; border-radius: var(--r-1); background: var(--panel-2); }
.workbench-home .task-composer { width: 100%; margin: 0; }
.task-composer h2 { margin: 0 0 12px; }
.task-input { min-height: 150px; resize: vertical; font: inherit; }
.composer-root { margin: 0; overflow-wrap: anywhere; font-size: 12px; }
.composer-options { display: flex; flex-wrap: wrap; gap: 12px; align-items: end; }
.composer-options label { display: grid; gap: 4px; flex: 1; min-width: 0; }
.composer-options .input { width: 100%; min-width: 0; }
.model-pill { border-radius: 20px; }
.composer-secondary { display: flex; flex-wrap: wrap; gap: 8px; }
.layout-boundary { font-size: 12px; padding: 0 12px; max-width: 320px; }
.activity-sessions { display: grid; gap: 12px; }
.activity-sessions .btn { display: grid; text-align: left; gap: 4px; }
.activity-sessions span { color: var(--dim); font-size: 12px; }
.topic-actions summary { cursor: pointer; }
.command-group summary { font-weight: 600; padding: 10px; color: var(--dim); cursor: pointer; }
.navigation-toggle, .navigation-backdrop { display: none; }
/* ≤1180px: the session bar collapses into a drawer (DESIGN.md §4). The icon rail never collapses. */
@media (max-width: 1180px) {
  .app { grid-template-columns: 58px minmax(0, 1fr); }
  .navigation-shell { display: none; position: fixed; z-index: 45; top: 12px; bottom: 12px; left: 82px; width: min(320px, 82vw); }
  .navigation-open .navigation-shell { display: flex; }
  .navigation-toggle { display: inline-block; flex-shrink: 0; }
  .navigation-backdrop { display: block; position: fixed; z-index: 44; inset: 0; border: 0; background: #0007; }
  .desktop-sidebar-toggle, .sidebar-collapse { display: none; }
}
@media (max-width: 800px) {
  .topbar { gap: 8px; padding: 8px; }
  .topbar-actions { gap: 4px; }
  .topbar-actions .btn { padding: 5px 7px; font-size: 12px; }
  .main-body { padding: 16px; }
  .task-composer { margin: 8px 0; padding: 16px; }
  .composer-options { align-items: stretch; }
  .composer-options label { flex-basis: 100%; }
  .composer-options > button { width: 100%; }
  .modal { width: 100%; max-height: 95dvh; overflow-y: auto; }
  .conversation-head { min-width: 0; flex-wrap: wrap; }
  .preferences-content { width: min(280px, 88vw); }
}

.workbench-region { min-height: 0; flex: 1; display: flex; flex-direction: column; }
.workbench-region[hidden] { display: none; }

.command-group-toggle { background: none; border: 0; color: var(--dim); font: inherit; font-weight: 600; text-align: left; padding: 10px; width: 100%; cursor: pointer; }

.session-navigation { display: flex; flex-direction: column; flex: 1; min-height: 0; }
.session-navigation[inert] { opacity: .65; }
.navigation-close { display: none; }
@media (max-width: 1180px) { .navigation-close { display: block; margin: 12px 12px 0; } }

/* Read-only behavior inspection: keep long source refs and snapshots bounded.
   P6: the bordered card wall is flattened into sections + borderless lists. */
.agent-studio-inspector { min-width: 0; padding: 16px; border: 1px solid var(--ring); border-radius: var(--r-2); margin-bottom: 20px; }
.behavior-inspection, .behavior-entry, .behavior-layers > li { min-width: 0; overflow-wrap: anywhere; }
.behavior-layers { display: grid; grid-template-columns: repeat(5, minmax(0, 1fr)); gap: 12px; padding: 0; list-style: none; }
.behavior-layers > li { border-top: 1px solid var(--ring); padding: 10px 0; }
.behavior-entry { border: 0; border-top: 1px solid var(--ring); border-radius: 0; padding: 10px 0; }
.behavior-layers p { margin: 8px 0; }
.behavior-inspection pre { max-height: 280px; overflow: auto; white-space: pre-wrap; overflow-wrap: anywhere; }
.behavior-inspection summary { cursor: pointer; }
.behavior-entries { display: grid; gap: 8px; }
.behavior-entry dl { display: grid; grid-template-columns: max-content minmax(0, 1fr); gap: 6px 16px; }
.behavior-entry dd { margin: 0; }
.behavior-ladder { display: flex; flex-wrap: wrap; gap: 8px; padding: 0; list-style: none; }
.behavior-ladder li { padding: 4px 8px; border: 1px dashed var(--ring-2); border-radius: var(--r-1); opacity: .55; }
.behavior-ladder li[data-reached="true"] { opacity: 1; border-style: solid; border-color: var(--accent); }
.behavior-ladder li[aria-current="step"] { font-weight: 700; }
@media (max-width: 800px) { .behavior-layers { grid-template-columns: 1fr; } .agent-studio-inspector { padding: 12px; } }
/* Four-column skeleton (DESIGN.md §4): the inspector dock is the 300px review bar.
   `flex: 1 0 auto` + a usable `min-height` keep the process stream from being
   squeezed below its content by a sibling module panel (which used to make the
   composer overlap the module sections); `.conversation-wrap` scrolls instead. */
.dual-surface { display: grid; grid-template-columns: minmax(0, 1fr); flex: 1 0 auto; min-height: 420px; min-width: 0; }
.dual-surface.inspector-open { grid-template-columns: minmax(0, 1fr) 300px; gap: 12px; }
.chat-surface { display: flex; flex-direction: column; flex: 1; min-height: 0; min-width: 0; }
.inspector-toolbar { display: flex; justify-content: flex-end; padding: 10px 16px 0; }
.docked-inspector {
  display: flex;
  flex-direction: column;
  min-height: 0;
  min-width: 0;
  border-radius: var(--r-3);
  border: 1px solid var(--ring);
  background: var(--panel);
  overflow: hidden;
}
.inspector-heading { display: flex; align-items: center; justify-content: space-between; gap: 8px; padding: 12px 12px 6px; }
.inspector-heading strong { font-size: 13.5px; letter-spacing: -0.01em; }
.inspector-tabs { display: flex; flex-wrap: wrap; gap: 4px; padding: 0 12px 12px; border-bottom: 1px solid var(--ring); }
.inspector-tabs .btn { border: 1px solid transparent; background: transparent; border-radius: var(--r-pill); padding: 4px 10px; font-size: 12px; color: var(--text-2); }
.inspector-tabs .btn:hover { background: var(--panel-2); color: var(--text); }
.inspector-tabs [aria-selected='true'] { background: var(--accent-soft); border-color: var(--ring-2); color: var(--accent); }
.inspector-content { overflow: auto; overscroll-behavior: contain; flex: 1; min-height: 0; padding: 12px; }
.inspector-content .card, .inspector-content .module-card { border: 0; box-shadow: none; background: var(--panel-2); }
.inspector-backdrop { position: fixed; inset: 0; z-index: 60; background: #0008; animation: inspector-reveal 150ms var(--ease); }
@keyframes inspector-reveal { from { opacity: 0; } }
.cache-waveform, .impact-topology { display: block; width: 100%; color: var(--accent); }
.workspace-fingerprint { display: block; overflow-wrap: anywhere; }
.prefix-segments { display: flex; flex-wrap: wrap; gap: 12px; padding-left: 20px; }
.impact-topology { overflow: visible; }
@media (max-width: 1180px) {
  .dual-surface.inspector-open { grid-template-columns: minmax(0, 1fr); }
  .docked-inspector { position: fixed; inset: 0 0 0 auto; z-index: 61; width: min(90vw, 520px); border-radius: 0; animation: inspector-reveal 150ms var(--ease); }
}
{
  "name": "@vessel/web",
  "version": "0.10.0",
  "description": "Vessel Local Web UI — React + Vite shell (sidebar + health/projects/sessions) against the local server",
  "type": "module",
  "private": true,
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "typecheck": "tsc -p tsconfig.json",
    "preview": "vite preview",
    "test": "vitest run"
  },
  "dependencies": {
    "react": "^19.3.0",
    "react-dom": "^19.3.0"
  },
  "devDependencies": {
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "typescript": "^7.0.2",
    "vite": "^8.3.0",
    "vitest": "^5.0.1"
  }
}
import { describe, expect, it, vi } from 'vitest';
import { renderToStaticMarkup } from 'react-dom/server';
import { createApiClient } from '../api';
import { translate, type Lang } from '../i18n';
import TeamTaskTree from './tasks/TeamTaskTree';
import ActivityQueue from './activity/ActivityQueue';
import AgentStudioComposer from './studio/AgentStudioComposer';
import TracePanel from './trace/TracePanel';
import {
  childrenOf,
  flattenTree,
  formatDuration,
  groupActivity,
  readTraceLayout,
  reorderPriority,
  sortByPriority,
  taskStatusLabelKey,
  TRACE_LAYOUT_STORAGE_KEY,
  type ActivityResponse,
  type BehaviorConformanceReportView,
  type ComposerLibraryEntry,
  type TaskTreeSnapshotView,
  type TaskTreesResponse,
  type TraceReportView,
} from '../workbench';

let lang: Lang = 'en';
vi.mock('./LanguageProvider', () => ({ useI18n: () => ({ lang, t: translate(lang), setLang: vi.fn() }) }));

const snapshot: TaskTreeSnapshotView = {
  rootInstanceId: 'root', projectRoot: 'E:/repo', updatedAt: 1,
