import type { ProfileMode, SandboxStatus, ToolSpec } from '@vessel/shared';
import type { Sandbox } from '@vessel/runtime';
import { errorCode } from '../execution/selfHealing.js';
import { tmpdir } from 'node:os';
import { win32 } from 'node:path';
import { PlatformSandboxRunner } from '../execution/sandbox/platformSandbox.js';
import type { NativeSandboxRunner, SandboxAuditEvent } from '../execution/sandbox/types.js';

const WRAPPERS = /^(timeout|time|nice|nohup)\s+/i;

const READONLY_PREFIXES = [
  'ls',
  'dir',
  'cat',
  'type',
  'more',
  'pwd',
  'grep',
  'findstr',
  'find',
  'git status',
  'git log',
  'git diff',
  'git show',
  'git branch',
  'node --version',
  'npm --version',
  'node -v',
  'echo',
];

/**
 * Readonly classification — string parsing is ONLY for readonly *identification*
 * and deny *hints*, never the primary defense (POLICY-SPEC §2.4: 字符串解析只作只读识别).
 * Hard enforcement lives in the policy engine + sandbox.
 */
export function isReadonlyCommand(command: string): boolean {
  let c = command.trim().replace(WRAPPERS, '');
  c = c.replace(/^sudo\s+/i, '');
  const lower = c.toLowerCase();
  return READONLY_PREFIXES.some((p) => lower === p || lower.startsWith(p + ' '));
}

/**
 * task 072 escape-audit event kinds that are OPERATIONAL (an escape happened, a
 * termination succeeded, a termination failed). Everything else the process-tree
 * tracker records (`spawn` / `exit` / `attached` / `window-closed`) is routine
 * bookkeeping and is deliberately NOT forwarded — no noise in the tool result.
 */
export const ESCAPE_AUDIT_KINDS = [
  'escape-detected',
  'escape-terminated',
  'escape-terminate-failed',
] as const;

export type EscapeAuditKind = (typeof ESCAPE_AUDIT_KINDS)[number];

/**
 * Minimal structural slice of a runtime process-tree audit event — kept local so
 * @vessel/tools does not grow a hard type dependency on @vessel/runtime.
 */
export interface EscapeAuditEvent {
  kind: string;
  pid?: number;
  detail: string;
  at: number;
}

/**
 * Audit channel for escape/termination events. The product decision here is
 * "never let an escape conclusion die in runtime memory": the events go into the
 * tool result `meta` (which the AgentLoop persists on the session `tool/result`
 * record — the durable audit trail) and, when a sink is injected, are ALSO
 * pushed to the caller's audit channel.
 *
 * A plain-function injection (no `vi.fn`) so `restoreAllMocks()` cannot silently
 * disconnect the audit in tests — same convention as the runtime deps slice.
 */
export type EscapeAuditSink = (event: EscapeAuditEvent) => void;

/** Pick only the escape/termination-relevant events out of a process-tree audit. */
export function selectEscapeAuditEvents(audit: readonly EscapeAuditEvent[]): EscapeAuditEvent[] {
  const keep = new Set<string>(ESCAPE_AUDIT_KINDS);
  return (audit ?? [])
    .filter((e) => keep.has(e.kind))
    .map((e) => (e.pid === undefined ? { ...e } : { ...e, pid: e.pid }));
}

/** Stripped status payload surfaced to the caller: the facts, no prose. */
function statusMeta(status: SandboxStatus): Record<string, unknown> {
  return {
    supported: status.supported,
    active: status.active,
    backend: status.backend ?? 'none',
    ...(status.degraded === undefined ? {} : { degraded: status.degraded }),
    ...(status.fallbackReason === undefined ? {} : { reason: status.fallbackReason }),
  };
}

export function createShellTool(opts: {
  workspaceRoot: string;
  sandbox: Sandbox;
  /** optional audit channel; escape/termination events are forwarded here too. */
  audit?: EscapeAuditSink;
  nativeSandbox?: NativeSandboxRunner;
  /** Omitted callers fail closed like the default workspace-write profile. */
  permission?: ProfileMode;
  nativeAudit?: (event: SandboxAuditEvent) => void | Promise<void>;
}): ToolSpec {
  const { sandbox } = opts;
  const requireSandbox = opts.permission !== 'danger-full-access';
  const native = opts.nativeSandbox ?? (opts.nativeAudit ? new PlatformSandboxRunner() : undefined);

  return {
    name: 'Shell',
    description: 'Run a shell command in the workspace (Windows: cmd.exe; POSIX: /bin/sh).',
    family: 'exec',
    requiredPermission: 'workspace-write',
    exclusive: true,
    inputSchema: {
      type: 'object',
      properties: {
        command: { type: 'string', description: 'shell command line' },
        timeoutMs: { type: 'number', description: 'override timeout (default 30000)' },
        terminateEscaped: {
          type: 'boolean',
          description: 'task 072 hard response: terminate descendants detected outside the confined set (default false = audit only)',
        },
      },
      required: ['command'],
    },
    async execute(args, ctx) {
      const command = String(args.command ?? '');
      const timeoutMs = Number(args.timeoutMs ?? 30_000);
      // task 072 hard response is opt-in and OFF by default: the Sandbox default
      // is audit-only, and a caller can only ask for the terminate response
      // explicitly (terminateEscaped: true) — this never widens on its own.
      const terminateEscaped = args.terminateEscaped === true;
      if (!command) {
        return { content: '', error: { errorClass: 'INVALID_ARGS', message: 'command required' }, meta: {} };
      }
      if (opts.permission === 'read-only' || (requireSandbox && !native)) {
        return { content: '', error: { errorClass: 'DENIED', message: opts.permission === 'read-only' ? 'Shell requires workspace-write permission' : 'Shell requires a native sandbox runner' }, meta: { retryUnsafe: true } };
      }
      if (native) {
        const allowedWritePaths = [opts.workspaceRoot, tmpdir()];
        try {
          if (requireSandbox && !await native.isAvailable()) throw new Error('native sandbox unavailable');
          // Wrap every command: readonly prefix parsing cannot exclude shell redirection or substitution.
          const executable = process.platform === 'win32' ? win32.join(process.env.SystemRoot ?? 'C:\\Windows', 'System32', 'cmd.exe') : '/bin/sh';
          const argv = process.platform === 'win32' ? ['/d', '/s', '/c', command] : ['-c', command];
          const result = await native.execute(executable, argv, { cwd: opts.workspaceRoot, allowedWritePaths, cpuTimeoutMs: timeoutMs, lowIntegrity: true, signal: ctx?.signal, requireSandbox });
          if (requireSandbox && !result.sandboxed) throw new Error('native sandbox did not enforce confinement');
          await opts.nativeAudit?.({ isolationTier: result.isolationTier, sandboxed: result.sandboxed, outcome: result.sandboxed ? 'enforced' : 'fallback', allowedWritePaths,
            ...(result.constraints ? { constraints: result.constraints } : {}), ...(!result.sandboxed ? { reason: 'native-helper-unavailable' } : {}) });
          const output = (result.stdout + (result.stderr ? '\n[stderr]\n' + result.stderr : '')).trim();
          return {
            content: output || '(no output)',
            ...(result.exitCode !== 0 ? { error: { errorClass: 'TOOL_FAILURE' as const, message: `exit code ${result.exitCode}`, detail: { exitCode: result.exitCode } } } : {}),
            meta: { exitCode: result.exitCode, readonly: isReadonlyCommand(command), retryUnsafe: true, sandbox: { active: result.sandboxed, isolationTier: result.isolationTier } },
          };
        } catch (error) {
          await opts.nativeAudit?.({ isolationTier: process.platform === 'win32' ? 'windows-job-restricted' : 'passthrough-fallback', sandboxed: false, outcome: 'denied', allowedWritePaths, reason: String(error) });
          return { content: '', error: { errorClass: 'DENIED', message: `sandbox execution denied: ${String(error)}` }, meta: { retryUnsafe: true } };
        }
      }
      // confine seam: with the Windows Job Object backend this reports the
      // enforcement the backend is prepared to provide ('full') and `run` below
      // actually confines the spawn. It is a PRE-round prediction (it only reads
      // the failure recorded by an earlier round), so it is surfaced under its
      // own name — `preRoundEnforcement` — and is never mixed with the
      // round-scoped facts of this spawn.
      const confined = await sandbox.confine(command.split(/\s+/));
      let completed = false;
      try {
        const r = await sandbox.run(command, [], {
          timeoutMs,
          maxOutputBytes: 1024 * 1024,
          shell: true,
          limits: { terminateEscaped },
          // task 050: turn interrupt kills the child (result resolves killed:true)
          signal: ctx?.signal,
        });
        completed = true;
        const output = (r.stdout + (r.stderr ? '\n[stderr]\n' + r.stderr : '')).trim();
        // task 072 truthfulness: the escape conclusion must not stay in runtime
        // memory. `r.audit` is filtered down to escape/termination events and
        // carried on the result meta (persisted by the AgentLoop as the
        // `tool/result` session record) + forwarded to the injected audit sink.
        // The full audit is NOT dumped into the model-visible content.
        const escapeEvents = selectEscapeAuditEvents(r.audit);
        for (const e of escapeEvents) opts.audit?.(e);
        // Honest sandbox facts for THIS spawn (BRIEF ①). Which round each field
        // describes is NOT allowed to be ambiguous:
        //   - `preRoundEnforcement` — what `confine()` predicted BEFORE this round
        //     opened (a capability statement about the backend, not an outcome).
        //   - `supported` / `active` / `backend` / `degraded` / `reason` — the
        //     outcome of THIS round, taken from `r.sandbox`, i.e. the status
        //     `Sandbox.run` captured AFTER the spawn + attach settled.
        // Why it must be `r.sandbox`: `run()` opens a fresh round
        // (`Sandbox.beginRound()` clears `degraded`), so a snapshot taken BEFORE
        // `run()` describes the PREVIOUS round — it would report `active:true`
        // (and no `degraded`) for a round whose attach actually failed, and the
        // durable `tool/result` record would claim confinement that never was.
        const sandboxMeta: Record<string, unknown> = {
          preRoundEnforcement: confined.enforcement,
          ...statusMeta(r.sandbox),
          ...(escapeEvents.length > 0 ? { audit: escapeEvents } : {}),
        };
        if (r.exitCode !== 0 || r.killed) {
          return {
            content: output,
            error: {
              errorClass: 'TOOL_FAILURE',
              message: `exit code ${r.exitCode ?? 'null'}${r.timedOut ? ' (timed out)' : ''}${r.killed && !r.timedOut ? ' (interrupted)' : ''}`,
              detail: { exitCode: r.exitCode, timedOut: r.timedOut, killed: r.killed },
            },
            meta: {
              exitCode: r.exitCode,
              timedOut: r.timedOut,
              killed: r.killed,
              readonly: isReadonlyCommand(command),
              sandbox: sandboxMeta,
            },
          };
        }
        return {
          content: output || '(no output)',
          meta: {
            exitCode: r.exitCode,
            readonly: isReadonlyCommand(command),
            sandbox: sandboxMeta,
          },
        };
      } catch (err) {
        return {
          content: '',
          error: { errorClass: 'TOOL_FAILURE', message: `spawn failed: ${(err as Error).message}`, ...(!completed && errorCode(err) ? { detail: { code: errorCode(err) } } : {}) },
          meta: { readonly: isReadonlyCommand(command) },
        };
      }
    },
  };
}
import { createExecutionPermitAuthority, type ExecutionPermitAuthority, type PolicyArtifacts, type Verdict } from '@vessel/shared';

export interface PermissionSpec {
  requiredPermission?: 'read' | 'workspace-write' | 'danger-full-access';
}

export type PolicyInterceptor = (call: { toolName: string; arguments: Record<string, unknown> }) => Verdict | undefined;

/**
 * policy/engine — authoritative decision listener on the BeforeTool chain
 * (POLICY-SPEC §4.2). Decision order:
 *   ① denied_tools → ② deny rules → ③ hook override (seam) → ④ ask rules
 *   → ⑤ allow rules → ⑥ profile compare
 * then guard monotonic narrowing + fail-closed (approval:never is enforced
 * service-side BEFORE waterfall dispatch — responders cannot bypass it).
 */
export class PolicyEngine {
  private artifacts: PolicyArtifacts;
  private revision = 0;
  readonly permits: ExecutionPermitAuthority = createExecutionPermitAuthority(() => this.revision);

  constructor(artifacts: PolicyArtifacts, private readonly interceptors: readonly PolicyInterceptor[] = []) {
    this.artifacts = artifacts;
  }

  /** Re-read artifacts (e.g. after policy reload). */
  update(artifacts: PolicyArtifacts): void {
    this.artifacts = artifacts;
    this.revision++;
  }

  async decide(call: { toolName: string; arguments: Record<string, unknown> }, spec?: PermissionSpec): Promise<Verdict> {
    const path: string[] = [];
    const a = this.artifacts;

    // Mandatory gates may only narrow policy; an interceptor cannot grant access.
    for (const intercept of this.interceptors) {
      const verdict = intercept(call);
      if (verdict?.action === 'deny') return verdict;
    }

    // ① denied_tools — unconditional, before everything
    if (a.deniedTools.includes(call.toolName)) {
      const v: Verdict = {
        action: 'deny',
        decisionPath: [`denied_tools:${call.toolName}`],
        ruleRef: `denied_tools:${call.toolName}`,
        reason: `tool denied: ${call.toolName}`,
      };
      return v;
    }

    // ② deny rules (most restrictive first — any deny wins over narrower allow)
    for (const rule of a.rules) {
      if (rule.action === 'deny' && rule.match(call)) {
        return {
          action: 'deny',
          decisionPath: [...path, `rule:${rule.id}`],
          ruleRef: rule.id,
          reason: rule.reason ?? `denied by rule ${rule.id}`,
        };
      }
    }

    // ③ hook override — seam only in v0.1 (external hooks.json bridge lands v0.2)
    // ④ ask rules
    let askRef: string | undefined;
    for (const rule of a.rules) {
      if (rule.action === 'ask' && rule.match(call)) {
        askRef = rule.id;
        path.push(`ask:${rule.id}`);
        break;
      }
    }

    // ⑤ allow rules
    let allowRef: string | undefined;
    if (!askRef) {
      for (const rule of a.rules) {
        if (rule.action === 'allow' && rule.match(call)) {
          allowRef = rule.id;
          path.push(`allow:${rule.id}`);
          break;
        }
      }
    }

    // ⑥ profile compare (no rule matched): required_permission × profile
    let needsApproval = false;
    if (!askRef && !allowRef) {
      let req = spec?.requiredPermission ?? 'danger-full-access'; // unregistered => danger (D6)
      // readonly shell allowlist: string parsing is only readonly *identification*,
      // but allowlisted commands run without approval under workspace-write
      if (req === 'danger-full-access' && call.toolName === 'Shell' && this.isShellAllowed(call)) {
        req = 'read';
      }
      if (a.profile === 'read-only' && req !== 'read') {
        needsApproval = true;
        path.push(`profile:read-only:${req}`);
      } else if (a.profile === 'workspace-write' && req === 'danger-full-access') {
        needsApproval = true;
        path.push(`profile:workspace-write:${req}`);
      } else {
        path.push(`profile:${a.profile}:${req}`);
      }
    }

    // fail-closed: ask with no responder / approval:never => denied service-side
    if (askRef || needsApproval) {
      if (a.approval === 'never') {
        return {
          action: 'deny',
          decisionPath: [...path, 'approval:never'],
          ruleRef: askRef ?? 'policy-never',
          reason: askRef ? `approval required but approval=never: ${askRef}` : 'approval required but approval=never (profile)',
        };
      }
      return {
        action: 'ask',
        decisionPath: [...path, 'approval:ask'],
        ruleRef: askRef,
        reason: askRef ? `requires approval: ${askRef}` : 'requires approval (profile)',
      };
    }

    return {
      action: 'allow',
      decisionPath: path.length ? path : ['no-rule:allow'],
      ruleRef: allowRef,
    };
  }

  /** readonly shell allowlist check (identification only — not the primary defense). */
  private isShellAllowed(call: { toolName: string; arguments: Record<string, unknown> }): boolean {
    const cmd = String(call.arguments.command ?? '').trim();
    const lower = cmd.toLowerCase();
    return (this.artifacts.shellAllow ?? []).some((prefix) => {
      const p = prefix.toLowerCase();
      return lower === p || lower.startsWith(p + ' ');
    });
  }
}
# 任务卡 256 交付证据：受限沙箱真正跑起来了

**日期**：2026-10-23
**执行者**：Codex（候选方案）+ 协调者（定位并修正引号缺陷）
**结论**：原生验收通过。受限令牌 + Low + Job Object + 写根限制下，子进程能执行命令、能写 provisioned 写根、根外写入被拒。

---

## 1. 根因链（三步，逐步证伪）

卡 255 阶段已知：`CreateRestrictedToken` 的句柄没有 `TOKEN_ADJUST_DEFAULT`，必须在主令牌副本上降级；
`AccessCheck` 需要描述符自带 owner/group。这两处修完后，子进程仍以 `0xC0000142`（STATUS_DLL_INIT_FAILED）退出。

隔离矩阵（卡 255 证据）：

| 令牌 | 创建标志 | 结果 |
|---|---|---|
| 受限 + Low | `CREATE_NO_WINDOW` | `0xC0000142` |
| 受限 + Low | `CREATE_NEW_CONSOLE` | `0xC0000142` |
| 受限 + Low | `0`（继承父控制台） | 能启动 |
| 普通 + Low | `CREATE_NO_WINDOW` | 正常 |

即：受限令牌下**新建控制台**会崩。本轮采用 `CREATE_SUSPENDED | DETACHED_PROCESS (0x4|0x8)`，
不请求新控制台，标准输入接一条无写端的管道（立即 EOF），stdout/stderr 仍走既有管道。

## 2. 第二个缺陷：无条件加引号把 /c 变成 "/c"

换标志后子进程不再崩，但 `cmd.exe /c ver` 报 `'"ver' 不是内部或外部命令`。
用批处理回显 `%CMDCMDLINE%` 抓到真实命令行：

```
CMDLINE="cmd.exe" "/c" "C:\...\dump.bat"
```

原 `Quote()` 对所有参数无条件加引号。受限令牌下，cmd 对**内置命令**（ver/echo）在 `"/c"` 形式下的解析失败。
改为「仅在含空格/引号/控制字符时才加引号」，路径含空格仍走完整转义。修后内置命令与外部程序都能跑。

## 3. 第三个问题：whoami 在受限令牌下必崩

`whoami`、`whoami /groups`、`cmd /c whoami /groups` 全部 `0xC0000142`（不是权限拒绝，是 DLL 初始化失败），
所以不能用它来证明 Low。改为由启动器在创建子进程后，**直接查询子进程令牌的完整性 RID** 并回传
（`Result.ChildIntegrityRid` → `constraints.integrityRid`），探针据此判定。

## 4. 原生验收输出

`evidence/task256/native-smoke.json`（`node --import tsx evidence/task255/native-token-smoke.mts`，exit 0）：

- `echo`：`sandbox-ok`，退出 0
- `integrityRid`：**4096**（Low）
- 写 provisioned 根：写 `probe` 并读回成功，退出 0
- 写根外目录：退出 1，拒绝
- `checks`：`{echoOk:true, echoText:true, low:true, writeOk:true, outsideDenied:true}`
- `pass: true`

## 5. 端到端验证：真实模型 → Shell 工具 → 沙箱

`evidence/task256/e2e-real-session.json`。用 `commandgota-real / deepseek/deepseek-v4.1-flash`，
起独立服务（端口 5791），工作区是系统临时目录下的夹具，**并把该夹具的 tmp 子目录当作 TEMP**，
避免改动操作系统真正的临时目录：

- 供应商注册 201、会话创建 201（`permission: danger-full-access`）、回合 200 / `kind: success`
- 模型最终回复原样贴出了工具输出 `e2e-sandbox-ok`（不是编造）
- `session.jsonl` 24 条记录，其中：`tool/call` → **`audit/sandbox_enforced`（outcome: enforced, sandboxed: true, isolationTier: windows-job-restricted）** → `tool/result`

即：**模型在真实会话里成功调用 Shell，且确实走的是受限沙箱**，不是 passthrough。
夹具自带的隔离供应商库已随夹具一并回收，真实 `~/.vessel` 未被写入。

## 6. 未覆盖 / 边界

- 只验证了 `cmd.exe` 与内置命令；`whoami.exe` 在该令牌下无法运行，属已知限制，不代表沙箱失效。
- Job Object 的进程树清理沿用既有实现，本轮未改。
- 已用真实模型会话端到端验证过一次 Shell 调用；尚未覆盖「写根外写入被工具链拒绝」在会话内的表现。
