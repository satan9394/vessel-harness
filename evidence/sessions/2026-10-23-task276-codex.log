import { describe, expect, it, vi } from 'vitest';
import { Sandbox } from '@vessel/runtime';
import { createShellTool } from './shellTool.js';
import type { NativeSandboxRunner } from '../execution/sandbox/types.js';

const workspaceRoot = process.cwd();
const ctx = { workspaceRoot, cwd: workspaceRoot };
const args = { command: 'echo sandbox-test' };

function fixture() {
  const sandbox = new Sandbox();
  const confine = vi.spyOn(sandbox, 'confine');
  const run = vi.spyOn(sandbox, 'run');
  const native: NativeSandboxRunner = {
    isAvailable: vi.fn().mockResolvedValue(true),
    execute: vi.fn().mockResolvedValue({ stdout: 'sandbox-test', stderr: '', exitCode: 0, sandboxed: true, isolationTier: 'windows-job-restricted' }),
  };
  return { sandbox, confine, run, native };
}

describe('task 276: workspace-write Shell requires native confinement', () => {
  it('denies missing runners, including callers that omit permission', async () => {
    for (const permission of [undefined, 'workspace-write'] as const) {
      const { sandbox, confine, run } = fixture();
      const tool = createShellTool({ workspaceRoot, sandbox, permission });
      expect(tool.requiredPermission).toBe('workspace-write');
      expect((await tool.execute(args, ctx)).error?.errorClass).toBe('DENIED');
      expect(confine).not.toHaveBeenCalled();
      expect(run).not.toHaveBeenCalled();
    }
  });

  it('denies unavailable runners before execution', async () => {
    const { sandbox, confine, run, native } = fixture();
    vi.mocked(native.isAvailable).mockResolvedValue(false);
    const result = await createShellTool({ workspaceRoot, sandbox, nativeSandbox: native }).execute(args, ctx);
    expect(result.error?.errorClass).toBe('DENIED');
    expect(native.execute).not.toHaveBeenCalled();
    expect(confine).not.toHaveBeenCalled();
    expect(run).not.toHaveBeenCalled();
  });

  it('executes with strict native options and enforced audit', async () => {
    const { sandbox, native } = fixture();
    const nativeAudit = vi.fn();
    const result = await createShellTool({ workspaceRoot, sandbox, nativeSandbox: native, nativeAudit }).execute(args, ctx);
    expect(result.error).toBeUndefined();
    expect(result.content).toBe('sandbox-test');
    expect(native.execute).toHaveBeenCalledWith(expect.any(String), expect.any(Array), expect.objectContaining({ requireSandbox: true, lowIntegrity: true, cwd: workspaceRoot }));
    expect(nativeAudit).toHaveBeenCalledWith(expect.objectContaining({ outcome: 'enforced', sandboxed: true }));
  });

  it.each(['throw', 'fallback'] as const)('denies %s without replay through the legacy sandbox', async mode => {
    const { sandbox, confine, run, native } = fixture();
    if (mode === 'throw') vi.mocked(native.execute).mockRejectedValue(new Error('launcher denied'));
    else vi.mocked(native.execute).mockResolvedValue({ stdout: '', stderr: '', exitCode: 0, sandboxed: false, isolationTier: 'passthrough-fallback' });
    const nativeAudit = vi.fn();
    const result = await createShellTool({ workspaceRoot, sandbox, nativeSandbox: native, nativeAudit }).execute(args, ctx);
    expect(result.error?.errorClass).toBe('DENIED');
    expect(native.execute).toHaveBeenCalledOnce();
    expect(confine).not.toHaveBeenCalled();
    expect(run).not.toHaveBeenCalled();
    expect(nativeAudit).toHaveBeenCalledWith(expect.objectContaining({ outcome: 'denied', sandboxed: false }));
  });

  it('denies read-only even when a native runner exists', async () => {
    const { sandbox, native } = fixture();
    expect((await createShellTool({ workspaceRoot, sandbox, nativeSandbox: native, permission: 'read-only' }).execute(args, ctx)).error?.errorClass).toBe('DENIED');
    expect(native.execute).not.toHaveBeenCalled();
  });

  it('preserves full-access native fallback behavior', async () => {
    const { sandbox, native } = fixture();
    vi.mocked(native.execute).mockResolvedValue({ stdout: 'legacy', stderr: '', exitCode: 0, sandboxed: false, isolationTier: 'passthrough-fallback' });
    expect((await createShellTool({ workspaceRoot, sandbox, nativeSandbox: native, permission: 'danger-full-access' }).execute(args, ctx)).content).toBe('legacy');
    expect(native.isAvailable).not.toHaveBeenCalled();
  });
});


