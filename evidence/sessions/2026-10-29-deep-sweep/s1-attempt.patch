 $ErrorActionPreference = 'Stop'
+
+# Windows PowerShell 5.1 keeps these APIs on DirectoryInfo; PowerShell 7 uses extensions.
+function Get-DirectoryAcl([System.IO.DirectoryInfo]$Directory) {
+  if ($PSVersionTable.PSEdition -eq 'Core') {
+    return [System.IO.FileSystemAclExtensions]::GetAccessControl($Directory)
+  }
+  return $Directory.GetAccessControl()
+}
+
+function Set-DirectoryAcl([System.IO.DirectoryInfo]$Directory, [System.Security.AccessControl.DirectorySecurity]$Acl) {
+  if ($PSVersionTable.PSEdition -eq 'Core') {
+    [System.IO.FileSystemAclExtensions]::SetAccessControl($Directory, $Acl)
+  } else {
+    $Directory.SetAccessControl($Acl)
+  }
+}
